    },
    {
      "key": "clearance-new-form",
      "path": "/intent/create/template=clearanceItem;type=clearanceItem/",
      "waitFor": "[data-testid=\"document-panel-scroller\"]",
      "clip": "[data-testid=\"document-panel-scroller\"]"
    },
    {
      "key": "question-form",
      "path": "/intent/create/template=faqItem;type=faqItem/",
      "waitFor": "[data-testid=\"document-panel-scroller\"]",
