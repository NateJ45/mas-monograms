---
// Round-robin cross-fade cycler for the split hero's three viewports (rendered
// by Hero.astro when there are four or more images): every ~2s one frame
// advances to its next photo, so something changes often without all three
// flipping at once. Reduced-motion users get static first frames.
//
// Lives in its own component, not inline in the parent's template, because a
// <script> inside a JSX expression ({cond && (<script>...</script>)}) is
// something prettier-plugin-astro cannot parse: it hands the script body to the
// JSX parser, where every "{" opens an expression. Rendering the component
// conditionally instead ({cond && <Component />}) emits the same markup (only
// the script's indentation moved; verified with npm run parity, 2026-09-05) and
// keeps the file formattable.
---

<script is:inline>
  (function () {
    function initHeroTri() {
      if (window.__heroTriTimer) {
        clearInterval(window.__heroTriTimer);
        window.__heroTriTimer = null;
      }
      var frames = Array.prototype.slice.call(document.querySelectorAll('[data-hero-tri]'));
      if (!frames.length) return;
      var reduce = false;
      try {
        reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (_) {}
      if (reduce) return;
      var states = frames.map(function (f) {
        var slides = f.querySelectorAll('.hero-tri-slide');
        var cur = 0;
        for (var i = 0; i < slides.length; i++) {
          if (slides[i].classList.contains('is-active')) {
            cur = i;
            break;
          }
        }
        return { slides: slides, cur: cur };
      });
      var turn = 0;
      window.__heroTriTimer = setInterval(function () {
        if (document.hidden) return;
        var s = states[turn % states.length];
        turn++;
        if (s.slides.length < 2) return;
        s.slides[s.cur].classList.remove('is-active');
        s.cur = (s.cur + 1) % s.slides.length;
        s.slides[s.cur].classList.add('is-active');
      }, 2000);
    }
    initHeroTri();
    if (!window.__heroTriBound) {
      window.__heroTriBound = true;
      document.addEventListener('astro:page-load', initHeroTri);
    }
  })();
</script>
