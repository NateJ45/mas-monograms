---
// The spool rack on /thread-color-chart: every threadColor as a wooden spool
// standing on a shelf, in hue order. Each spool is a real radio button (one
// native group, so arrow keys move the choice and Tab enters and leaves it),
// stretched invisibly over the whole cell so the tap target is the cell.
// ThreadChartScript.astro listens for `change` on the group and restitches the
// live sample. A plain search field hides non-matching cells; nothing here
// needs JS to read, and without JS the rack is simply a static chart.
//
// All visible strings are props (Sanity). The search label has a short
// neutral fallback until threadChartPage carries one (see the report).
import Spool from '@/components/motifs/Spool.astro';
import type { ThreadColor } from './threadData';

interface Props {
  colors: Array<ThreadColor & { hex: string }>;
  /** slug of the thread checked at load */
  selected?: string | null;
  /** radio group name (legend) */
  legend: string;
  filterLabel: string;
  /** shown when the filter matches nothing */
  emptyNote?: string | null;
}

const { colors, selected, legend, filterLabel, emptyNote } = Astro.props as Props;
const total = colors.length;
---

<div class="rack" data-rack>
  <div class="rack__tools">
    <label class="rack__search">
      <span class="rack__search-label">{filterLabel}</span>
      <span class="rack__search-box">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="rack__search-icon">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"
          ></circle>
          <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          ></path>
        </svg>
        <input
          type="search"
          class="rack__search-input"
          data-rack-filter
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          maxlength="40"
        />
      </span>
    </label>
    <output class="rack__count" data-rack-count aria-live="polite">
      <span data-rack-shown>{total}</span><span aria-hidden="true"> / </span><span class="sr-only"
        >of</span
      >
      {total}
    </output>
  </div>

  <fieldset class="rack__shelves-wrap">
    <legend class="sr-only">{legend}</legend>
    <ul class="rack__shelves" role="list" data-rack-list>
      {
        colors.map((c, i) => (
          <li
            class="rack__cell"
            data-rack-cell
            data-search={[c.name, c.slug, c.colorFamily, c.dmcNumber]
              .filter(Boolean)
              .join(' ')
              .toLowerCase()}
          >
            <label class="rack__spool">
              <input
                type="radio"
                name="thread"
                value={c.slug ?? ''}
                class="rack__radio"
                data-hex={c.hex}
                data-name={c.name ?? ''}
                checked={selected ? c.slug === selected : i === 0}
              />
              <Spool
                color={c.hex}
                label={c.name}
                sublabel={c.dmcNumber ? `DMC ${c.dmcNumber}` : null}
                size={58}
                tilt={((i * 37) % 7) - 3}
                class="rack__art"
              />
            </label>
          </li>
        ))
      }
    </ul>
  </fieldset>
  {
    emptyNote && (
      <p class="rack__empty" data-rack-empty hidden>
        {emptyNote}
      </p>
    )
  }
</div>

<style>
  .rack {
    --plank-h: 0.8rem;
  }
  .rack__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .rack__search {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1 1 16rem;
    max-width: 24rem;
  }
  .rack__search-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .rack__search-box {
    position: relative;
    display: block;
  }
  .rack__search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    transform: translateY(-50%);
    color: var(--color-text-secondary);
    pointer-events: none;
  }
  .rack__search-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 1rem 0.6rem 2.6rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--foreground);
    font-size: 1rem;
    box-shadow: inset 0 1px 2px rgb(38 49 46 / 0.08);
  }
  .rack__search-input:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .rack__count {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums oldstyle-nums;
    color: var(--color-text-secondary);
  }

  .rack__shelves-wrap {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  /* The cabinet: a paper back wall with soft side shadows, and shelves built
     from each cell's own plank (column-gap 0 so the planks of a row join into
     one shelf, however many columns the width allows). */
  .rack__shelves {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.6rem, 1fr));
    column-gap: 0;
    row-gap: 2.25rem;
    margin: 0;
    padding: 1.75rem 1rem 1.25rem;
    list-style: none;
    border-radius: 6px;
    background-color: var(--color-paper);
    background-image:
      linear-gradient(
        90deg,
        rgb(15 27 45 / 0.1),
        transparent 2.5%,
        transparent 97.5%,
        rgb(15 27 45 / 0.1)
      ),
      var(--tex-paper);
    background-size:
      100% 100%,
      var(--tex-paper-size);
    box-shadow:
      inset 0 2px 10px rgb(15 27 45 / 0.12),
      0 1px 0 rgb(255 255 255 / 0.6);
  }
  .rack__cell {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: calc(var(--plank-h) + 0.1rem);
  }
  .rack__shelves[hidden],
  .rack__cell[hidden] {
    display: none;
  }
  /* the plank: a wood face, a lit top edge and a cast shadow below */
  .rack__cell::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--plank-h);
    background:
      linear-gradient(180deg, #f0d6ad 0 2px, transparent 2px),
      repeating-linear-gradient(
        90deg,
        rgb(110 68 34 / 0) 0 23px,
        rgb(110 68 34 / 0.12) 23px 24px,
        rgb(110 68 34 / 0) 24px 61px
      ),
      linear-gradient(180deg, #d4a873, #b98450 55%, #8a5a2f);
    box-shadow: 0 9px 10px -6px rgb(38 26 14 / 0.45);
    pointer-events: none;
  }
  .rack__spool {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.25rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
  }
  /* the radio covers the whole cell: real control, real target, no glyph */
  .rack__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    z-index: 1;
  }
  .rack__spool:has(.rack__radio:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .rack__spool :global(.rack__art) {
    pointer-events: none;
  }
  .rack__spool :global(.spool__art) {
    transform-origin: 50% 100%;
    filter: drop-shadow(0 0 0 transparent);
    transition:
      transform 520ms var(--ease-thread),
      filter 520ms var(--ease-thread);
  }
  .rack__spool :global(.spool__label) {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    text-wrap: balance;
  }
  .rack__spool:hover :global(.spool__art),
  .rack__spool:has(.rack__radio:focus-visible) :global(.spool__art) {
    transform: translateY(-5px) rotate(0deg);
  }
  .rack__spool:has(.rack__radio:checked) :global(.spool__art) {
    transform: translateY(-10px) rotate(0deg) scale(1.06);
    filter: drop-shadow(0 10px 8px rgb(15 27 45 / 0.25));
  }
  /* the chosen spool wears a stitched claret tag-line under its name */
  .rack__spool::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background-image: repeating-linear-gradient(90deg, #8c3a2e 0 6px, transparent 6px 10px);
    opacity: 0;
    transition: opacity 320ms var(--ease-thread);
  }
  .rack__spool:has(.rack__radio:checked)::after {
    opacity: 1;
  }
  .rack__spool:has(.rack__radio:checked) :global(.spool__label) {
    font-style: italic;
    color: #8c3a2e;
  }
  .rack__empty {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1.5px dashed var(--stitch-color);
    border-radius: 6px;
    color: var(--color-text-secondary);
    text-align: center;
  }
  @media (max-width: 30rem) {
    .rack__shelves {
      grid-template-columns: repeat(auto-fill, minmax(4.9rem, 1fr));
      padding-inline: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rack__spool :global(.spool__art) {
      transition: none;
    }
  }
</style>
