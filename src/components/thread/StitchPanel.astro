---
import { internalHref } from '@/lib/internal-href';
// The "live stitch" panel beside the spool rack: one studio-quality
// AtelierStage showing the chosen thread stitched on the chosen cloth, the
// thread's name, fabric swatches (a radio group), an initials field, replay,
// and the hand-off link to the quote form. ThreadChartScript.astro wires it.
//
// Layout: on large screens the whole panel is one sticky column. Below that
// the panel is `display: contents`, so the stage (with the thread name) can
// stick to the top of the section while the controls and the rack scroll
// under it; DOM order and visual order stay the same.
//
// All strings are props from Sanity (atelierSettings, threadChartPage).
import AtelierStage from '@/components/atelier/AtelierStage.astro';
import type { FabricTexture } from './threadData';

interface Fabric {
  key: string;
  label: string;
  color: string;
  texture: FabricTexture;
  note?: string | null;
}

interface Props {
  initials: string;
  thread: { slug: string; name: string; hex: string };
  fabrics: Fabric[];
  threadLabel: string;
  fabricLabel?: string | null;
  initialsLabel?: string | null;
  initialsHint?: string | null;
  replayLabel?: string | null;
  ctaLabel?: string | null;
  disclaimer?: string | null;
  /** quote route the CTA starts from */
  quoteHref: string;
}

const {
  initials,
  thread,
  fabrics,
  threadLabel,
  fabricLabel,
  initialsLabel,
  initialsHint,
  replayLabel,
  ctaLabel,
  disclaimer,
  quoteHref,
} = Astro.props as Props;

const fabric = fabrics[0] ?? {
  key: '',
  label: '',
  color: '#efe6d6',
  texture: 'linen' as FabricTexture,
};
const label = [
  initialsLabel && `${initialsLabel}: ${initials}`,
  `${threadLabel}: ${thread.name}`,
  fabricLabel && fabric.label && `${fabricLabel}: ${fabric.label}`,
]
  .filter(Boolean)
  .join('. ');

const params = new URLSearchParams({ initials, style: 'classic', thread: thread.slug });
if (fabric.key) params.set('fabric', fabric.key);
const href = `${quoteHref}?${params.toString()}`;
---

<div class="panel" data-stitch-panel>
  <div class="panel__stage-wrap">
    <div class="panel__hoop">
      <AtelierStage
        id="thread-stage"
        text={initials}
        style="classic"
        thread={thread.hex}
        fabric={fabric.color}
        fabricTexture={fabric.texture}
        quality="studio"
        aspect="4 / 3"
        label={label}
        class="panel__stage"
      />
      {
        replayLabel && (
          <button type="button" class="panel__replay" data-replay>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="panel__replay-text">{replayLabel}</span>
          </button>
        )
      }
    </div>
    <div class="panel__now">
      <span class="panel__now-dot" data-now-dot style={`--dot:${thread.hex}`} aria-hidden="true"
      ></span>
      <p class="panel__now-text">
        <span class="panel__now-label">{threadLabel}</span>
        <span class="panel__now-name" data-now-name aria-live="polite">{thread.name}</span>
      </p>
    </div>
  </div>

  <div class="panel__controls">
    {
      fabrics.length > 0 && (
        <fieldset class="panel__fabrics">
          {fabricLabel && <legend class="panel__legend">{fabricLabel}</legend>}
          <div class="panel__fabric-list">
            {fabrics.map((f, i) => (
              <label class="fabric" title={f.note ?? undefined}>
                <input
                  type="radio"
                  name="fabric"
                  value={f.key}
                  class="fabric__radio"
                  data-color={f.color}
                  data-texture={f.texture}
                  data-label={f.label}
                  checked={i === 0}
                />
                <span class="fabric__swatch" style={`--fab:${f.color}`} aria-hidden="true" />
                <span class="fabric__name">{f.label}</span>
              </label>
            ))}
          </div>
          <p class="panel__fabric-note" data-fabric-note aria-live="polite">
            {fabric.note}
          </p>
        </fieldset>
      )
    }

    {
      initialsLabel && (
        <div class="panel__initials">
          <label for="thread-initials" class="panel__legend">
            {initialsLabel}
          </label>
          <input
            id="thread-initials"
            type="text"
            class="panel__initials-input"
            value={initials}
            maxlength="3"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            aria-describedby={initialsHint ? 'thread-initials-hint' : undefined}
            data-initials
          />
          {initialsHint && (
            <p id="thread-initials-hint" class="panel__hint">
              {initialsHint}
            </p>
          )}
        </div>
      )
    }

    {
      ctaLabel && (
        <a
          href={internalHref(href)}
          class="btn btn-primary panel__cta"
          data-thread-cta
          data-quote-href={quoteHref}
        >
          <span>{ctaLabel}</span>
          <span class="btn__arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      )
    }
    {disclaimer && <p class="panel__disclaimer">{disclaimer}</p>}
  </div>
</div>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .panel__stage-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  /* a dark wooden mount with an inner running stitch: the sample sits in it
     like cloth stretched on a frame */
  /* The stitch is concentric with the mount (same rule as .btn): inner radius =
     mount radius minus the stitch inset, never below 0. */
  .panel__hoop {
    --mount-radius: var(--radius-mount);
    --mount-stitch-inset: 1.2rem;
    position: relative;
    padding: 0.7rem;
    border-radius: var(--mount-radius);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.18), transparent 40%), var(--wood-mount);
    box-shadow:
      0 26px 40px -24px rgb(15 27 45 / 0.6),
      0 2px 0 rgb(255 255 255 / 0.25) inset;
  }
  .panel__hoop :global(.panel__stage) {
    border-radius: var(--radius-soft);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      inset 0 6px 18px rgb(0 0 0 / 0.14);
  }
  .panel__hoop::after {
    content: '';
    position: absolute;
    inset: var(--mount-stitch-inset);
    border: 1.5px dashed rgb(255 255 255 / 0.32);
    border-radius: max(0px, calc(var(--mount-radius) - var(--mount-stitch-inset)));
    pointer-events: none;
    z-index: 1;
  }
  .panel__now {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .panel__now-dot {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.45), transparent 45%), var(--dot);
    box-shadow:
      0 0 0 2px var(--color-paper),
      0 0 0 3px rgb(38 49 46 / 0.25);
  }
  .panel__now-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    flex: 1;
  }
  .panel__now-label {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .panel__now-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    font-style: italic;
    font-weight: 380;
    line-height: 1.15;
    color: var(--foreground);
  }
  .panel__replay {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-pill);
    background: rgb(251 248 241 / 0.92);
    box-shadow: 0 6px 14px -8px rgb(15 27 45 / 0.5);
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 320ms var(--ease-thread),
      color 320ms var(--ease-thread);
  }
  .panel__replay svg {
    width: 1rem;
    height: 1rem;
  }
  .panel__replay:hover {
    background: var(--link);
    color: var(--color-paper);
  }
  .panel__replay:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .panel__controls {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .panel__fabrics {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .panel__legend {
    display: block;
    margin-bottom: 0.65rem;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .panel__fabric-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: 0.35rem;
  }
  .fabric {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.4rem 0.2rem;
    border-radius: var(--radius-soft);
    text-align: center;
    cursor: pointer;
  }
  .fabric__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    appearance: none;
    cursor: pointer;
  }
  .fabric__swatch {
    display: block;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 50%;
    background-color: var(--fab);
    background-image:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.07) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.08) 0 1px, transparent 1px 3px),
      radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.3), transparent 60%);
    box-shadow:
      0 0 0 1px rgb(38 49 46 / 0.35),
      0 4px 8px -4px rgb(15 27 45 / 0.4);
    transition:
      box-shadow 320ms var(--ease-thread),
      transform 320ms var(--ease-thread);
  }
  .fabric__name {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--color-text-secondary);
  }
  .fabric:hover .fabric__swatch {
    transform: translateY(-2px);
  }
  .fabric:has(.fabric__radio:checked) .fabric__swatch {
    box-shadow:
      0 0 0 2px var(--color-paper),
      0 0 0 4px #8c3a2e,
      0 6px 10px -4px rgb(15 27 45 / 0.45);
  }
  .fabric:has(.fabric__radio:checked) .fabric__name {
    color: var(--foreground);
    font-weight: 700;
  }
  .fabric:has(.fabric__radio:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }
  .panel__fabric-note,
  .panel__hint,
  .panel__disclaimer {
    margin: 0.6rem 0 0;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .panel__fabric-note:empty {
    display: none;
  }
  .panel__initials-input {
    width: 8.5rem;
    min-height: 3rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border-interactive);
    border-radius: 4px;
    background: var(--color-paper);
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .panel__initials-input:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .panel__cta {
    align-self: flex-start;
  }
  .panel__disclaimer {
    margin-top: 0;
    padding-top: 1rem;
    border-top: 1.5px dashed var(--color-border-soft);
    font-size: var(--text-meta);
  }

  @media (min-width: 64rem) {
    .panel {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
      padding: 1.25rem;
      border-radius: var(--radius-mount);
      background-color: var(--color-paper);
      background-image: var(--tex-paper);
      background-size: var(--tex-paper-size);
      box-shadow:
        0 30px 60px -36px rgb(15 27 45 / 0.45),
        0 0 0 1px rgb(38 49 46 / 0.08);
    }
  }
  /* Phones and tablets: the stage sticks while the rack scrolls under it. */
  @media (max-width: 63.999rem) {
    .panel {
      display: contents;
    }
    .panel__stage-wrap {
      z-index: 2;
      padding: 0.6rem 0 0.75rem;
      border-radius: 0 0 var(--radius-mount) var(--radius-mount);
      background-color: var(--color-paper);
      background-image: var(--tex-paper);
      background-size: var(--tex-paper-size);
      box-shadow: 0 18px 24px -20px rgb(15 27 45 / 0.5);
    }
    .panel__hoop {
      --mount-stitch-inset: 0.85rem;
      padding: 0.45rem;
    }
    .panel__replay {
      right: 0.9rem;
      bottom: 0.9rem;
      padding: 0.4rem;
    }
    .panel__replay-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .panel__now-dot {
      width: 1.35rem;
      height: 1.35rem;
    }
    .panel__now-name {
      font-size: 1.2rem;
    }
  }
  @media (max-width: 63.999rem) and (min-height: 36rem) {
    .panel__stage-wrap {
      position: sticky;
      top: var(--header-h);
    }
    .panel__hoop :global(.panel__stage) {
      aspect-ratio: 16 / 9 !important;
      max-height: 26vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel__replay,
    .fabric__swatch {
      transition: none;
    }
  }
</style>
