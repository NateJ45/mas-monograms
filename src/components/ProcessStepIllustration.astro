---
// Safe to edit by hand
// Line-art illustrations for the four process steps (Direction D, "The
// Atelier", 2026-10-04): a hoop, a threaded needle sewing through a card, a
// spool with a price tag, and a parcel tied with twine. Drawn like a pattern
// sheet: a fine ink line in the ground's brass, one accent thread in the
// ground's stitch colour (claret on light, gold-light on dark), and a few
// running stitches. Keyed by stepNumber 1-4 (a number or a Sanity "01"
// string); anything else renders nothing, so a layout falls back to its
// numeral. Decorative (aria-hidden): the step title carries the meaning.
//
//   <ProcessStepIllustration stepNumber={1} />            48px (home preview)
//   <ProcessStepIllustration stepNumber="03" size={168} /> the /how-it-works path
//
// Strokes use vector-effect non-scaling-stroke, so the line stays fine and
// even at every size. Zero cost: inline SVG, no external assets.

interface Props {
  stepNumber?: number | string | null;
  /** Rendered square size in px. Default 48. */
  size?: number;
  /** Optional decorative class override. */
  class?: string;
}

const { stepNumber, size = 48, class: className = '' } = Astro.props as Props;
const n = typeof stepNumber === 'string' ? parseInt(stepNumber, 10) : stepNumber;
const ink = 'var(--color-brass-text)';
const thread = 'var(--accent-stitch, var(--color-rust-cta))';
const w = size >= 96 ? 1.6 : 1.4;
---

{
  n === 1 && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 120 120"
      width={size}
      height={size}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class:list={['step-illo block', className]}
    >
      {/* Step 1, browse: an embroidery hoop with a sketched initial and a few stitches. */}
      <g stroke={ink} stroke-width={w} vector-effect="non-scaling-stroke">
        <circle cx="60" cy="64" r="44" vector-effect="non-scaling-stroke" />
        <circle cx="60" cy="64" r="38" vector-effect="non-scaling-stroke" />
        <path d="M52 18 h16 v-6 h-16 z" vector-effect="non-scaling-stroke" />
        <path d="M56 12 v-4 h8 v4" vector-effect="non-scaling-stroke" />
      </g>
      <path
        d="M44 82 C 46 64, 52 50, 58 46 C 63 43, 66 48, 62 56 C 58 64, 50 70, 52 74 C 54 78, 66 70, 74 60 C 78 55, 80 58, 76 66 C 73 72, 72 78, 78 80"
        stroke={thread}
        stroke-width={w + 0.4}
        stroke-dasharray="5 4"
        vector-effect="non-scaling-stroke"
      />
      <path
        d="M30 96 l6 -6 M36 96 l-6 -6"
        stroke={ink}
        stroke-width={w}
        vector-effect="non-scaling-stroke"
      />
    </svg>
  )
}

{
  n === 2 && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 120 120"
      width={size}
      height={size}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class:list={['step-illo block', className]}
    >
      {/* Step 2, request: a card with written lines, a needle sewing a running stitch across it. */}
      <g stroke={ink} stroke-width={w}>
        <path
          d="M22 26 h60 a4 4 0 0 1 4 4 v66 a4 4 0 0 1 -4 4 h-60 a4 4 0 0 1 -4 -4 v-66 a4 4 0 0 1 4 -4 z"
          vector-effect="non-scaling-stroke"
        />
        <path d="M30 42 h40" vector-effect="non-scaling-stroke" />
        <path d="M30 52 h32" vector-effect="non-scaling-stroke" />
        <path d="M30 62 h36" vector-effect="non-scaling-stroke" />
      </g>
      <path
        d="M30 80 h44"
        stroke={thread}
        stroke-width={w + 0.4}
        stroke-dasharray="6 5"
        vector-effect="non-scaling-stroke"
      />
      <path
        d="M74 80 C 84 80, 90 74, 92 66"
        stroke={thread}
        stroke-width={w + 0.2}
        vector-effect="non-scaling-stroke"
      />
      <g stroke={ink} stroke-width={w}>
        <path d="M86 70 L106 14" vector-effect="non-scaling-stroke" />
        <path d="M89 71 L108 16 Q108 10 104 12 L84 68 Z" vector-effect="non-scaling-stroke" />
        <path d="M101 24 l2 -6" vector-effect="non-scaling-stroke" />
      </g>
    </svg>
  )
}

{
  n === 3 && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 120 120"
      width={size}
      height={size}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class:list={['step-illo block', className]}
    >
      {/* Step 3, quote: a wooden spool wound with thread, a hang tag tied to it. */}
      <g stroke={ink} stroke-width={w}>
        <path d="M18 24 h44 v8 h-44 z" vector-effect="non-scaling-stroke" />
        <path d="M18 96 h44 v8 h-44 z" vector-effect="non-scaling-stroke" />
        <path d="M24 32 v64 M56 32 v64" vector-effect="non-scaling-stroke" />
        <ellipse cx="40" cy="28" rx="4" ry="1.6" vector-effect="non-scaling-stroke" />
      </g>
      <g stroke={thread} stroke-width={w}>
        <path
          d="M24 40 L56 44 M24 48 L56 52 M24 56 L56 60 M24 64 L56 68 M24 72 L56 76 M24 80 L56 84 M24 88 L56 92"
          vector-effect="non-scaling-stroke"
        />
      </g>
      <path
        d="M56 50 C 66 50, 70 56, 74 62"
        stroke={thread}
        stroke-width={w + 0.2}
        vector-effect="non-scaling-stroke"
      />
      <g stroke={ink} stroke-width={w}>
        <path
          d="M74 62 L84 54 H102 a3 3 0 0 1 3 3 V96 a3 3 0 0 1 -3 3 H78 a3 3 0 0 1 -3 -3 V64 Z"
          vector-effect="non-scaling-stroke"
        />
        <circle cx="82" cy="62" r="2.6" vector-effect="non-scaling-stroke" />
        <path d="M84 76 h14 M84 84 h10" vector-effect="non-scaling-stroke" />
      </g>
    </svg>
  )
}

{
  n === 4 && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 120 120"
      width={size}
      height={size}
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class:list={['step-illo block', className]}
    >
      {/* Step 4, stitch and deliver: a parcel tied with twine in a bow, a stitched seal. */}
      <g stroke={ink} stroke-width={w}>
        <path d="M18 50 L60 36 L102 50 L60 64 Z" vector-effect="non-scaling-stroke" />
        <path d="M18 50 V88 L60 104 V64" vector-effect="non-scaling-stroke" />
        <path d="M102 50 V88 L60 104" vector-effect="non-scaling-stroke" />
      </g>
      <g stroke={thread} stroke-width={w + 0.3}>
        <path d="M39 43 L81 57 V97" vector-effect="non-scaling-stroke" />
        <path d="M81 43 L39 57 V97" vector-effect="non-scaling-stroke" />
        <path
          d="M60 50 C 50 36, 40 40, 46 46 C 50 50, 56 50, 60 50 C 64 50, 70 50, 74 46 C 80 40, 70 36, 60 50"
          vector-effect="non-scaling-stroke"
        />
        <path
          d="M60 50 C 58 56, 54 60, 50 62 M60 50 C 62 56, 66 60, 70 62"
          vector-effect="non-scaling-stroke"
        />
      </g>
      <circle
        cx="30"
        cy="76"
        r="7"
        stroke={ink}
        stroke-width={w}
        stroke-dasharray="3 3"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  )
}
