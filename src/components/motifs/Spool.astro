---
// Safe to edit by hand
// A turned wooden thread spool drawn in SVG, wound in any hex colour.
// Seen slightly from above (3/4 view), lit from the upper left:
//   - two lathe-turned flanges: a lit top face with a chamfered edge, a carved
//     ring and the spindle hole; a rim with a turned groove; a hint of grain
//   - the thread: a cylinder shaded from the colour's own ramps, fine wraps that
//     curve with the cylinder, a soft vertical sheen, and ambient occlusion
//     where it tucks under each flange
//   - a loose tail that drops off the winding onto the shelf, and a soft
//     contact shadow
// Colours are mixed at build time from the one hex, so a cream, a white and a
// near-black all read as thread. AtelierStudio.astro draws the same spool as a
// shared <symbol> (colour-independent overlays on currentColor); keep the two
// geometries in step.
//
//   <Spool color={t.hexColor} label={t.name} sublabel={`DMC ${t.dmcNumber}`} />
//   <Spool color="#8c3a2e" size="sm" />             decorative (aria-hidden)
//   <Spool color="#28486b" title="Navy thread" />    image with an accessible name
//
// The label renders as real HTML text under the spool (never inside the SVG),
// so it wraps, scales and is read by screen readers. Pass strings from Sanity.

interface Props {
  /** Thread colour, hex (#rgb or #rrggbb). Falls back to Claret if invalid. */
  color: string;
  /** Visible label under the spool (e.g. the thread name). */
  label?: string | null;
  /** Second, smaller line (e.g. a DMC number). */
  sublabel?: string | null;
  /** sm 56px, md 84px, lg 120px wide, or a number of px. */
  size?: 'sm' | 'md' | 'lg' | number;
  /** Accessible name for the drawing when there is no visible label. Omit for decorative use. */
  title?: string | null;
  /** Draw the loose thread tail. Default true. */
  tail?: boolean;
  /** Rotation in degrees for a casual, set-down look. */
  tilt?: number;
  class?: string;
}

const {
  color,
  label,
  sublabel,
  size = 'md',
  title,
  tail = true,
  tilt = 0,
  class: className = '',
} = Astro.props as Props;

import { motifId } from './uid';

const WIDTHS = { sm: 56, md: 84, lg: 120 } as const;
const width = typeof size === 'number' ? size : WIDTHS[size];

function parse(hex: string): [number, number, number] {
  let h = (hex || '').trim().replace('#', '');
  if (h.length === 3)
    h = h
      .split('')
      .map((c) => c + c)
      .join('');
  if (!/^[0-9a-fA-F]{6}$/.test(h)) h = '8c3a2e';
  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as [number, number, number];
}
const toHex = (rgb: number[]) =>
  '#' +
  rgb
    .map((v) =>
      Math.round(Math.max(0, Math.min(255, v)))
        .toString(16)
        .padStart(2, '0'),
    )
    .join('');
/** Mix toward white (amt > 0) or black (amt < 0). */
const mix = (rgb: [number, number, number], amt: number) =>
  toHex(rgb.map((v) => (amt >= 0 ? v + (255 - v) * amt : v * (1 + amt))));

const base = parse(color);
const lum = (0.2126 * base[0] + 0.7152 * base[1] + 0.0722 * base[2]) / 255;
const pale = lum > 0.7;
const dark = lum < 0.15;
// The cylinder ramp. Pale threads need deeper edge shading to read as round;
// dark ones need a lifted mid and a brighter sheen to show any form at all.
const edge = mix(base, pale ? -0.36 : dark ? -0.35 : -0.55);
const shade = mix(base, pale ? -0.16 : dark ? -0.12 : -0.25);
const mid = dark ? mix(base, 0.1) : toHex(base);
const lit = mix(base, pale ? 0.35 : dark ? 0.24 : 0.2);
const sheen = mix(base, pale ? 0.75 : dark ? 0.42 : 0.5);
// The wraps: a groove line and a lit crest per turn of thread.
const groove = pale ? 'rgba(70,52,34,0.16)' : 'rgba(0,0,0,0.22)';
const crest = dark ? 'rgba(255,255,255,0.1)' : 'rgba(255,255,255,0.16)';

const uid = motifId('sp');
const decorative = !title;

// Geometry (viewBox 100 x 140). Flanges: rx 41, ry 8.6, 6 thick; the top face
// sits at y 16, the bottom face at y 114. The winding: rx 30, ry 6.3 (the same
// 0.21 perspective as the flanges), x 20 to 80.
// One turn of thread is a front half-ellipse; the pattern tile is one turn
// tall, so each tile carries every arc copy that crosses it (k = -6..1).
const WRAP = 1.35;
const arc = (y: number) => `M0 ${y}A30 6.3 0 0 0 60 ${y}`;
const wraps = [-6, -5, -4, -3, -2, -1, 0, 1].map((k) => arc(+(k * WRAP).toFixed(2))).join('');
const BODY = 'M20 18V114A30 6.3 0 0 0 80 114V18Z';
const RIM = (y: number) => `M9 ${y}V${y + 6}A41 8.6 0 0 0 91 ${y + 6}V${y}Z`;
const RIM_LINE = (y: number) => `M9 ${y}A41 8.6 0 0 0 91 ${y}`;
// The loose tail: leaves the winding low on the right, drops past the flange
// and lies along the shelf.
const TAIL =
  'M79.6 92C86 93.5 88.4 101 87 109.5C85.6 118 87.6 126.4 94 128.6C96.4 129.4 98.6 129.2 100 128.6';
---

<div
  class:list={['spool inline-flex flex-col items-center text-center', className]}
  style={`--spool-w:${width}px;--spool-tilt:${tilt}deg`}
>
  <svg
    class="spool__art"
    viewBox="0 0 100 140"
    width={width}
    height={Math.round(width * 1.4)}
    role={decorative ? undefined : 'img'}
    aria-hidden={decorative ? 'true' : undefined}
    aria-label={decorative ? undefined : title}
    focusable="false"
  >
    <defs>
      <linearGradient id={`${uid}-rim`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#7a4d26"></stop>
        <stop offset="0.22" stop-color="#c99b62"></stop>
        <stop offset="0.36" stop-color="#e6c48f"></stop>
        <stop offset="0.7" stop-color="#b07b47"></stop>
        <stop offset="1" stop-color="#5e3a1c"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-face`} x1="0.1" x2="0.8" y1="0" y2="1">
        <stop offset="0" stop-color="#f3dfba"></stop>
        <stop offset="0.5" stop-color="#ddb886"></stop>
        <stop offset="1" stop-color="#b98955"></stop>
      </linearGradient>
      <linearGradient
        id={`${uid}-thread`}
        x1="20"
        x2="80"
        y1="0"
        y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color={edge}></stop>
        <stop offset="0.12" stop-color={shade}></stop>
        <stop offset="0.28" stop-color={lit}></stop>
        <stop offset="0.35" stop-color={sheen}></stop>
        <stop offset="0.43" stop-color={lit}></stop>
        <stop offset="0.62" stop-color={mid}></stop>
        <stop offset="0.86" stop-color={shade}></stop>
        <stop offset="1" stop-color={edge}></stop>
      </linearGradient>
      <linearGradient
        id={`${uid}-ao`}
        x1="0"
        x2="0"
        y1="18"
        y2="121"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0.05" stop-color="#000" stop-opacity="0.5"></stop>
        <stop offset="0.2" stop-color="#000" stop-opacity="0"></stop>
        <stop offset="0.86" stop-color="#000" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#000" stop-opacity="0.38"></stop>
      </linearGradient>
      <pattern id={`${uid}-wraps`} x="20" width="60" height={WRAP} patternUnits="userSpaceOnUse">
        {/* the turns path carries no stroke itself, so each <use> can set its own */}
        <path id={`${uid}-turns`} d={wraps} fill="none"></path>
        <use href={`#${uid}-turns`} stroke={groove} stroke-width="0.4"></use>
        <use href={`#${uid}-turns`} stroke={crest} stroke-width="0.35" transform="translate(0 0.6)"
        ></use>
      </pattern>
      <clipPath id={`${uid}-body`}>
        <path d={BODY}></path>
      </clipPath>
      <radialGradient id={`${uid}-shadow`}>
        <stop offset="0" stop-color="#0f1b2d" stop-opacity="0.38"></stop>
        <stop offset="1" stop-color="#0f1b2d" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    {/* Contact shadow on the shelf */}
    <ellipse cx="50" cy="129" rx="47" ry="7" fill={`url(#${uid}-shadow)`}></ellipse>

    {/* Bottom flange: rim with a turned groove, then the face with the thread's shadow on it */}
    <path d={RIM(114)} fill={`url(#${uid}-rim)`}></path>
    <path d={RIM_LINE(117)} fill="none" stroke="rgba(60,34,14,0.32)" stroke-width="0.7"></path>
    <path d={RIM_LINE(117.9)} fill="none" stroke="rgba(255,236,200,0.28)" stroke-width="0.5"></path>
    <ellipse cx="50" cy="114" rx="41" ry="8.6" fill={`url(#${uid}-face)`}></ellipse>
    <ellipse cx="50" cy="114.8" rx="34.5" ry="7.4" fill="rgba(40,22,8,0.22)"></ellipse>

    {/* The winding: cylinder ramp, wraps, sheen, occlusion under each flange */}
    <g clip-path={`url(#${uid}-body)`}>
      <rect x="20" y="18" width="60" height="104" fill={`url(#${uid}-thread)`}></rect>
      <rect x="20" y="18" width="60" height="104" fill={`url(#${uid}-wraps)`}></rect>
      <rect x="20" y="18" width="60" height="104" fill={`url(#${uid}-ao)`}></rect>
      <path d="M20 27.9A41 8.6 0 0 0 80 27.9" fill="none" stroke="rgba(0,0,0,0.3)" stroke-width="5"
      ></path>
      <path d="M20 114A30 6.3 0 0 0 80 114" fill="none" stroke="rgba(0,0,0,0.28)" stroke-width="3"
      ></path>
    </g>

    {
      /* Top flange: rim and groove, the lit face, a chamfered edge, a carved ring, grain, the hole */
    }
    <path d={RIM(16)} fill={`url(#${uid}-rim)`}></path>
    <path d={RIM_LINE(19)} fill="none" stroke="rgba(60,34,14,0.32)" stroke-width="0.7"></path>
    <path d={RIM_LINE(19.9)} fill="none" stroke="rgba(255,236,200,0.28)" stroke-width="0.5"></path>
    <path d={RIM_LINE(22)} fill="none" stroke="rgba(50,28,10,0.35)" stroke-width="0.6"></path>
    <ellipse cx="50" cy="16" rx="41" ry="8.6" fill={`url(#${uid}-face)`}></ellipse>
    <path
      d="M10.6 16A39.4 8 0 0 1 89.4 16"
      fill="none"
      stroke="rgba(255,248,230,0.7)"
      stroke-width="0.9"></path>
    <path
      d="M10.6 16A39.4 8 0 0 0 89.4 16"
      fill="none"
      stroke="rgba(110,68,34,0.3)"
      stroke-width="0.8"></path>
    <g fill="none" stroke-width="0.45" stroke="rgba(120,78,40,0.2)">
      <path d="M17 13.4Q38 9.6 70 10.4"></path>
      <path d="M26 11.2Q50 8.4 79 12.6"></path>
      <path d="M19 19.6Q46 22.6 82 18.4"></path>
      <path d="M30 22.3Q55 24.2 74 21.8"></path>
    </g>
    <ellipse
      cx="50"
      cy="16"
      rx="27"
      ry="5.7"
      fill="none"
      stroke="rgba(90,54,24,0.28)"
      stroke-width="0.6"></ellipse>
    <ellipse
      cx="50"
      cy="16.45"
      rx="26.6"
      ry="5.5"
      fill="none"
      stroke="rgba(255,244,220,0.45)"
      stroke-width="0.45"></ellipse>
    <ellipse cx="50" cy="16" rx="10" ry="2.3" fill="rgba(120,78,40,0.12)"></ellipse>
    <ellipse cx="50" cy="16" rx="5" ry="1.6" fill="#3a2412"></ellipse>
    <ellipse cx="50" cy="16.55" rx="4.3" ry="1.05" fill="#140b04"></ellipse>

    {
      tail && (
        <g class="spool__tail" fill="none" stroke-linecap="round">
          <path id={`${uid}-tail`} d={TAIL} />
          <use href={`#${uid}-tail`} stroke={edge} stroke-width="1.7" />
          <use href={`#${uid}-tail`} stroke={sheen} stroke-width="0.6" opacity="0.8" />
        </g>
      )
    }
  </svg>
  {
    label && (
      <span class="spool__label mt-xs font-display text-sm leading-tight text-foreground">
        {label}
      </span>
    )
  }
  {
    sublabel && (
      <span class="spool__sublabel mt-0.5 text-label font-semibold tracking-[0.16em] text-[var(--color-text-secondary)] uppercase">
        {sublabel}
      </span>
    )
  }
</div>
