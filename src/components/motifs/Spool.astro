---
// Safe to edit by hand
// A wooden thread spool drawn in SVG, wound in any hex colour (Direction D).
// The thread body is shaded as a cylinder (dark edges, a soft highlight at a
// third), wound with fine slanted wraps, and trails a loose tail. Wood flanges
// carry a grain gradient and a dark spindle hole. Colours are mixed at build
// time from the one hex, so a pale cream and a near-black both read as thread.
//
//   <Spool color={t.hexColor} label={t.name} sublabel={`DMC ${t.dmcNumber}`} />
//   <Spool color="#8c3a2e" size="sm" />             decorative (aria-hidden)
//   <Spool color="#28486b" title="Navy thread" />    image with an accessible name
//
// The label renders as real HTML text under the spool (never inside the SVG),
// so it wraps, scales and is read by screen readers. Pass strings from Sanity.

interface Props {
  /** Thread colour, hex (#rgb or #rrggbb). Falls back to Claret if invalid. */
  color: string;
  /** Visible label under the spool (e.g. the thread name). */
  label?: string | null;
  /** Second, smaller line (e.g. a DMC number). */
  sublabel?: string | null;
  /** sm 56px, md 84px, lg 120px wide, or a number of px. */
  size?: 'sm' | 'md' | 'lg' | number;
  /** Accessible name for the drawing when there is no visible label. Omit for decorative use. */
  title?: string | null;
  /** Draw the loose thread tail. Default true. */
  tail?: boolean;
  /** Rotation in degrees for a casual, set-down look. */
  tilt?: number;
  class?: string;
}

const {
  color,
  label,
  sublabel,
  size = 'md',
  title,
  tail = true,
  tilt = 0,
  class: className = '',
} = Astro.props as Props;

import { motifId } from './uid';

const WIDTHS = { sm: 56, md: 84, lg: 120 } as const;
const width = typeof size === 'number' ? size : WIDTHS[size];

function parse(hex: string): [number, number, number] {
  let h = (hex || '').trim().replace('#', '');
  if (h.length === 3)
    h = h
      .split('')
      .map((c) => c + c)
      .join('');
  if (!/^[0-9a-fA-F]{6}$/.test(h)) h = '8c3a2e';
  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as [number, number, number];
}
const toHex = (rgb: number[]) =>
  '#' +
  rgb
    .map((v) =>
      Math.round(Math.max(0, Math.min(255, v)))
        .toString(16)
        .padStart(2, '0'),
    )
    .join('');
/** Mix toward white (amt > 0) or black (amt < 0). */
const mix = (rgb: [number, number, number], amt: number) =>
  toHex(rgb.map((v) => (amt >= 0 ? v + (255 - v) * amt : v * (1 + amt))));

const base = parse(color);
const lum = (0.2126 * base[0] + 0.7152 * base[1] + 0.0722 * base[2]) / 255;
// Pale threads need deeper edge shading to read as round; dark ones need a
// brighter highlight to show any sheen at all.
const shade = mix(base, lum > 0.7 ? -0.32 : -0.5);
const shadeSoft = mix(base, lum > 0.7 ? -0.14 : -0.22);
const hi = mix(base, lum > 0.7 ? 0.55 : lum < 0.15 ? 0.32 : 0.4);
const mid = toHex(base);
const wrapDark = lum > 0.7 ? 'rgba(60,45,30,0.16)' : 'rgba(0,0,0,0.22)';
const wrapLight = lum < 0.15 ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.22)';

const uid = motifId('sp');
const decorative = !title;
---

<div
  class:list={['spool inline-flex flex-col items-center text-center', className]}
  style={`--spool-w:${width}px;--spool-tilt:${tilt}deg`}
>
  <svg
    class="spool__art"
    viewBox="0 0 100 140"
    width={width}
    height={Math.round(width * 1.4)}
    role={decorative ? undefined : 'img'}
    aria-hidden={decorative ? 'true' : undefined}
    aria-label={decorative ? undefined : title}
    focusable="false"
  >
    <defs>
      <linearGradient id={`${uid}-wood`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#8a5a2f"></stop>
        <stop offset="0.18" stop-color="#c79a63"></stop>
        <stop offset="0.42" stop-color="#e2bf8a"></stop>
        <stop offset="0.7" stop-color="#b98450"></stop>
        <stop offset="1" stop-color="#6e4422"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-woodtop`} x1="0" x2="1" y1="0" y2="1">
        <stop offset="0" stop-color="#f0d6ad"></stop>
        <stop offset="0.55" stop-color="#d8b07a"></stop>
        <stop offset="1" stop-color="#b3824f"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-thread`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color={shade}></stop>
        <stop offset="0.16" stop-color={shadeSoft}></stop>
        <stop offset="0.34" stop-color={hi}></stop>
        <stop offset="0.5" stop-color={mid}></stop>
        <stop offset="0.8" stop-color={shadeSoft}></stop>
        <stop offset="1" stop-color={shade}></stop>
      </linearGradient>
      <pattern
        id={`${uid}-wraps`}
        width="6"
        height="2.4"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(-5)"
      >
        <rect width="6" height="1.1" fill={wrapDark}></rect>
        <rect y="1.2" width="6" height="0.5" fill={wrapLight}></rect>
      </pattern>
      <clipPath id={`${uid}-body`}>
        <path d="M17 26 Q50 33 83 26 L83 114 Q50 121 17 114 Z"></path>
      </clipPath>
      <radialGradient id={`${uid}-shadow`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="rgba(15,27,45,0.34)"></stop>
        <stop offset="1" stop-color="rgba(15,27,45,0)"></stop>
      </radialGradient>
    </defs>

    {/* Contact shadow */}
    <ellipse cx="50" cy="133" rx="46" ry="6" fill={`url(#${uid}-shadow)`}></ellipse>

    {/* Bottom flange: rim, then face */}
    <path d="M8 118 L8 124 Q50 136 92 124 L92 118 Z" fill={`url(#${uid}-wood)`}></path>
    <ellipse cx="50" cy="118" rx="42" ry="8" fill={`url(#${uid}-woodtop)`}></ellipse>

    {/* Thread body: cylinder shading, wraps, a soft top and bottom roll */}
    <g clip-path={`url(#${uid}-body)`}>
      <rect x="17" y="20" width="66" height="100" fill={`url(#${uid}-thread)`}></rect>
      <rect x="17" y="20" width="66" height="100" fill={`url(#${uid}-wraps)`}></rect>
      <rect x="17" y="20" width="66" height="100" fill={`url(#${uid}-thread)`} opacity="0.35"
      ></rect>
      <path d="M17 27 Q50 34 83 27" stroke="rgba(0,0,0,0.25)" stroke-width="2.4" fill="none"></path>
      <path d="M17 113 Q50 120 83 113" stroke="rgba(0,0,0,0.22)" stroke-width="2.6" fill="none"
      ></path>
    </g>

    {/* Top flange: rim, face, spindle hole */}
    <path d="M8 16 L8 22 Q50 34 92 22 L92 16 Z" fill={`url(#${uid}-wood)`}></path>
    <ellipse cx="50" cy="16" rx="42" ry="8" fill={`url(#${uid}-woodtop)`}></ellipse>
    <ellipse
      cx="50"
      cy="16"
      rx="42"
      ry="8"
      fill="none"
      stroke="rgba(110,68,34,0.45)"
      stroke-width="0.8"></ellipse>
    <ellipse cx="50" cy="16" rx="7" ry="2.6" fill="#4a2e17"></ellipse>
    <ellipse cx="50" cy="15.4" rx="5" ry="1.4" fill="#2c1b0d"></ellipse>
    <path
      d="M14 13 Q30 9 46 9.4"
      stroke="rgba(255,255,255,0.5)"
      stroke-width="1.1"
      stroke-linecap="round"
      fill="none"></path>

    {
      tail && (
        <g class="spool__tail" fill="none" stroke-linecap="round">
          <path
            d="M82 70 C 92 74, 96 86, 90 96 C 85 104, 94 110, 99 104"
            stroke={shade}
            stroke-width="1.8"
          />
          <path
            d="M82 70 C 92 74, 96 86, 90 96 C 85 104, 94 110, 99 104"
            stroke={hi}
            stroke-width="0.7"
            opacity="0.85"
          />
        </g>
      )
    }
  </svg>
  {
    label && (
      <span class="spool__label mt-xs font-display text-sm leading-tight text-foreground">
        {label}
      </span>
    )
  }
  {
    sublabel && (
      <span class="spool__sublabel mt-0.5 text-[0.7rem] font-semibold tracking-[0.16em] text-[var(--color-text-secondary)] uppercase">
        {sublabel}
      </span>
    )
  }
</div>

<style>
  .spool {
    width: max(var(--spool-w), 4.5rem);
  }
  .spool__art {
    display: block;
    overflow: visible;
    transform: rotate(var(--spool-tilt));
    transition: transform 520ms var(--ease-thread);
  }
</style>
