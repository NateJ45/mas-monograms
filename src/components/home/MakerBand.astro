---
// The maker (home): Mary Ann in an arched portrait on the Indigo band, her
// pull quote at display size in the italic, her signature in Petemoss, a few
// stitched-bullet facts and her own words (aboutBody). Copy from homePage
// (about*, maker*). No invented facts: only what is in Sanity.
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';

interface Props {
  page: any;
  headingId?: string;
}
const { page, headingId = 'maker-heading' } = Astro.props as Props;
const facts: string[] = (page?.makerFacts ?? []).filter(Boolean);
const hasPhoto = !!page?.aboutPhoto?.asset;
---

<section class="maker surface-indigo py-section-lg" aria-labelledby={headingId}>
  <div
    class="mx-auto grid max-w-content items-center gap-section-md px-m lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
  >
    {
      hasPhoto && (
        <figure class="maker__portrait" data-reveal>
          <div class="maker__arch-stitch" aria-hidden="true" />
          <div class="maker__arch">
            <SanityImage
              source={page.aboutPhoto}
              width={720}
              sizes="(max-width: 1024px) 80vw, 34vw"
              class="maker__img"
            />
          </div>
        </figure>
      )
    }

    <div class="maker__words">
      {
        page?.aboutEyebrow && (
          <p class="eyebrow mb-m" data-reveal="fade">
            {page.aboutEyebrow}
          </p>
        )
      }
      {
        page?.aboutHeadline && (
          <h2 id={headingId} class="maker__headline" data-reveal>
            {page.aboutHeadline}
          </h2>
        )
      }
      {
        page?.makerQuote && (
          <figure class="maker__quote" data-reveal style="--reveal-delay: 100ms">
            <span class="maker__mark" aria-hidden="true">
              &ldquo;
            </span>
            <blockquote>
              <p>{page.makerQuote}</p>
            </blockquote>
            {page?.makerSignature && (
              <figcaption class="maker__signature font-script">{page.makerSignature}</figcaption>
            )}
          </figure>
        )
      }
      {
        page?.aboutBody && (
          <div class="maker__body" data-reveal style="--reveal-delay: 160ms">
            <PortableText value={page.aboutBody} />
          </div>
        )
      }
      {
        facts.length > 0 && (
          <ul class="maker__facts" role="list" data-reveal-stagger="80">
            {facts.map((f) => (
              <li data-reveal="fade">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path
                    d="M3.5 3.5l9 9M12.5 3.5l-9 9"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        page?.aboutCtaLabel && (
          <p class="mt-l" data-reveal>
            <a href={page.aboutCtaHref ?? '/about'} class="btn btn-secondary">
              <span>{page.aboutCtaLabel}</span>
              <span class="btn__arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .maker__words {
    min-width: 0;
  }
  .maker__words .btn {
    white-space: normal;
    text-align: center;
  }
  .maker__portrait {
    position: relative;
    width: min(26rem, 82vw);
    margin-inline: auto;
    padding: 1.1rem;
  }
  .maker__arch {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-pill) var(--radius-pill) var(--radius-soft) var(--radius-soft);
    box-shadow:
      0 40px 60px -30px rgb(0 0 0 / 0.6),
      0 0 0 1px rgb(240 213 138 / 0.25);
  }
  .maker__arch :global(.maker__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: sepia(0.1) saturate(0.92) contrast(0.97) brightness(1.03);
  }
  .maker__arch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at 50% 35%, transparent 55%, rgb(15 27 45 / 0.35) 100%);
    pointer-events: none;
  }
  /* a gold running stitch sewn around the arch */
  .maker__arch-stitch {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill) var(--radius-pill) var(--radius-mount) var(--radius-mount);
    border: 2px dashed rgb(217 177 95 / 0.7);
    pointer-events: none;
  }
  .maker__headline {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 440;
    color: var(--foreground);
  }
  .maker__quote {
    position: relative;
    margin-top: var(--spacing-m);
  }
  .maker__mark {
    display: block;
    height: 0.42em;
    margin-top: 0.15em;
    margin-left: -0.06em;
    font-family: var(--font-display);
    font-size: clamp(5rem, 3.5rem + 4vw, 8rem);
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.35;
    pointer-events: none;
  }
  .maker__quote blockquote p {
    position: relative;
    font-family: var(--font-swash);
    font-style: italic;
    font-weight: 330;
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    font-size: clamp(2rem, 1.2rem + 2.8vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--foreground);
    text-wrap: balance;
  }
  .maker__signature {
    margin-top: 0.5rem;
    font-size: clamp(2.75rem, 2rem + 2vw, 3.75rem);
    line-height: 1;
    color: var(--color-gold-light);
  }
  .maker__body {
    margin-top: var(--spacing-l);
    max-width: 58ch;
    color: var(--color-text-secondary);
    font-size: var(--text-reading);
    line-height: 1.7;
  }
  .maker__body :global(p + p) {
    margin-top: 1em;
  }
  .maker__facts {
    display: grid;
    gap: 0.75rem;
    margin-top: var(--spacing-l);
    padding-top: var(--spacing-m);
    border-top: 1.5px dashed rgb(217 177 95 / 0.45);
  }
  @media (min-width: 640px) {
    .maker__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  .maker__facts li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-body);
    line-height: 1.45;
    color: var(--foreground);
  }
  .maker__facts svg {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.3rem;
    color: var(--color-gold);
  }
</style>
