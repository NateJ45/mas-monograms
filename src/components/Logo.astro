---
// Foundation, edit with care.
// The MAS Monograms logo system (chosen 2026-10-04; docs/logo-concepts/README.md):
//   <Logo />          the Signature Thread wordmark: "MAS" roman caps, "Monograms" in the soft
//                     italic, one thread (running stitch, a loop, the underline, a knot).
//                     For horizontal places: the condensed header pill, the footer lockup.
//   <Logo mark />     the Hoop Seal, compact: the threaded MAS cypher (a script S sewn over
//                     and under a roman M and A) in a pair of embroidery hoops with their
//                     tension clasp. The primary brand mark.
//   <Logo seal />     the full Hoop Seal: the mark plus ring lettering and a running-stitch
//                     border. For large, standalone use.
// Colour (blue and gold):
//   variant="ink"        light grounds: Indigo hoops, Midnight letters, a gold satin S
//   variant="parchment"  dark grounds: gold hoops, Linen letters, a gold S
//   variant="adaptive"   (default) paints through the --logo-* context tokens in globals.css,
//                        so one instance follows its ground (the header's overlay and pill).
// Every <svg> id is prefixed per instance (motifId), so several logos on a page never share
// a mask. The drawing itself is src/lib/brand/brandSvg.js, shared with the icon and OG scripts.
// Decorative by default (aria-hidden): the link around it carries the name. Pass `title` for a
// standalone, named logo.
import { sealSvg, wordmarkSvg, LIGHT, DARK } from '@/lib/brand/brandSvg.js';
import { motifId } from '@/components/motifs/uid';

interface Props {
  variant?: 'ink' | 'parchment' | 'adaptive';
  /** The compact Hoop Seal. */
  mark?: boolean;
  /** The full Hoop Seal with ring lettering. */
  seal?: boolean;
  /** Wordmark cut: 'header' (heavier, for 40px and under) or 'display'. */
  cut?: 'header' | 'display';
  /** Cypher weight for the mark: 'bold' (default, 32 to 160px) or 'regular' (larger). */
  weight?: 'bold' | 'regular';
  title?: string;
  class?: string;
}

const {
  variant = 'adaptive',
  mark = false,
  seal = false,
  cut = 'header',
  weight = 'bold',
  title,
  class: className,
} = Astro.props as Props;

const adaptive = variant === 'adaptive';
const palette = variant === 'parchment' ? DARK : LIGHT;
const idp = motifId('lg');

const svg =
  mark || seal
    ? sealSvg({
        idp,
        ring: seal,
        cut: seal ? 'regular' : weight,
        palette,
        adaptive,
        title,
        className,
      })
    : wordmarkSvg({ idp, cut, palette, adaptive, title, className });
---

<Fragment set:html={svg} />
