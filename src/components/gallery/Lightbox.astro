---
// Safe to edit by hand
// The gallery lightbox (Direction D): one native <dialog> per page that shows
// any photo whose trigger is a <button data-lightbox data-full=... data-alt=...
// data-caption=... data-w=... data-h=...>. Built on showModal(), so the rest of
// the page is inert while it is open, Esc closes it and the browser draws the
// backdrop. On top of that the script adds: a Tab focus loop inside the
// dialog, Left/Right arrow keys, prev/next buttons, touch swipe, a live
// "n / total" counter, scroll lock, and focus returned to the trigger of the
// photo that was showing. Navigation walks only the triggers that are visible
// right now (so it follows the gallery filter).
//
//   <Lightbox closeLabel="Close" prevLabel="Previous photo" nextLabel="Next photo" />
//
// Every label is a prop; the fallbacks are short and neutral.

interface Props {
  /** Accessible name of the dialog. */
  label?: string | null;
  closeLabel?: string | null;
  prevLabel?: string | null;
  nextLabel?: string | null;
}

const {
  label = null,
  closeLabel = null,
  prevLabel = null,
  nextLabel = null,
} = Astro.props as Props;
---

<dialog class="lightbox on-dark" id="lightbox" aria-label={label ?? 'Photo viewer'}>
  <div class="lightbox__stage" data-lightbox-stage>
    <figure class="lightbox__figure">
      <div class="lightbox__mat">
        <img class="lightbox__img" alt="" data-lightbox-img decoding="async" />
      </div>
      <figcaption class="lightbox__caption">
        <span class="lightbox__text" data-lightbox-caption></span>
        <span class="lightbox__count" data-lightbox-count aria-live="polite"></span>
      </figcaption>
    </figure>
    <button
      type="button"
      class="lightbox__btn lightbox__btn--close"
      data-lightbox-close
      aria-label={closeLabel ?? 'Close'}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
        ><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__btn--prev"
      data-lightbox-prev
      aria-label={prevLabel ?? 'Previous'}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
        ><path d="M15 5l-7 7 7 7"></path></svg
      >
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__btn--next"
      data-lightbox-next
      aria-label={nextLabel ?? 'Next'}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
        ><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--foreground);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background:
      radial-gradient(ellipse at 30% 20%, rgba(40, 72, 107, 0.45), transparent 60%),
      rgba(10, 18, 31, 0.94);
  }
  .lightbox[open] {
    display: grid;
  }
  .lightbox__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 4.5rem 1rem 1.5rem;
    touch-action: pan-y;
  }
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: min(68rem, 100%);
    margin: 0;
  }
  /* The photo on a paper mat with a running stitch inside its edge. */
  .lightbox__mat {
    position: relative;
    padding: clamp(0.5rem, 1.4vw, 1rem);
    background-color: var(--color-paper);
    background-image: var(--tex-paper);
    background-size: var(--tex-paper-size);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .lightbox__mat::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1.5px dashed #b98a3e;
    pointer-events: none;
    opacity: 0.8;
  }
  .lightbox__img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(64rem, calc(100vw - 3rem));
    max-height: calc(100dvh - 13rem);
    object-fit: contain;
    filter: sepia(0.1) saturate(0.94) contrast(0.97) brightness(1.03);
  }
  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    max-width: 52rem;
    text-align: center;
    color: var(--foreground);
  }
  .lightbox__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead-sm);
    line-height: 1.4;
  }
  .lightbox__count {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--color-gold);
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1.5px dashed var(--color-gold);
    background: rgba(15, 27, 45, 0.7);
    color: var(--color-gold-light);
    cursor: pointer;
  }
  .lightbox__btn:hover,
  .lightbox__btn:focus-visible {
    background: var(--color-gold-light);
    color: var(--color-midnight);
    border-style: solid;
  }
  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lightbox__btn--close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__btn--prev,
  .lightbox__btn--next {
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__btn--prev {
    left: clamp(0.5rem, 2vw, 2rem);
  }
  .lightbox__btn--next {
    right: clamp(0.5rem, 2vw, 2rem);
  }
  .lightbox__btn[hidden] {
    display: none;
  }
  @media (max-width: 639px) {
    .lightbox__btn--prev,
    .lightbox__btn--next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
    .lightbox__stage {
      padding-bottom: 5rem;
    }
    .lightbox__img {
      max-height: calc(100dvh - 16rem);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__figure {
      animation: lightbox-in 420ms var(--ease-thread) both;
    }
    .lightbox[open]::backdrop {
      animation: lightbox-fade 300ms ease both;
    }
    .lightbox__img.is-swapping {
      opacity: 0.25;
    }
    .lightbox__img {
      transition: opacity 260ms ease;
    }
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }
  }
  :global(html.lightbox-open) {
    overflow: hidden;
  }
</style>

<script>
  function initLightbox() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.ready === '1') return;
    dialog.dataset.ready = '1';

    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lightbox-stage]')!;

    let list: HTMLButtonElement[] = [];
    let index = 0;

    // Only triggers the visitor can currently see (follows the gallery filter).
    const visibleTriggers = () =>
      Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-lightbox]')).filter(
        (b) => b.getClientRects().length > 0 && !b.closest('.is-filtered-out'),
      );

    function show(i: number) {
      if (!list.length) return;
      index = (i + list.length) % list.length;
      const t = list[index];
      const d = t.dataset;
      img.classList.add('is-swapping');
      img.onload = () => img.classList.remove('is-swapping');
      if (d.w && d.h) {
        img.width = Number(d.w);
        img.height = Number(d.h);
      }
      img.src = d.full ?? '';
      img.alt = d.alt ?? '';
      caption.textContent = d.caption ?? '';
      count.textContent = `${index + 1} / ${list.length}`;
      const single = list.length < 2;
      prev.hidden = single;
      next.hidden = single;
      // Warm the neighbours so arrowing feels instant.
      [index + 1, index - 1].forEach((n) => {
        const nb = list[(n + list.length) % list.length];
        if (nb?.dataset.full) new Image().src = nb.dataset.full;
      });
    }

    function open(trigger: HTMLButtonElement) {
      list = visibleTriggers();
      const i = list.indexOf(trigger);
      show(i < 0 ? 0 : i);
      document.documentElement.classList.add('lightbox-open');
      dialog!.showModal();
      close.focus();
    }

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      const back = list[index];
      img.removeAttribute('src');
      if (back && back.isConnected) back.focus();
    });

    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-lightbox]');
      if (t) {
        e.preventDefault();
        open(t);
      }
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    close.addEventListener('click', () => dialog.close());
    // A click on the backdrop area (not the photo or a control) closes.
    stage.addEventListener('click', (e) => {
      if (e.target === stage) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === 'Tab') {
        const f = [close, prev, next].filter((b) => !b.hidden);
        const first = f[0];
        const last = f[f.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !dialog.contains(active))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Touch swipe.
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') x0 = e.clientX;
    });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
