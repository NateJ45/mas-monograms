---
// MAS Monograms site header (2026-10-04 rework: centred editorial, glass pill on scroll).
//
//   At rest (desktop)   one full-width row, no top rail: the menu split either side of the
//                       Hoop Seal in the centre, the quote button at the right, and a
//                       running-stitch hem along the bottom with a gap where the seal sits.
//   Scrolled            the same row detaches into a floating, inset, rounded glass pill
//                       (blur, hairline, a stitched inner edge, soft shadow). The seal shrinks
//                       and fades as the Signature Thread wordmark draws in, left to right.
//                       Back at the top it returns to the full row.
//   Phone and tablet    a compact row (seal + wordmark, menu button) that also becomes a pill.
//                       Contact details live in the phone menu (siteSettings.menuContactLabel) and the
//                       footer; the old contact strip is gone.
//
// Tones (CSS in globals.css, "Site header"):
//   tone="solid"    a Linen row at rest (pages that open light)
//   tone="overlay"  transparent over the page's dark hero, light-on-dark tokens; with no JS
//                   it is painted solid Midnight, so it can never be light text on a light page
// The outer <header> is sticky and reserves --header-h in both states, so the pill condenses
// INSIDE a fixed box and the page never reflows (no layout shift). Reduced motion keeps the
// same states with no transitions (the global reset zeroes them).
//
// The menu comes from Site Settings (resolveChrome); the dropdown script below is the
// accessible one this header has always used (native <details>, hover intent, Escape,
// outside click).

import { site } from '@/data/site';
import { ChevronDown, Menu } from 'lucide-react';
import Logo from './Logo.astro';
import SanityImage from './SanityImage.astro';
import { resolveChrome, type NavItem, type RawNavItem } from '@/lib/siteSettings';
import type { RawNavLink } from '@/lib/nav-href';

interface SocialLink {
  platform?: string;
  url?: string;
  label?: string;
}

interface Props {
  siteSettings?: {
    title?: string;
    tagline?: string;
    email?: string;
    phone?: string;
    socialLinks?: SocialLink[] | null;
    quoteCtaLabel?: string;
    /** The small label above the phone and email in the phone menu. */
    menuContactLabel?: string;
    /** A logo picture from Site Settings. When set it stands in for the drawn logo. */
    logo?: { asset?: { _ref?: string; _id?: string }; alt?: string } | null;
    navItems?: RawNavItem[] | null;
    headerCta?: {
      show?: boolean | null;
      label?: string | null;
      link?: RawNavLink | null;
    } | null;
    showEmail?: boolean | null;
    showSocials?: boolean | null;
  } | null;
  /** When false, the Clearance nav link is hidden (nothing on clearance). */
  hasClearance?: boolean;
  /** 'overlay' = transparent over a dark first section (BaseLayout header="overlay"). */
  tone?: 'solid' | 'overlay';
}

const { siteSettings, hasClearance = true, tone = 'solid' } = Astro.props as Props;

const chrome = resolveChrome(siteSettings);

const brandName = siteSettings?.title ?? site.name;
const ctaLabel = chrome.headerCta.label;
const ctaHref = chrome.headerCta.href;
// A logo picture from Site Settings stands in for the drawn logo.
const customLogo = siteSettings?.logo?.asset ? siteSettings.logo : null;

const NAV_ITEMS: NavItem[] = chrome.navItems
  // Drop a redundant top-level "Home" link: the logo already links home.
  .filter(
    (item) =>
      !(item.kind === 'flat' && (item.href === '/' || item.label.trim().toLowerCase() === 'home')),
  )
  .filter((it) => hasClearance || !(it.kind === 'flat' && it.href === '/clearance'));

// The menu is split either side of the centred seal: the first half on the left.
const split = Math.ceil(NAV_ITEMS.length / 2);
const NAV_LEFT = NAV_ITEMS.slice(0, split);
const NAV_RIGHT = NAV_ITEMS.slice(split);

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}

const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: siteSettings.email,
      phone: siteSettings.phone,
      menuContactLabel: siteSettings.menuContactLabel,
      socialLinks: siteSettings.socialLinks,
    }
  : null;

// MobileNav's props are written into the page (data-props, read by mobileNavMount.tsx). Only
// the switches that are actually turned off are passed.
const mobileChrome = {
  ...(chrome.headerCta.show ? {} : { showCta: false }),
  ...(chrome.showEmail ? {} : { showEmail: false }),
  ...(chrome.showSocials ? {} : { showSocials: false }),
};
const mobileNavProps = {
  links: NAV_ITEMS,
  siteSettings: mobileNavSettings,
  ctaLabel,
  ctaHref,
  brandName,
  ...mobileChrome,
};
---

<header class="site-header" data-tone={tone}>
  <div class="site-header__bar">
    <nav class="site-header__nav site-header__nav--left site-nav" aria-label="Primary">
      {
        NAV_LEFT.map((item) =>
          item.kind === 'flat' ? (
            <a
              href={item.href}
              class="site-header__link nav-underline"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <details class="site-nav__group relative">
              <summary
                class="site-header__link nav-underline"
                aria-current={isGroupActive(item.items) ? 'page' : undefined}
              >
                {item.label}
                <ChevronDown size={14} className="site-nav__chevron" aria-hidden="true" />
              </summary>
              <div class="site-nav__menu on-light texture-paper">
                {item.items.map((sub) => (
                  <a href={sub.href} aria-current={isActive(sub.href) ? 'page' : undefined}>
                    {sub.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )
      }
    </nav>

    <a href="/" class="site-header__brand" aria-label={`${brandName} home`}>
      {
        customLogo ? (
          <SanityImage
            source={customLogo}
            width={320}
            alt=""
            loading="eager"
            class="site-header__custom-logo"
          />
        ) : (
          <>
            <span class="site-header__seal">
              <Logo mark />
            </span>
            <span class="site-header__word">
              <Logo cut="header" />
            </span>
          </>
        )
      }
    </a>

    <div class="site-header__end">
      {
        NAV_RIGHT.length > 0 && (
          <nav class="site-header__nav site-nav" aria-label="Primary, continued">
            {NAV_RIGHT.map((item) =>
              item.kind === 'flat' ? (
                <a
                  href={item.href}
                  class="site-header__link nav-underline"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <details class="site-nav__group relative">
                  <summary
                    class="site-header__link nav-underline"
                    aria-current={isGroupActive(item.items) ? 'page' : undefined}
                  >
                    {item.label}
                    <ChevronDown size={14} className="site-nav__chevron" aria-hidden="true" />
                  </summary>
                  <div class="site-nav__menu site-nav__menu--end on-light texture-paper">
                    {item.items.map((sub) => (
                      <a href={sub.href} aria-current={isActive(sub.href) ? 'page' : undefined}>
                        {sub.label}
                      </a>
                    ))}
                  </div>
                </details>
              ),
            )}
          </nav>
        )
      }
      {
        chrome.headerCta.show && (
          <a href={ctaHref} class="btn btn-primary site-header__cta">
            {ctaLabel}
          </a>
        )
      }

      {
        /* The phone menu. Not an Astro island: the slot carries MobileNav's props, the
          placeholder below is a server-rendered copy of its menu button, and the script at
          the bottom mounts the React menu after the load event (or on the first tap). See
          mobileNavMount.tsx. */
      }
      <div class="site-header__menu" data-mobile-nav data-props={JSON.stringify(mobileNavProps)}>
        <div data-mobile-nav-placeholder>
          <button
            type="button"
            aria-label="Open menu"
            aria-haspopup="dialog"
            aria-expanded="false"
            class="site-header__menu-btn"
          >
            <Menu size={22} />
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }
  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }
  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;
    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;
      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAllGroups(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });
      summary?.addEventListener('click', () => {
        if (!group.open) closeAllGroups(group);
      });
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }
  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);

  // Phone menu: mount the React MobileNav into its slot on the first tap of the
  // placeholder button (which then opens it), on the first interaction
  // anywhere, or 2.5s after load plus an idle moment. Keeps React off the
  // first paint; see mobileNavMount.tsx for the why and the seamless swap.
  type MobileNavSlot = HTMLElement & { __mnavRoot?: { unmount(): void } };
  let mobileNavModule: Promise<typeof import('@/components/mobileNavMount')> | null = null;
  const loadMobileNav = () => (mobileNavModule ??= import('@/components/mobileNavMount'));
  function mountMobileNav(slot: MobileNavSlot) {
    if (slot.dataset.mnavMounting) return;
    slot.dataset.mnavMounting = '1';
    loadMobileNav()
      .then(({ mountMobileNav: mount }) => {
        if (!slot.isConnected || slot.__mnavRoot) return;
        slot.__mnavRoot = mount(slot, slot.dataset.mnavOpen === '1') ?? undefined;
      })
      .catch(() => {
        // offline or a failed chunk: let the next tap try again
        mobileNavModule = null;
        delete slot.dataset.mnavMounting;
      });
  }
  function initMobileNav() {
    const slot = document.querySelector<MobileNavSlot>('[data-mobile-nav]');
    const button = slot?.querySelector<HTMLButtonElement>('[data-mobile-nav-placeholder] button');
    if (!slot || !button || slot.dataset.mnavInit) return;
    slot.dataset.mnavInit = '1';
    button.addEventListener('pointerdown', () => void loadMobileNav(), { once: true });
    button.addEventListener('click', () => {
      slot.dataset.mnavOpen = '1';
      mountMobileNav(slot);
    });
    const WAKE = ['pointerdown', 'keydown', 'touchstart'] as const;
    const wake = (e?: Event) => {
      if (e?.target instanceof Node && button.contains(e.target)) return;
      WAKE.forEach((t) => window.removeEventListener(t, wake));
      mountMobileNav(slot);
    };
    WAKE.forEach((t) => window.addEventListener(t, wake, { passive: true }));
    const later = () =>
      window.setTimeout(() => {
        if ('requestIdleCallback' in window)
          window.requestIdleCallback(() => wake(), { timeout: 2000 });
        else wake();
      }, 2500);
    if (document.readyState === 'complete') later();
    else window.addEventListener('load', later, { once: true });
  }
  document.addEventListener('astro:before-swap', () => {
    document.querySelector<MobileNavSlot>('[data-mobile-nav]')?.__mnavRoot?.unmount();
  });
  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);

  // Rest <-> pill. One passive, rAF-throttled listener that only toggles an attribute; CSS
  // does the rest. Bound once (window survives View Transitions); it re-queries the header
  // each frame because the router swaps the <header> element on navigation. A small
  // threshold, like Reid Design's header, so the pill arrives as soon as the page moves.
  const hw = window as typeof window & { __headerScrollBound?: boolean };
  function syncHeaderScrolled() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) header.toggleAttribute('data-scrolled', window.scrollY > 24);
  }
  if (!hw.__headerScrollBound) {
    hw.__headerScrollBound = true;
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          syncHeaderScrolled();
        });
      },
      { passive: true },
    );
    document.addEventListener('astro:page-load', syncHeaderScrolled);
  }
  syncHeaderScrolled();
</script>
