---
// Safe to edit by hand
// The eyebrow + headline pairing used at the top of nearly every section.
// Pass `headingId` so the parent <section> can use aria-labelledby={headingId}
// for an accessible name (per CLAUDE.md a11y guidance).
//
// Direction D ("The Atelier", 2026-10-04):
//   - The eyebrow is the .eyebrow treatment: tracked caps led by a short
//     running stitch (brass on light grounds, gold on dark).
//   - `size` scales the headline: 'md' (the old h2/h3 scale, default), 'lg'
//     (display-sm) or 'display' (the huge hero scale).
//   - `swash`: a word or phrase from the headline set in the italic swash
//     (Fraunces full italic, SOFT/WONK; claret on light, thread-gold on dark).
//     Must match the headline text exactly; first occurrence only.
//   - Colours follow the ground: on a .surface-midnight/.surface-indigo (or any
//     .on-dark) the default tone is already light-on-dark. `tone="inverse"`
//     is kept for dark grounds that are not surfaces.
//
// Variants:
//   - level: which heading tag (h1 for hero, h2 for sections, h3 for sub-sections). Default h2.
//   - align: "left" (default) or "center"
//   - scriptAccent: one word in the Petemoss script (rare; one per page at most).
//   - headlineItalicSuffix: an editable italic phrase appended after the headline.
// Logic for the accents is shared with Hero.astro via splitScriptAccent().

import { splitScriptAccent } from '@/lib/scriptAccent';

interface Props {
  eyebrow?: string;
  headline?: string;
  /** Optional word/phrase rendered in the italic swash immediately after the headline. */
  headlineItalicSuffix?: string;
  subhead?: string;
  headingId: string;
  level?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  tone?: 'default' | 'inverse';
  /** Headline scale. 'md' keeps the h-level scale; 'lg' and 'display' are the Atelier statement sizes. */
  size?: 'md' | 'lg' | 'display';
  /** A word/phrase from the headline to set in the italic swash. */
  swash?: string;
  /** A word/phrase from the headline to set in the Petemoss script. Use sparingly. */
  scriptAccent?: string;
  class?: string;
}

const {
  eyebrow,
  headline,
  headlineItalicSuffix,
  subhead,
  headingId,
  level = 'h2',
  align = 'left',
  tone = 'default',
  size = 'md',
  swash,
  scriptAccent,
  class: extraClass = '',
} = Astro.props as Props;

// Accent split: the swash wins if both are passed and both match.
const swashSplit = splitScriptAccent(headline ?? '', swash);
const scriptSplit = swashSplit.found
  ? { found: false, before: '', word: '', after: '' }
  : splitScriptAccent(headline ?? '', scriptAccent);

const levelClass =
  level === 'h1'
    ? 'font-display text-h1 leading-headline-tight tracking-[-0.02em]'
    : level === 'h2'
      ? 'font-display text-h2 leading-tight'
      : 'font-display text-h3 leading-tight';
const headingClass = size === 'display' ? 'display' : size === 'lg' ? 'display-sm' : levelClass;

const centered = align === 'center';
const wrapperAlign = centered ? 'text-center mx-auto' : 'text-left';
const toneHeadline = tone === 'inverse' ? 'text-bg' : 'text-foreground';
const toneSub = tone === 'inverse' ? 'text-bg/85' : 'text-[var(--color-text-secondary)]';
const Tag = level;
---

<div
  class:list={[
    wrapperAlign,
    size === 'md' ? 'max-w-3xl' : 'max-w-5xl',
    tone === 'inverse' && 'on-dark',
    extraClass,
  ]}
>
  {
    eyebrow && (
      <p class:list={['eyebrow mb-m', centered && 'eyebrow--center justify-center']}>{eyebrow}</p>
    )
  }
  {
    headline && (
      <Tag id={headingId} class:list={[headingClass, toneHeadline]}>
        {swashSplit.found ? (
          <>
            {swashSplit.before}
            <em class="swash">{swashSplit.word}</em>
            {swashSplit.after}
          </>
        ) : scriptSplit.found ? (
          <>
            {scriptSplit.before}
            <span class="font-script">{scriptSplit.word}</span>
            {scriptSplit.after}
          </>
        ) : (
          headline
        )}
        {headlineItalicSuffix && (
          <>
            {' '}
            <em class="swash">{headlineItalicSuffix}</em>
          </>
        )}
      </Tag>
    )
  }
  {
    subhead && (
      <p
        class:list={[
          'mt-m text-lg leading-relaxed text-pretty',
          size !== 'md' && 'lede',
          centered && 'mx-auto',
          toneSub,
        ]}
      >
        {subhead}
      </p>
    )
  }
</div>
