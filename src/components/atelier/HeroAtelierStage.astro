---
// HeroAtelierStage: the home hero's embroidery canvas. Same markup and no-JS
// fallback as AtelierStage (a fabric block with the initials), but WITHOUT
// AtelierStageScript: HomeHeroScript starts the engine itself, after the first
// interaction or shortly after load, so the stitching never competes with the
// headline (the LCP) or the first paint. It exposes the same element contract
// (`el.__atelier`, 'atelier:ready', 'atelier:progress').
type StyleKey = 'classic' | 'script' | 'block' | 'circle' | 'single';
type FabricTexture = 'linen' | 'canvas' | 'cotton' | 'terry';

interface Props {
  text?: string;
  style?: StyleKey;
  thread?: string;
  fabric?: string;
  fabricTexture?: FabricTexture;
  label?: string;
  class?: string;
}

const {
  text = '',
  style = 'classic',
  thread = '#8c3a2e',
  fabric = '#efe6d6',
  fabricTexture = 'linen',
  label,
  class: className,
} = Astro.props;

const initials = Array.from(String(text).toLocaleUpperCase())
  .filter((c) => /\p{L}/u.test(c))
  .slice(0, 3)
  .join('');
---

<div
  class:list={['hero-stage', className]}
  data-hero-stage
  data-text={initials}
  data-style={style}
  data-thread={thread}
  data-fabric={fabric}
  data-texture={fabricTexture}
  style={`--atelier-fabric:${fabric};--atelier-thread:${thread};`}
>
  <div class="hero-stage__fallback" aria-hidden="true">
    <span class="hero-stage__initials">{style === 'single' ? initials.slice(0, 1) : initials}</span>
  </div>
  <canvas class="hero-stage__canvas" role="img" aria-label={label}></canvas>
</div>

<style>
  .hero-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--atelier-fabric);
    isolation: isolate;
    container-type: inline-size;
  }
  .hero-stage__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-image:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.04) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.06) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 35% 30%, rgb(255 255 255 / 0.12), rgb(0 0 0 / 0.12));
    transition: opacity 0.5s ease;
  }
  .hero-stage__initials {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22cqi;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--atelier-thread);
    opacity: 0.85;
    text-shadow:
      0 1px 0 rgb(255 255 255 / 0.25),
      1px 2px 2px rgb(0 0 0 / 0.22);
  }
  .hero-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .hero-stage[data-ready] .hero-stage__canvas {
    opacity: 1;
  }
  .hero-stage[data-ready] .hero-stage__fallback {
    opacity: 0;
  }
</style>
