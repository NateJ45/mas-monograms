---
// AtelierStage: one live embroidery canvas (the Monogram Atelier engine).
//
// Renders a fabric-coloured block with the initials as plain text first, so
// layout and LCP never wait on the engine; the canvas fades in over it once the
// first frame is drawn. The engine itself is code-split and only imported when
// the stage comes near the viewport.
//
// Other components drive it through the element:
//   el.__atelier                    the engine (setDesign / replay / toBlob ...)
//   'atelier:ready'   CustomEvent   detail.atelier, fired once the engine exists
//   'atelier:progress' CustomEvent  detail.progress 0..1 while stitching
// Keep the canvas aria-label in step with the design (it is the text alternative).
import AtelierStageScript from './AtelierStageScript.astro';

type StyleKey = 'classic' | 'script' | 'block' | 'circle' | 'single';
type FabricTexture = 'linen' | 'canvas' | 'cotton' | 'terry';

interface Props {
  text?: string;
  style?: StyleKey;
  /** thread hex */
  thread?: string;
  /** fabric hex */
  fabric?: string;
  fabricTexture?: FabricTexture;
  quality?: 'hero' | 'studio';
  /** accessible description of the canvas */
  label?: string;
  class?: string;
  /** CSS aspect-ratio reserved before the canvas paints, e.g. '4 / 3' */
  aspect?: string;
  id?: string;
  /** set false to show the finished piece without the stitching animation */
  autoplay?: boolean;
}

const {
  text = '',
  style = 'classic',
  thread = '#8c3a2e',
  fabric = '#efe6d6',
  fabricTexture = 'linen',
  quality = 'studio',
  label = 'Embroidered monogram preview',
  class: className,
  aspect = '4 / 3',
  id,
  autoplay = true,
} = Astro.props;

const initials = Array.from(String(text).toLocaleUpperCase())
  .filter((c) => /[\p{L}\p{N}&]/u.test(c))
  .slice(0, 3)
  .join('');
---

<div
  class:list={['atelier-stage', className]}
  id={id}
  data-atelier-stage
  data-text={initials}
  data-style={style}
  data-thread={thread}
  data-fabric={fabric}
  data-texture={fabricTexture}
  data-quality={quality}
  data-autoplay={autoplay ? 'true' : 'false'}
  style={`--atelier-fabric:${fabric};--atelier-thread:${thread};aspect-ratio:${aspect};`}
>
  <div class="atelier-stage__fallback" aria-hidden="true">
    <span class="atelier-stage__initials">{initials}</span>
  </div>
  <canvas class="atelier-stage__canvas" role="img" aria-label={label}></canvas>
</div>
<AtelierStageScript />

<style>
  .atelier-stage {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--atelier-fabric);
    isolation: isolate;
  }
  .atelier-stage__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    /* a hint of weave so the pre-paint state already reads as cloth */
    background-image:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.035) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 35% 30%, rgb(255 255 255 / 0.12), rgb(0 0 0 / 0.12));
    transition: opacity 0.5s ease;
  }
  .atelier-stage__initials {
    font-family: var(--font-monogram, cursive);
    font-size: clamp(3rem, 18cqi, 9rem);
    line-height: 1;
    color: var(--atelier-thread);
    text-shadow: 1px 2px 2px rgb(0 0 0 / 0.18);
  }
  .atelier-stage {
    container-type: inline-size;
  }
  .atelier-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .atelier-stage[data-ready] .atelier-stage__canvas {
    opacity: 1;
  }
  .atelier-stage[data-ready] .atelier-stage__fallback {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .atelier-stage__fallback,
    .atelier-stage__canvas {
      transition: none;
    }
  }
</style>
