---
// Client wiring for AtelierStage. Lives in its own component (never a <script>
// inside a JSX expression; see .claude/rules/design-system.md). Astro bundles
// and de-duplicates this module, so many stages on a page share one copy.
//
// Lifecycle of one stage:
//   1. engine code: imported when the stage comes within 300px of the viewport,
//      or on idle after load, whichever is sooner. Stages that are not rendered
//      (display:none, e.g. inside a hidden panel) are never imported on idle,
//      only once they show; `data-lazy="true"` opts a stage out of the idle path.
//   2. stitching: starts the first time the stage is within 120px of the
//      viewport, from its data-* attributes at that moment.
//   3. off-screen: the animation pauses; back on screen it resumes.
//   4. on the first frame the data-* are checked once more, so a choice that a
//      page script wrote to data-* while the engine was starting is applied.
---

<script>
  import type { Atelier, Design } from '@/lib/atelier/engine';

  type StageEl = HTMLElement & { __atelier?: Atelier; __atelierCleanup?: () => void };
  type EngineModule = typeof import('@/lib/atelier/engine');

  const live = new Set<StageEl>();
  let engine: Promise<EngineModule> | null = null;
  const loadEngine = () => (engine ??= import('@/lib/atelier/engine'));

  function designFrom(el: StageEl): Partial<Design> {
    const d = el.dataset;
    return {
      text: d.text ?? '',
      style: (d.style as Design['style']) ?? 'classic',
      thread: d.thread ?? '#8c3a2e',
      fabric: d.fabric ?? '#efe6d6',
      fabricTexture: (d.texture as Design['fabricTexture']) ?? 'linen',
    };
  }

  const rendered = (el: HTMLElement) => el.getClientRects().length > 0;

  async function initStage(el: StageEl) {
    if (el.dataset.atelierInit) return;
    el.dataset.atelierInit = '1';
    const canvas = el.querySelector('canvas');
    if (!canvas) return;
    const { createAtelier } = await loadEngine();
    if (!el.isConnected || !el.dataset.atelierInit) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let reconciled = false;
    const atelier = createAtelier(canvas, {
      quality: el.dataset.quality === 'hero' ? 'hero' : 'studio',
      reducedMotion: reduced,
      onProgress: (progress) => {
        if (!el.dataset.ready) el.dataset.ready = '1';
        if (!reconciled) {
          reconciled = true;
          reconcile();
        }
        el.dispatchEvent(new CustomEvent('atelier:progress', { detail: { progress } }));
      },
    });
    el.__atelier = atelier;
    live.add(el);

    // A page script that changed data-* before the engine drew anything (and so
    // did not call setDesign itself) still gets its choice.
    function reconcile() {
      const want = designFrom(el);
      const have = atelier.getDesign();
      const hex = (v?: string) => (v ?? '').trim().replace(/^#/, '').toLowerCase();
      const text = Array.from(String(want.text ?? '').toLocaleUpperCase())
        .filter((c) => /[\p{L}\p{N}&]/u.test(c))
        .slice(0, 3)
        .join('');
      if (!text) return;
      if (text !== have.text || want.style !== have.style) void atelier.setDesign(want);
      else if (
        hex(want.thread) !== hex(have.thread) ||
        hex(want.fabric) !== hex(have.fabric) ||
        want.fabricTexture !== have.fabricTexture
      )
        void atelier.setDesign(want, { animate: false });
    }

    // Start stitching on first sight; pause the animation loop while off-screen.
    let started = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            // always resume first: a stage that began off-screen was paused
            atelier.resume();
            if (!started) {
              started = true;
              void atelier.setDesign(designFrom(el), {
                animate: el.dataset.autoplay !== 'false',
              });
            }
          } else atelier.pause();
        }
      },
      { rootMargin: '120px 0px' },
    );
    io.observe(el);
    el.__atelierCleanup = () => {
      io.disconnect();
      atelier.destroy();
      delete el.__atelier;
      delete el.dataset.atelierInit;
      delete el.dataset.ready;
    };
    el.dispatchEvent(new CustomEvent('atelier:ready', { detail: { atelier }, bubbles: true }));
  }

  // Import (and create) the engine when a stage nears the viewport.
  let near: IntersectionObserver | null = null;
  function watch(el: StageEl) {
    if (el.dataset.atelierWatch) return;
    el.dataset.atelierWatch = '1';
    near ??= new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          near?.unobserve(e.target);
          void initStage(e.target as StageEl);
        }
      },
      { rootMargin: '300px 0px' },
    );
    near.observe(el);
    live.add(el);
  }

  // ...or on idle after load, for stages that are rendered and not opted out.
  function idleInit() {
    const run = () => {
      document.querySelectorAll<StageEl>('[data-atelier-stage]').forEach((el) => {
        if (el.dataset.lazy === 'true' || !rendered(el)) return;
        near?.unobserve(el);
        void initStage(el);
      });
    };
    const idle = () => {
      if (typeof window.requestIdleCallback === 'function')
        window.requestIdleCallback(run, { timeout: 4000 });
      else setTimeout(run, 1500);
    };
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }

  function initAll() {
    const stages = document.querySelectorAll<StageEl>('[data-atelier-stage]');
    if (!stages.length) return;
    stages.forEach(watch);
    idleInit();
  }

  function teardown() {
    for (const el of live) {
      el.__atelierCleanup?.();
      delete el.dataset.atelierWatch;
    }
    live.clear();
    near?.disconnect();
    near = null;
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', teardown);
</script>
