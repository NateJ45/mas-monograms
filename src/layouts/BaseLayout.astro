---
// Foundation, edit with care
// Site-wide layout. Provides:
//   - <html lang>, document head, OG/Twitter meta
//   - Fraunces / Mulish / Petemoss fonts (loaded via @fontsource in globals.css)
//   - Cloudflare Web Analytics beacon (conditional)
//   - Astro View Transitions <ClientRouter />
//   - Skip-to-main link, Header, <main id="main">, Footer
//   - BackToTop React island
//   - Direction D (2026-10-04): the early `.js` class on <html>, the golden
//     ThreadLine inside <main>, the scroll-reveal script, and the header
//     overlay mode (header="overlay" for pages that open on a dark hero)

import { ClientRouter } from 'astro:transitions';
import { site } from '@/data/site';
import { urlFor } from '@/lib/sanity';
import { localBusinessSchema } from '@/lib/schemas';
import { getActiveAnnouncement, getAllLegalPages, getAllClearanceItems } from '@/lib/queries';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BackToTop from '@/components/BackToTop';
import ThreadLine from '@/components/motifs/ThreadLine.astro';
import RevealScript from '@/components/motifs/RevealScript.astro';
import '@/styles/globals.css';
// Starwind UI CSS — accordion keyframes + @theme inline for new semantic tokens.
// Imported AFTER globals.css so the brand :root declarations in globals.css win
// the cascade over starwind.css's fallback :root defaults.
import '@/styles/starwind.css';

interface Props {
  title: string;
  description: string;
  /** Override the default OG image. If omitted, BaseLayout falls back through page seoImage → siteSettings seoImage → /og-default.png. */
  ogImage?: string;
  /** Raw Sanity image object for a per-page social share override (seoImage on the page singleton). Resolved through the Sanity image pipeline to a 1200x630 OG URL. Lower priority than ogImage, higher than the siteSettings default. */
  seoImage?: any;
  /** Pre-serialized JSON-LD strings injected into <head>. LocalBusiness is auto-injected from siteSettings on every page; pass per-page schemas (Service, FAQPage, BreadcrumbList, CreativeWork) here. */
  schemas?: string[];
  /** Sanity siteSettings document — drives footer, header, and the LocalBusiness schema. */
  siteSettings?: any;
  /** When true, emit <meta name="robots" content="noindex, follow">. Used by the 404 page so it never gets indexed. Defaults to false (the page is indexable). */
  noindex?: boolean;
  /** Open Graph type. Defaults to 'website'. Pass 'article' for journal post pages. */
  ogType?: 'website' | 'article';
  /** Article metadata. Only used when ogType is 'article'. */
  ogArticle?: { publishedAt?: string; author?: string };
  /**
   * Header treatment. 'solid' (default): linen bar under a midnight contact
   * strip, page content starts below it. 'overlay': the header sits
   * transparent over the page's first section (a dark hero), <main> slides up
   * under it, and that first section must clear it with the `pt-header` class.
   * The header solidifies on scroll in both modes.
   */
  header?: 'solid' | 'overlay';
  /** The golden ThreadLine sewn down the page. Default true. */
  thread?: boolean;
}

const {
  title,
  description,
  ogImage,
  seoImage,
  schemas = [],
  siteSettings = null,
  noindex = false,
  ogType = 'website',
  ogArticle,
  header = 'solid',
  thread = true,
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, site.url).toString();

// Resolve a raw Sanity image object to a 1200x630 OG URL through the image
// pipeline. Returns null when there's no asset (so the ?? chain falls through
// to the next source) or if the URL builder throws on a malformed object.
function ogUrlFromImage(img: any): string | null {
  if (!img?.asset) return null;
  try {
    return urlFor(img).width(1200).height(630).fit('crop').auto('format').url();
  } catch {
    return null;
  }
}

// OG image priority: explicit ogImage prop (a real photo passed by detail
// pages) > per-page seoImage override (page singleton) > global seoImage
// default (siteSettings) > the shipped default card (public/og-default.png).
// The final fallback is a file that always exists, so pages without a real
// image degrade to a valid card instead of a per-route /og/<slug>.png that MAS
// never generates (those 404'd).
const perPageOg = ogUrlFromImage(seoImage);
const globalOg = ogUrlFromImage(siteSettings?.seoImage);
const resolvedOg = ogImage ?? perPageOg ?? globalOg ?? site.assets.ogDefault;
const absOg = resolvedOg.startsWith('http') ? resolvedOg : new URL(resolvedOg, site.url).toString();

// Build the document title. If the editor-supplied seoTitle already contains
// the brand name anywhere, use it verbatim. Otherwise append " — {site.name}"
// so the tab + search-result line carries the brand. Strips a trailing suffix
// once before evaluating so any legacy pre-baked suffix is handled.
const brandSuffix = ` — ${site.name}`;
const cleanTitle = title.endsWith(brandSuffix) ? title.slice(0, -brandSuffix.length) : title;
const hasBrandInline = cleanTitle.toLowerCase().includes(site.name.toLowerCase());
const fullTitle =
  cleanTitle === site.name || hasBrandInline ? cleanTitle : `${cleanTitle} — ${site.name}`;

// Auto-inject LocalBusiness on every page when siteSettings is available.
// Pages can still pass their own additional schemas (Service, FAQPage, BreadcrumbList).
const allSchemas = siteSettings ? [localBusinessSchema(siteSettings), ...schemas] : schemas;

// Cloudflare Web Analytics token — only render the beacon when present.
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// Optional site-wide announcement banner (Announcement collection in Sanity).
// Fetched here once so every page gets it without each page running its own
// query. Returns null when no active announcement exists (graceful absence).
// Evaluated at BUILD TIME — banner changes require a rebuild. No .catch on
// these reads: sanityFetch throws on a failed read in a production build, and
// swallowing that would ship every page with the banner and footer links gone.
const announcement = await getActiveAnnouncement();
// Legal/policy pages for the footer links (Sanity-managed collection).
const legalPages = await getAllLegalPages();
// Hide the Clearance nav/footer link entirely when there's nothing on clearance.
const clearanceItems = await getAllClearanceItems();
const hasClearance = (clearanceItems?.length ?? 0) > 0;
const showAnnouncement = !!announcement?.message;

// Map announcement style -> semantic Tailwind token classes.
// Uses only existing semantic tokens (no new custom tokens introduced).
//   info      -> muted surface (calm, informational)
//   highlight -> primary surface (brand accent, promotions / good news)
//   urgent    -> destructive surface (red, closures / warnings)
const ANNOUNCEMENT_STYLES: Record<string, { wrapper: string; link: string }> = {
  info: {
    wrapper: 'bg-muted text-foreground',
    link: 'font-semibold underline underline-offset-2 hover:opacity-70 transition-opacity',
  },
  highlight: {
    wrapper: 'bg-primary text-primary-foreground',
    link: 'font-semibold underline underline-offset-2 hover:opacity-70 transition-opacity',
  },
  urgent: {
    wrapper: 'bg-destructive text-destructive-foreground',
    link: 'font-semibold underline underline-offset-2 hover:opacity-70 transition-opacity',
  },
};
const announcementStyle =
  ANNOUNCEMENT_STYLES[announcement?.style ?? 'info'] ?? ANNOUNCEMENT_STYLES.info;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Direction D: mark JS as available before first paint, so CSS can tell a
        scripted page from a no-JS one (header overlay fallback, ThreadLine).
        ClientRouter swaps <html> attributes on navigation, so re-add it then. */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!window.__jsClassBound) {
        window.__jsClassBound = true;
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('js');
        });
      }
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /* Mobile browser UI chrome color — Heirloom Coast Linen. Single value:
        this site has no dark mode, by design (see docs/superpowers/specs/
        2026-07-01-redesign-audit-and-recommendations.md). */
    }
    <meta name="theme-color" content="#F4EEE3" />

    {
      /* Icon set generated by scripts/generate-favicons.mjs from the badge mark
        (see docs/logo-concepts/). The SVG carries outlined letterforms — favicons
        can't load webfonts. */
    }
    {/* sizes="32x32" on the .ico line works around Chrome preferring ICO over SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      /* Note: fonts (Fraunces display, Mulish body, Petemoss monogram) are loaded
        via @fontsource @import in globals.css. Vite hashes the woff2 filename at
        build time so a static preload here would 404. If hero h1 LCP needs faster
        fonts, switch to font-display: optional or generate the preload tag from
        the built CSS manifest. */
    }

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    {
      ogType === 'article' && ogArticle?.publishedAt && (
        <meta property="article:published_time" content={ogArticle.publishedAt} />
      )
    }
    {
      ogType === 'article' && ogArticle?.author && (
        <meta property="article:author" content={ogArticle.author} />
      )
    }
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absOg} />

    {/* JSON-LD (LocalBusiness auto-injected from siteSettings + per-page schemas) */}
    {allSchemas.map((json) => <script type="application/ld+json" set:html={json} />)}

    {/* Cloudflare Web Analytics — conditional, no cookie banner needed. */}
    {
      cfToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfToken}"}`}
        />
      )
    }

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col" data-header={header}>
    <a href="#main" class="skip-link">Skip to main content</a>

    {
      /* Optional announcement banner. Renders above the header when an active
        announcement exists in Sanity. Scrolls away with the page content.
        No dismiss button by design -- static sites rebuild to remove a banner,
        and a dismiss button would require client-side JS + localStorage state.
        Style driven by announcement.style -> semantic token classes only. */
    }
    {
      showAnnouncement && (
        <div
          class:list={[
            announcementStyle.wrapper,
            'border-b border-black/10 px-m py-2 text-center text-sm',
          ]}
          role="region"
          aria-label="Site announcement"
        >
          <span>{announcement!.message}</span>
          {announcement?.link?.url && announcement?.link?.label && (
            <a href={announcement.link.url} class:list={['ml-2', announcementStyle.link]}>
              {announcement.link.label}
            </a>
          )}
        </div>
      )
    }

    <Header siteSettings={siteSettings} hasClearance={hasClearance} tone={header} />

    {
      /* `relative isolate`: <main> is the stacking context the golden thread
        lives in (z-index -1), between the surface grounds (-2) and the
        content. See "Surfaces" in globals.css. */
    }
    <main id="main" class="relative isolate flex-1">
      {thread && <ThreadLine />}
      <slot />
    </main>

    <Footer siteSettings={siteSettings} legalPages={legalPages} hasClearance={hasClearance} />

    {
      /*
      This island was previously `client:load` which forced the JS to
      execute before the first paint completed. It isn't interactive
      until later in the page lifecycle (BackToTop only appears after the
      visitor scrolls 600px). Hydrating with `client:idle` lets the
      browser settle the main thread first and shifts ~10–20ms of TBT off
      the critical path on mobile.
    */
    }
    <BackToTop client:idle />

    <RevealScript />

    {
      /* Polish layer: the image-curtain and step-connector observers. Both
        honor prefers-reduced-motion. Re-init on astro:page-load so they
        survive View Transitions. Scroll reveals are motifs/RevealScript. */
    }
    <script>
      function initPolish() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ---- Scroll reveals ---------------------------------------------
        // Scroll-reveal + grid-stagger observers removed in the Direction C
        // motion pass (2026-07-03) along with their CSS — content no longer
        // animates in on scroll. The two observers below (image curtain,
        // step connector) are the surviving scroll-linked effects.

        // ---- Image curtain reveal -------------------------------------------
        // Adds .is-revealed to each .img-curtain when it enters the viewport.
        // Under reduced-motion, CSS hides curtains entirely so this loop is moot.
        const curtains = document.querySelectorAll<HTMLElement>('.img-curtain:not(.is-revealed)');
        if (curtains.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            curtains.forEach((el) => el.classList.add('is-revealed'));
          } else {
            const curtainObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                    curtainObserver.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -80px 0px', threshold: 0.1 },
            );
            curtains.forEach((el) => curtainObserver.observe(el));
          }
        }

        // ---- Process connector lines ----------------------------------------
        // Adds .is-visible to each .step-connector when it enters the viewport,
        // triggering the scaleY draw animation on the ::after fill.
        const connectors = document.querySelectorAll<HTMLElement>(
          '.step-connector:not(.is-visible)',
        );
        if (connectors.length > 0) {
          if (reduceMotion || !('IntersectionObserver' in window)) {
            connectors.forEach((el) => el.classList.add('is-visible'));
          } else {
            const connectorObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    connectorObserver.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -60px 0px', threshold: 0.05 },
            );
            connectors.forEach((el) => connectorObserver.observe(el));
          }
        }

        // The sticky header's scroll behaviour (condense + solidify) lives in
        // Header.astro since Direction D; it no longer hides on scroll-down.
      }

      // Run on first load and after every View Transitions navigation.
      initPolish();
      document.addEventListener('astro:page-load', initPolish);
    </script>
  </body>
</html>
