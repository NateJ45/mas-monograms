---
// Home (Direction D, "The Atelier", 2026-10-04). Section rhythm, dark and
// light alternating so the golden ThreadLine reads over the cloth:
//   Hero (Midnight, live stitching) / Marquee (Indigo) / The Atelier (Linen) /
//   Hoop wall (Midnight) / Maker (Indigo) / Process (Paper) /
//   Studio wall (Midnight, a linen board) / Final CTA (Indigo, thread end).
// Every band is a top-level .surface-* child of <main>; no data-reveal,
// transform or filter on the bands themselves (see docs/02-design-system.md).
// Every visible string comes from Sanity (homePage, atelierSettings,
// itemCategory, threadColor, galleryItem).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Marquee from '@/components/motifs/Marquee.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HoopWall from '@/components/home/HoopWall.astro';
import MakerBand from '@/components/home/MakerBand.astro';
import ProcessPath from '@/components/home/ProcessPath.astro';
import StudioWall from '@/components/home/StudioWall.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import AtelierStudio from '@/components/atelier/AtelierStudio.astro';
import {
  getSiteSettings,
  getHomePage,
  getAllItemCategories,
  getAtelierSettings,
  getAllThreadColors,
  getGalleryItemsForWall,
} from '@/lib/queries';

const [siteSettings, page, categories, atelier, threads, wallItems] = await Promise.all([
  getSiteSettings(),
  getHomePage(),
  getAllItemCategories(),
  getAtelierSettings(),
  getAllThreadColors(),
  getGalleryItemsForWall(12),
]);

const title =
  page?.seoTitle ??
  siteSettings?.seoTitle ??
  'MAS Monograms — Custom Embroidery in St. Matthews, SC';
const description =
  page?.seoDescription ??
  siteSettings?.seoDescription ??
  'Hand-embroidered monograms and personalized gifts by Mary Ann Stone. Quality custom embroidery on towels, bags, shirts, baby items, and more.';

const marqueeItems: string[] = (categories ?? [])
  .map((c: any) => c?.name)
  .filter((n: unknown): n is string => typeof n === 'string' && !!n.trim());
---

<BaseLayout
  {title}
  {description}
  seoImage={page?.seoImage ?? siteSettings?.seoImage}
  {siteSettings}
  header="overlay"
>
  <HomeHero page={page} atelier={atelier} threads={threads ?? []} />

  {
    marqueeItems.length > 0 && (
      <section class="home-marquee surface-indigo">
        <div class="home-marquee__row">
          {page?.marqueeEyebrow && (
            <p class="eyebrow home-marquee__label" aria-hidden="true">
              {page.marqueeEyebrow}
            </p>
          )}
          <Marquee
            items={marqueeItems}
            label={page?.marqueeEyebrow}
            pauseLabel={atelier?.pauseLabel}
            playLabel={atelier?.playLabel}
            speed={60}
            class="home-marquee__ribbon"
          />
        </div>
      </section>
    )
  }

  {
    atelier && (
      <section
        id="atelier"
        class="home-atelier surface-linen py-section-lg"
        aria-labelledby="atelier-heading"
      >
        <div class="mx-auto max-w-content px-m">
          <AtelierStudio settings={atelier} threads={threads ?? []} headingId="atelier-heading" />
        </div>
      </section>
    )
  }

  {categories.length > 0 && <HoopWall page={page} categories={categories} />}

  {(page?.aboutHeadline || page?.makerQuote) && <MakerBand page={page} />}

  <ProcessPath page={page} />

  <StudioWall page={page} items={wallItems ?? []} />

  <FinalCta page={page} />
</BaseLayout>

<style>
  .home-marquee {
    border-block: 1px solid rgb(217 177 95 / 0.25);
  }
  .home-marquee__row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }
  .home-marquee__label {
    flex: none;
    padding-left: max(1rem, calc((100vw - 82.5rem) / 2 + 1rem));
    white-space: nowrap;
  }
  .home-marquee__row :global(.home-marquee__ribbon) {
    flex: 1;
    min-width: 0;
  }
  @media (max-width: 639px) {
    .home-marquee__label {
      display: none;
    }
  }
  .home-atelier {
    scroll-margin-top: var(--header-h);
  }
</style>
