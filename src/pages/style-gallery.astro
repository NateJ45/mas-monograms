---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScriptKicker from '@/components/ScriptKicker.astro';
import SanityImage from '@/components/SanityImage.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import CtaLink from '@/components/CtaLink.astro';
import SwatchCard from '@/components/motifs/SwatchCard.astro';
import GallerySwatch from '@/components/gallery/GallerySwatch.astro';
import Lightbox from '@/components/gallery/Lightbox.astro';
import { splitSwash } from '@/components/gallery/swash';
import { getSiteSettings, getStyleGalleryPage, getAllGalleryItems } from '@/lib/queries';

const [siteSettings, page, items] = await Promise.all([
  getSiteSettings(),
  getStyleGalleryPage(),
  getAllGalleryItems(),
]);

const title = page?.seoTitle ?? 'Style Gallery — MAS Monograms';
const description =
  page?.seoDescription ??
  'Browse the MAS Monograms photo gallery for inspiration — see real embroidery samples across fonts, items, and color combinations.';

// ─── Tag normalisation ──────────────────────────────────────────────────────
// Two tags mean "appliqué" — canonicalise the accented one so it filters as
// one. Meta tags describe the PHOTO, not the work, so they never become
// filters (and are stripped from data-tags so they can't match anything).
const META_TAGS = new Set(['closeup', 'customer-photo']);
const TAG_ALIASES: Record<string, string> = { appliqué: 'applique' };

function normalizeTag(tag: string): string {
  return TAG_ALIASES[tag] ?? tag;
}

// Per-item cleaned tag list (aliased + meta stripped + de-duped). Used both for
// the count map below and for each card's data-tags attribute, so the
// client-side filter matches on the same canonical set the pills use.
function cleanTags(raw: unknown): string[] {
  if (!Array.isArray(raw)) return [];
  const out: string[] = [];
  for (const t of raw) {
    if (typeof t !== 'string') continue;
    const n = normalizeTag(t);
    if (META_TAGS.has(n)) continue;
    if (!out.includes(n)) out.push(n);
  }
  return out;
}

// Count how many photos carry each (canonical, non-meta) tag.
const tagCounts = new Map<string, number>();
for (const item of items as any[]) {
  for (const t of cleanTags(item.tags)) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}

const presentTags = new Set(tagCounts.keys());

// Order a list of tags by descending photo count (ties broken alphabetically),
// keeping only tags that actually occur — never surface a dead-end filter.
function orderPresent(tags: string[]): string[] {
  return tags
    .filter((t) => presentTags.has(t))
    .sort((a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b));
}

function titleCase(slug: string): string {
  return slug
    .split('-')
    .map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w))
    .join(' ');
}

// ─── Build the rendered groups ──────────────────────────────────────────────
type RenderGroup = { label: string; tags: string[] };

const configuredGroups: Array<{ groupLabel?: string; tags?: string[] }> = page?.filterGroups ?? [];

let renderGroups: RenderGroup[] = [];

if (configuredGroups.length > 0) {
  // Curated taxonomy: each group shows only its present tags, most photos first.
  renderGroups = configuredGroups
    .map((g) => ({
      label: g.groupLabel ?? 'Filters',
      tags: orderPresent((g.tags ?? []).map(normalizeTag)),
    }))
    .filter((g) => g.tags.length > 0);
} else {
  // Fallback (pre-seed): one "Filters" group of every present tag. Still drops
  // meta tags and merges the dup, so it never regresses to the raw pill wall.
  const allPresent = orderPresent(Array.from(presentTags));
  if (allPresent.length > 0) {
    renderGroups = [{ label: 'Filters', tags: allPresent }];
  }
}

const hasFilters = renderGroups.length > 0;
const MAX_VISIBLE = 8; // tags shown before the "+ more" toggle kicks in

const filterAllLabel = page?.filterAllLabel ?? 'All';

const headline = splitSwash(page?.heroHeadline ?? 'Style Gallery');
const withPhotos = (items as any[]).filter((i) => i?.image?.asset);
const total = withPhotos.length;
// Three swatches fanned beside the intro: featured photos first. Decorative
// (the same photos are on the wall below with their alt text).
const fan = [
  ...withPhotos.filter((i) => i.featured),
  ...withPhotos.filter((i) => !i.featured),
].slice(0, 3);
---

<BaseLayout {title} {description} seoImage={page?.seoImage} {siteSettings}>
  {
    /* Direction D: a Midnight opening band, display headline with the swash,
      and three swatches fanned out beside it like samples on the cutting
      table. Then the swatch WALL on linen: every photo a pinked fabric swatch
      that opens the lightbox. */
  }
  <section class="gallery-intro surface-midnight py-section-lg" aria-labelledby="gallery-heading">
    <div
      class="gap-xl mx-auto grid max-w-content grid-cols-1 items-center px-m lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"
    >
      <div>
        {
          page?.heroEyebrow && (
            <div data-reveal="fade">
              <ScriptKicker text={page.heroEyebrow} onDark class="mb-s" />
            </div>
          )
        }
        <h1 id="gallery-heading" class="display-sm max-w-[14ch]" data-reveal>
          {headline.before}<em class="swash">{headline.word}</em>{headline.after}
        </h1>
        {
          page?.heroSubhead && (
            <p class="lede mt-m" data-reveal style="--reveal-delay: 120ms">
              {page.heroSubhead}
            </p>
          )
        }
        {
          /* Photo → quote bridge: a visible path from browsing inspiration to
            starting a real request, right under the intro. */
        }
        <div class="mt-l" data-reveal style="--reveal-delay: 200ms">
          <CtaLink
            cta={{ label: 'Start your quote', href: '/request-a-quote' }}
            variant="primary"
          />
        </div>
      </div>
      {
        fan.length === 3 && (
          <div class="gallery-fan" aria-hidden="true" data-reveal="fade">
            {fan.map((item: any, i: number) => (
              <SwatchCard
                tone={(['paper', 'blush', 'sage'] as const)[i]}
                tilt={[-7, 3, 9][i]}
                class={`gallery-fan__card gallery-fan__card--${i}`}
              >
                <SanityImage
                  slot="media"
                  source={item.image}
                  width={360}
                  height={440}
                  alt=""
                  loading={i === 1 ? 'eager' : 'lazy'}
                  sizes="(max-width: 1024px) 40vw, 18rem"
                />
              </SwatchCard>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* The swatch wall, with the client-side filter */}
  <section class="surface-linen py-section-lg">
    <div class="mx-auto max-w-content px-m">
      {
        /* Grouped filters. On mobile the whole block collapses behind one
          "Filter" disclosure so photos lead on first paint; on sm+ it's
          always open. The panel is rendered `open` so it reserves layout
          height — a closed disclosure collapses to zero height even when its
          content is force-shown via CSS, which would overlap the grid. The
          init script closes it on mobile so it collapses behind the summary. */
      }
      {
        hasFilters && (
          <details class="gallery-filter-panel group mb-l" id="gallery-filters-panel" open>
            <summary class="chip hit-44 relative mx-auto mb-m flex w-max cursor-pointer list-none items-center justify-center gap-xs px-m py-xs select-none sm:hidden">
              <span>{page?.filterToggleLabel ?? 'Filter'}</span>
              <svg
                class="h-3 w-3 transition-transform group-open:rotate-180"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2 4l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>

            <div id="gallery-filters" role="group" aria-label="Filter gallery">
              {/* "All" reset button, with the running count beside it */}
              <div class="mb-m flex items-center justify-center gap-m">
                <button
                  type="button"
                  data-filter="all"
                  class="gallery-filter chip active-filter hit-44 relative px-m py-xs"
                  aria-pressed="true"
                >
                  {filterAllLabel}
                </button>
                <p class="gallery-count" aria-hidden="true">
                  <span class="gallery-count__n" data-gallery-count>
                    {total}
                  </span>
                  <span class="gallery-count__of">/ {total}</span>
                </p>
              </div>

              {/* One labelled block per group */}
              <div class="space-y-m">
                {renderGroups.map((grp) => {
                  const visible = grp.tags.slice(0, MAX_VISIBLE);
                  const overflow = grp.tags.slice(MAX_VISIBLE);
                  return (
                    <div class="text-center">
                      <p class="eyebrow eyebrow--center mb-s justify-center">{grp.label}</p>
                      <div class="flex flex-wrap justify-center gap-x-s gap-y-5">
                        {visible.map((tag) => (
                          <button
                            type="button"
                            data-filter={tag}
                            class="gallery-filter chip hit-44 relative px-m py-xs"
                            aria-pressed="false"
                          >
                            {titleCase(tag)}
                          </button>
                        ))}
                        {overflow.length > 0 && (
                          <details class="more-tags group/more inline">
                            <summary class="gallery-more-toggle chip chip--quiet hit-44 relative inline-flex cursor-pointer list-none items-center px-m py-xs select-none">
                              <span class="group-open/more:hidden">+ {overflow.length} more</span>
                              <span class="hidden group-open/more:inline">Less</span>
                            </summary>
                            <span class="contents">
                              {overflow.map((tag) => (
                                <button
                                  type="button"
                                  data-filter={tag}
                                  class="gallery-filter chip hit-44 relative my-[9px] ml-s px-m py-xs"
                                  aria-pressed="false"
                                >
                                  {titleCase(tag)}
                                </button>
                              ))}
                            </span>
                          </details>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </details>
        )
      }
      <p
        class="sr-only"
        role="status"
        id="gallery-status"
        data-total={total}
        data-template={page?.resultsAnnouncement ?? undefined}
      >
      </p>

      {
        items.length > 0 ? (
          <div class="gallery-wall columns-2 gap-m sm:columns-3 lg:columns-4" id="gallery-grid">
            {(items as any[]).map((item, i) => (
              <GallerySwatch
                item={item}
                index={i}
                tags={cleanTags(item.tags)}
                requestLabel={page?.requestLabel}
              />
            ))}
          </div>
        ) : (
          <p class="py-l text-center text-[var(--color-text-secondary)]">
            {page?.emptyStateMessage ?? 'Gallery photos coming soon.'}
          </p>
        )
      }
      <div id="gallery-empty" class="hidden py-l text-center">
        <p class="lede mx-auto">
          {page?.emptyStateMessage ?? 'No items match that filter.'}
        </p>
      </div>
    </div>
  </section>

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    swash={page?.ctaHeadline ? splitSwash(page.ctaHeadline).word : undefined}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
  <Lightbox
    label={page?.lightboxLabel}
    closeLabel={page?.lightboxCloseLabel}
    prevLabel={page?.lightboxPrevLabel}
    nextLabel={page?.lightboxNextLabel}
  />
</BaseLayout>

<style>
  /* Three swatches fanned like samples laid on the cutting table. */
  .gallery-fan {
    position: relative;
    height: clamp(17rem, 34vw, 27rem);
    max-width: 30rem;
    width: 100%;
    margin-inline: auto;
  }
  .gallery-fan :global(.gallery-fan__card) {
    position: absolute;
    /* 52%, not 56%: with the -92% / -8% fan offsets a 56% card hung 1.5% outside
       the fan on each side, and the 9deg tilt pushed the right card past the
       viewport at 1024px (reflow test). At 52% both outer cards stay inside. */
    width: 52%;
    top: 50%;
    left: 50%;
  }
  .gallery-fan :global(.gallery-fan__card img) {
    aspect-ratio: 36 / 44;
    object-fit: cover;
  }
  @media (max-width: 639px) {
    .gallery-fan {
      height: 15rem;
    }
    .gallery-fan :global(.gallery-fan__card) {
      width: 44%;
    }
  }
  .gallery-fan :global(.gallery-fan__card--0) {
    translate: -92% -50%;
  }
  .gallery-fan :global(.gallery-fan__card--1) {
    translate: -50% -56%;
    z-index: 1;
  }
  .gallery-fan :global(.gallery-fan__card--2) {
    translate: -8% -44%;
  }

  /* Stitched filter chips: a dashed brass running stitch at rest, Claret
     cloth when pressed. 44px tap areas come from .hit-44 (PR #72). */
  .chip {
    border-radius: var(--radius-pill);
    border: 1.5px dashed var(--color-brass-text);
    background: rgba(251, 248, 241, 0.6);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .chip:hover {
    border-style: solid;
    color: var(--foreground);
    background: var(--color-paper);
  }
  .chip[aria-pressed='true'] {
    border: 1.5px solid var(--color-rust-cta, #8c3a2e);
    background: var(--color-rust-cta, #8c3a2e);
    color: var(--color-paper);
    box-shadow:
      inset 0 0 0 3px var(--color-rust-cta, #8c3a2e),
      inset 0 0 0 4px rgba(251, 248, 241, 0.55);
  }
  .chip--quiet {
    background: transparent;
  }
  .gallery-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display);
    color: var(--color-text-secondary);
  }
  .gallery-count__n {
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }
  .gallery-count__of {
    font-size: var(--text-compact);
  }

  /* Hide the default disclosure triangle on our filter summaries. */
  .gallery-filter-panel > summary::-webkit-details-marker,
  .more-tags > summary::-webkit-details-marker {
    display: none;
  }
  /* Smooth the fade back IN when a tile stops being filtered out (the tile is a
     plain div, so it has no default transition). The fade OUT is driven by
     `.is-filtered-out` in globals.css. */
  .gallery-wall :global(.gallery-item) {
    transition:
      opacity 360ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-wall :global(.gallery-item) {
      transition: none;
    }
  }
  /* Keep the filter panel open on sm+ regardless of the <details> open attr. */
  @media (min-width: 640px) {
    .gallery-filter-panel > #gallery-filters {
      display: block !important;
    }
    .gallery-filter-panel > summary {
      display: none;
    }
  }
</style>

<script>
  function initGalleryFilter() {
    const filters = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
    const items = document.querySelectorAll<HTMLElement>('.gallery-item');
    const emptyMsg = document.getElementById('gallery-empty');
    const countEl = document.querySelector<HTMLElement>('[data-gallery-count]');
    const status = document.getElementById('gallery-status');
    if (!filters.length || !items.length) return;

    // The panel is rendered `open` (so it reserves height on desktop, where the
    // summary is hidden). On mobile, collapse it so photos lead on first paint;
    // the summary then toggles it. Desktop keeps it open — CSS hides the summary.
    const panel = document.getElementById('gallery-filters-panel');
    if (panel && window.matchMedia('(max-width: 639px)').matches) {
      panel.removeAttribute('open');
    }

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.filter ?? 'all';

        // Update button states across every group (the chip style keys off aria-pressed).
        filters.forEach((b) => {
          const active = b.dataset.filter === tag;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('active-filter', active);
        });

        // Filter items with a fade instead of a hard pop. `display` can't be
        // transitioned, so to HIDE we add `.is-filtered-out` (opacity + scale
        // fade, 360ms in globals.css) first, then set `display:none` after the
        // transition so the masonry `columns` layout reflows. To SHOW we clear
        // `display` first, then drop `.is-filtered-out` on the next frame so the
        // tile fades back in. Honour reduced-motion by skipping the delay.
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const HIDE_MS = 360;
        let visible = 0;
        items.forEach((item) => {
          const tags: string[] = JSON.parse(item.dataset.tags ?? '[]');
          const show = tag === 'all' || tags.includes(tag);

          if (show) {
            visible++;
            item.style.display = '';
            if (reduceMotion) {
              item.classList.remove('is-filtered-out');
            } else {
              // Fade back in on the next frame so the display change lands first.
              requestAnimationFrame(() => {
                requestAnimationFrame(() => item.classList.remove('is-filtered-out'));
              });
            }
          } else {
            if (item.classList.contains('is-filtered-out') && item.style.display === 'none') {
              return; // already hidden
            }
            if (reduceMotion) {
              item.classList.add('is-filtered-out');
              item.style.display = 'none';
            } else {
              item.classList.add('is-filtered-out');
              window.setTimeout(() => {
                // Only collapse if it's still filtered out (guards against a
                // rapid re-select flipping it back to visible mid-transition).
                if (item.classList.contains('is-filtered-out')) {
                  item.style.display = 'none';
                }
              }, HIDE_MS);
            }
          }
        });
        if (emptyMsg) emptyMsg.classList.toggle('hidden', visible > 0);
        if (countEl) countEl.textContent = String(visible);
        // Screen readers hear the new count (the visible counter is aria-hidden).
        if (status) {
          const total = status.dataset.total ?? String(items.length);
          const name = (btn.textContent ?? '').trim();
          // Sanity template (styleGalleryPage.resultsAnnouncement), e.g.
          // "{filter}: showing {count} of {total} photos"; numbers-only fallback.
          const template = status.dataset.template || '{filter}: {count} / {total}';
          status.textContent = template
            .replaceAll('{filter}', name)
            .replaceAll('{count}', String(visible))
            .replaceAll('{total}', total);
        }
      });
    });
  }
  initGalleryFilter();
  document.addEventListener('astro:page-load', initGalleryFilter);
</script>
