---
/* ============================================================================
   Preview route - the REAL pages, from draft data, for "Edit on the page"
   (ported from ncs-astro-sanity-starter 2026-08-28, PORTS.md cards 10 and 17;
   rebuilt 2026-10-05, Phase C of the Studio upgrade)
   ============================================================================
   One SSR route renders ANY page in draft mode for the Presentation tool. It
   reads the perspective cookie, runs the page's own LOADER (src/lib/page-data.ts)
   through the draft-aware client (stega on), and then renders THE PAGE FILE
   ITSELF (src/pages/<name>.astro, imported below as a component) with a
   `preview` prop: the draft data, the click-target document and PreviewLayout.
   The page wears that shell instead of BaseLayout and skips its own fetch.

   So the canvas Mary Ann edits in IS her website: same header and footer, same
   sections, same photos, same order, from one file. There is no "editable
   surface" stand-in any more (that was the 2026-08-28 shape: a hero, the raw
   lists and a note, in the pre-redesign look).

   WHY THE PAGE FILE AND NOT A SHARED "BODY" COMPONENT (tried first, 2026-10-05):
   moving a page's markup into a component of its own changed the LIVE HTML.
   The extra component boundary reorders rendering, so React's generated ids in
   the FAQ accordion moved (r9 -> r17), and it reorders the CSS modules, so a
   component's styles landed after the page's own on /thank-you (a cascade
   change, not just bytes). Rendering the page file itself keeps its markup,
   styles and scripts exactly where they were: `npm run parity compare` stays
   23/23 by construction.

   What the preview adds on top of the live markup, and only here:
     - stega on every string (click a line to edit it, and the "Edit here" card
       on the lines registered in src/lib/page-fields.ts);
     - `data-sanity` click targets on photos and list items, through the
       page's `edit` (src/lib/edit-target.ts). The live pages never get one, so
       the static HTML carries none of it.

   Keep the path map in sync with SINGLETON_PREVIEW_PATHS in
   src/sanity/resolve.ts and FIRST_SEGMENT_PREVIEWABLE in
   src/layouts/PreviewLayout.astro. Category pages (/<slug>) are matched by
   their documents here and handed to the layout as data. noindex comes from
   PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import { isStudioPreview } from '@/lib/preview-auth';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import { previewFetch, previewConfig, previewUnconfiguredResponse } from '@/lib/cms-preview';
import { SITE_SETTINGS_PROJECTION } from '@/lib/queries';
import {
  loadAbout,
  loadCategory,
  loadClearance,
  loadFontGuide,
  loadHome,
  loadHowItWorks,
  loadNotFound,
  loadPricing,
  loadRequestQuote,
  loadShopByItem,
  loadStyleGallery,
  loadThankYou,
  loadThreadChart,
  previewFetcher,
  type Fetcher,
} from '@/lib/page-data';
import type { EditDoc } from '@/lib/preview-edit-attr';
import HomePage from '../index.astro';
import HowItWorksPage from '../how-it-works.astro';
import PricingPage from '../pricing.astro';
import AboutPage from '../about.astro';
import RequestQuotePage from '../request-a-quote.astro';
import ShopByItemPage from '../shop-by-item.astro';
import StyleGalleryPage from '../style-gallery.astro';
import FontGuidePage from '../font-lettering-guide.astro';
import ThreadChartPage from '../thread-color-chart.astro';
import ClearancePage from '../clearance.astro';
import ThankYouPage from '../thank-you.astro';
import NotFoundBody from '@/components/pages/NotFoundBody.astro';
import CategoryPage from '../[slug].astro';

// Fresh clone / unset secret: say so, do not 500.
const config = previewConfig();
if (!config.ok) {
  return previewUnconfiguredResponse(config.missing);
}

// The cookie's VALUE is checked, not just its presence (2026-09-26): a
// presence check let anyone who typed the cookie into their browser read
// drafts through the server's token. isStudioPreview compares it with the
// fingerprint /api/draft-mode/enable writes (src/lib/preview-auth.ts).
let draftMode = await isStudioPreview(Astro.cookies.get(perspectiveCookieName)?.value);

// LOCAL DEVELOPMENT ONLY: `?dev-draft=1` turns draft mode on without the
// Studio's cookie, so an agent or a developer can render a page exactly as the
// canvas does (drafts, stega, the overlay) against `astro dev` and the token in
// .dev.vars, and screenshot it. `import.meta.env.DEV` is the literal `false` in
// a production build, so the whole block is removed from the bundle;
// scripts/check-preview-bypass.mjs fails the build job if it ever is not.
if (import.meta.env.DEV) {
  if (Astro.url.searchParams.get('dev-draft') === '1') draftMode = true;
}

// Never let a browser cache a preview page (2026-08-28). Draft content is
// per-cookie, and a cached page kept serving the previous deploy's islands.
Astro.response.headers.set('Cache-Control', 'no-store');
const slug = (Astro.params.slug as string | undefined) || '';

interface PreviewPage {
  /** The page singleton (or collection type) the page shows. */
  type: string;
  /** The page file, rendered as a component (null: the 404, drawn by NotFoundBody). */
  component: ((props: { preview: unknown }) => unknown) | null;
  /** Its loader, run against drafts. */
  load: (fetch: Fetcher) => Promise<unknown>;
}

/**
 * One entry per previewable page: the page singleton it shows, the page file
 * and that file's loader. Category pages (/<slug>) are matched by document
 * below.
 *
 * Mirror of SINGLETON_PREVIEW_PATHS in src/sanity/resolve.ts and
 * FIRST_SEGMENT_PREVIEWABLE in src/layouts/PreviewLayout.astro.
 */
const PREVIEW_PAGES: Record<string, PreviewPage> = {
  '': { type: 'homePage', component: HomePage, load: (f) => loadHome(f) },
  'how-it-works': {
    type: 'howItWorksPage',
    component: HowItWorksPage,
    load: (f) => loadHowItWorks(f),
  },
  pricing: { type: 'pricingPage', component: PricingPage, load: (f) => loadPricing(f) },
  about: { type: 'aboutPage', component: AboutPage, load: (f) => loadAbout(f) },
  'request-a-quote': {
    type: 'requestAQuotePage',
    component: RequestQuotePage,
    load: (f) => loadRequestQuote(f),
  },
  'shop-by-item': {
    type: 'shopIndexPage',
    component: ShopByItemPage,
    load: (f) => loadShopByItem(f),
  },
  'style-gallery': {
    type: 'styleGalleryPage',
    component: StyleGalleryPage,
    load: (f) => loadStyleGallery(f),
  },
  'font-lettering-guide': {
    type: 'fontGuidePage',
    component: FontGuidePage,
    load: (f) => loadFontGuide(f),
  },
  'thread-color-chart': {
    type: 'threadChartPage',
    component: ThreadChartPage,
    load: (f) => loadThreadChart(f),
  },
  clearance: { type: 'clearancePage', component: ClearancePage, load: (f) => loadClearance(f) },
  'thank-you': { type: 'thankYouPage', component: ThankYouPage, load: (f) => loadThankYou(f) },
  // The 404 is the one page drawn by a body component (see src/pages/404.astro
  // for why), so it gets its shell here rather than from the page file.
  '404': { type: 'notFoundPage', component: null, load: (f) => loadNotFound(f) },
};

const draftFetch = <T,>(query: string, params: Record<string, unknown> = {}) =>
  previewFetch<T>(draftMode, query, params);
const fetcher = previewFetcher(draftFetch);

// The category slugs: a category page previews at /preview/<slug>, and the
// click interceptor keeps a category card's click inside the canvas.
const categorySlugs: string[] =
  (await draftFetch<string[]>(
    `*[_type == "itemCategory" && defined(slug.current)].slug.current`,
  ).catch((): string[] => [])) ?? [];

let entry: PreviewPage | undefined = PREVIEW_PAGES[slug];
let docId: string | null = null;
if (!entry && categorySlugs.includes(slug)) {
  entry = { type: 'itemCategory', component: CategoryPage, load: (f) => loadCategory(slug, f) };
  docId = await draftFetch<string | null>(
    `*[_type == "itemCategory" && slug.current == $slug][0]._id`,
    { slug },
  );
}
if (!entry) {
  return new Response(
    `"${slug}" is not a previewable page. Previewable: ${[
      ...Object.keys(PREVIEW_PAGES),
      ...categorySlugs,
    ]
      .map((s) => `/preview/${s}`)
      .join(', ')}`,
    { status: 404 },
  );
}

// The doc id the overlay and /preview/live listen on. The draft perspective can
// return the drafts. twin's id; strip the prefix so the listen filter matches
// both twins. A page that has never been created still renders (the page's own
// fallbacks, exactly as the live page would), under the singleton's id.
docId ??= await draftFetch<string | null>(`*[_type == $type][0]._id`, { type: entry.type });
const pageId = (docId ?? entry.type).replace(/^drafts\./, '');

// Photo and list click targets (src/lib/edit-target.ts). Passed regardless of
// draftMode: the attribute is inert without the Studio's overlay, this route is
// noindex and never part of the static build, and a preview opened before the
// cookie lands would otherwise render uncontrollable items.
const edit: EditDoc = { id: pageId, type: entry.type };

const [data, siteSettings] = await Promise.all([
  entry.load(fetcher),
  draftFetch<any>(`*[_type == "siteSettings"][0]${SITE_SETTINGS_PROJECTION}`).catch(() => null),
]);

const Page = entry.component as any;
const preview = {
  data,
  siteSettings,
  edit,
  layout: PreviewLayout,
  layoutProps: {
    draftMode,
    pageId,
    livePath: slug ? `/${slug}` : '/',
    categorySlugs,
  },
};
---

{
  Page ? (
    <Page {preview} />
  ) : (
    <PreviewLayout title="Page Not Found" thread={false} {...preview.layoutProps}>
      <NotFoundBody {...(data as any)} edit={edit} />
    </PreviewLayout>
  )
}
