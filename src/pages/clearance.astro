---
// Clearance (Direction D, "The Atelier", 2026-10-04): a Midnight opening band
// with the payment and pickup notes hung beside the headline as hang tags,
// then the clearance pieces on linen as swatch cards, each with a kraft price
// tag strung from its corner. When the rail is empty (the usual state), an
// empty hoop with a half-sewn heart and the empty-state message on a tag.
// No cart, no checkout code: the buy button is a plain <a href> to the
// item's Stripe Payment Link (CLAUDE.md, "Clearance items").
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScriptKicker from '@/components/ScriptKicker.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaBanner from '@/components/CtaBanner.astro';
import HangTag from '@/components/motifs/HangTag.astro';
import HoopFrame from '@/components/motifs/HoopFrame.astro';
import SwatchCard from '@/components/motifs/SwatchCard.astro';
import EmptyHoopOrnament from '@/components/gallery/EmptyHoopOrnament.astro';
import { splitSwash } from '@/components/gallery/swash';
import { getSiteSettings } from '@/lib/queries';
import { editOther } from '@/lib/edit-target';
import { loadClearance, type PageProps, type ClearanceData } from '@/lib/page-data';

// THE STUDIO'S CANVAS RENDERS THIS FILE TOO (2026-10-05, "Edit on the page").
// src/pages/preview/[...slug].astro imports this page and passes `preview`:
// draft data (stega on), the page document for photo and list click targets,
// and PreviewLayout to draw it in. On the live site `preview` is absent, so the
// page loads its published data and wears BaseLayout exactly as before
// (`npm run parity compare` is the gate). One file, one markup: the canvas
// cannot drift from the site.
const { preview } = Astro.props as PageProps<ClearanceData>;
const [siteSettings, data] = preview
  ? [preview.siteSettings, preview.data]
  : await Promise.all([getSiteSettings(), loadClearance()]);
const { page, items } = data;
const edit = preview?.edit;
const Layout = (preview?.layout ?? BaseLayout) as typeof BaseLayout;

const title = page?.seoTitle ?? 'Clearance — MAS Monograms';
const description =
  page?.seoDescription ??
  'Shop pre-made clearance embroidery items at reduced prices. Ready to ship, no custom order wait time.';

const inStockItems = items.filter((item: any) => !item.sold);
const soldOutItems = items.filter((item: any) => item.sold);
const buyLabel = page?.buyButtonLabel ?? 'Buy Now';
const soldLabel = page?.soldOutLabel ?? 'Sold Out';
// clearancePage.quantityLeftLabel, e.g. "{count} left"; blank hides the line.
const leftLabel: string | undefined = page?.quantityLeftLabel || undefined;
const headline = splitSwash(page?.heroHeadline ?? 'Clearance');
const hasNotes = !!(page?.paymentNote || page?.pickupNote);

const money = (v: unknown) =>
  v === null || v === undefined || v === ''
    ? null
    : `$${typeof v === 'number' ? v.toFixed(2) : String(v)}`;

const TONES = ['paper', 'linen', 'blush', 'sage'] as const;
const TILTS = [-1.2, 1, -0.6, 1.4];
---

<Layout {title} {description} seoImage={page?.seoImage} {siteSettings} {...preview?.layoutProps}>
  <section class="clr-intro surface-midnight py-section-lg" aria-labelledby="clearance-heading">
    <div
      class:list={[
        'gap-xl mx-auto grid max-w-content grid-cols-1 items-center px-m',
        hasNotes && 'lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]',
      ]}
    >
      <div>
        {
          page?.heroEyebrow && (
            <div data-reveal="fade">
              <ScriptKicker text={page.heroEyebrow} onDark class="mb-s" />
            </div>
          )
        }
        <h1 id="clearance-heading" class="display-sm max-w-[14ch]" data-reveal>
          {headline.before}<em class="swash">{headline.word}</em>{headline.after}
        </h1>
        {
          page?.heroSubhead && (
            <p class="lede mt-m" data-reveal style="--reveal-delay: 120ms">
              {page.heroSubhead}
            </p>
          )
        }
      </div>
      {
        hasNotes && (
          <div class="clr-notes" data-reveal="fade" style="--reveal-delay: 160ms">
            {page?.paymentNote && (
              <HangTag tone="kraft" tilt={-4} size="sm" class="clr-notes__tag">
                <p>{page.paymentNote}</p>
              </HangTag>
            )}
            {page?.pickupNote && (
              <HangTag tone="paper" tilt={5} size="sm" class="clr-notes__tag clr-notes__tag--b">
                <p>{page.pickupNote}</p>
              </HangTag>
            )}
          </div>
        )
      }
    </div>
  </section>

  <section class="surface-linen py-section-lg">
    <div class="mx-auto max-w-content px-m">
      {
        page?.intro && (
          <div class="mx-auto mb-l max-w-[52ch]">
            <PortableText value={page.intro} />
          </div>
        )
      }
      {
        items.length === 0 ? (
          <div class="clr-empty">
            <div class="clr-empty__hoop" aria-hidden="true">
              <HoopFrame image={null} size={300} tilt={-3} />
              <EmptyHoopOrnament class="clr-empty__ornament" />
            </div>
            <div class="clr-empty__text">
              <p class="clr-empty__msg">
                {page?.emptyStateMessage ??
                  'No clearance items available at this time. Check back soon!'}
              </p>
              <div class="mt-l flex flex-col items-start gap-m sm:flex-row sm:items-center">
                <a href={page?.emptyStateCtaHref ?? '/request-a-quote'} class="btn btn-primary">
                  {page?.emptyStateCtaLabel ?? 'Request a custom quote'}
                </a>
                {(page?.emptyStateSecondaryLabel ?? 'Browse what I make') && (
                  <a
                    href={page?.emptyStateSecondaryHref ?? '/shop-by-item'}
                    class="link-stitch hit-44 relative text-sm font-semibold"
                  >
                    {page?.emptyStateSecondaryLabel ?? 'Browse what I make'}{' '}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ) : (
          <ul class="clr-grid" role="list" data-reveal-stagger="90">
            {[...inStockItems, ...soldOutItems].map((item: any, i: number) => {
              const isSold = item.sold;
              const primaryImage = item.images?.[0];
              const sale = money(item.salePrice);
              const original = money(item.originalPrice);
              return (
                <li
                  class:list={['clr-item', isSold && 'clr-item--sold']}
                  data-reveal
                  data-sanity={editOther(edit, item._id, 'clearanceItem', 'images')}
                >
                  <SwatchCard
                    as="article"
                    tone={TONES[i % TONES.length]}
                    tilt={TILTS[i % TILTS.length]}
                    interactive={!isSold}
                    bodyClass="clr-item__body"
                  >
                    <div slot="media" class="clr-item__media">
                      {primaryImage?.asset ? (
                        <SanityImage
                          source={primaryImage}
                          width={600}
                          height={450}
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                          class="clr-item__img"
                        />
                      ) : (
                        <div class="clr-item__nophoto texture-linen" aria-hidden="true">
                          <EmptyHoopOrnament class="clr-item__nophoto-orn" />
                        </div>
                      )}
                      {isSold && (
                        <span class="clr-item__stamp">
                          <span>{soldLabel}</span>
                        </span>
                      )}
                    </div>
                    <h2 class="font-display text-h4 text-foreground">{item.name}</h2>
                    {item.description && (
                      <p class="mt-xs line-clamp-3 text-sm text-[var(--color-text-secondary)]">
                        {item.description}
                      </p>
                    )}
                    {leftLabel && item.quantityAvailable && !isSold && (
                      <p class="mt-xs text-xs font-semibold tracking-eyebrow text-[var(--color-text-secondary)] uppercase">
                        {leftLabel.replaceAll('{count}', String(item.quantityAvailable))}
                      </p>
                    )}
                    {/* Buy button — Stripe Payment Link, no cart needed */}
                    {!isSold && item.stripePaymentLink && (
                      <a
                        href={item.stripePaymentLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary mt-m w-full"
                      >
                        {buyLabel}
                      </a>
                    )}
                  </SwatchCard>
                  {sale && (
                    <HangTag
                      size="sm"
                      tone="kraft"
                      tilt={i % 2 ? 7 : -6}
                      value={sale}
                      class="clr-item__price"
                    >
                      {original && (
                        <p class="clr-item__was">
                          <s>{original}</s>
                        </p>
                      )}
                    </HangTag>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    swash={page?.ctaHeadline ? splitSwash(page.ctaHeadline).word : undefined}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
</Layout>

<style>
  /* The two notes hang off the band like tags on a rail. */
  .clr-notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .clr-notes :global(.clr-notes__tag) {
    width: min(15rem, 100%);
  }
  .clr-notes :global(.clr-notes__tag--b) {
    margin-top: 2.5rem;
  }
  .clr-notes :global(.hangtag__extra) {
    text-align: center;
    font-size: var(--text-compact);
    color: var(--color-text-secondary);
  }

  /* Empty state: the hoop on the wall, the message beside it. */
  .clr-empty {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    gap: 2.5rem;
    max-width: 56rem;
    margin: 0 auto;
    padding-block: 1rem;
  }
  @media (min-width: 768px) {
    .clr-empty {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      gap: 4rem;
    }
  }
  .clr-empty__hoop {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(300px, 80vw);
  }
  .clr-empty__hoop :global(.clr-empty__ornament) {
    position: absolute;
    left: 50%;
    top: 0;
    width: 62%;
    aspect-ratio: 1;
    translate: -50% 0;
    margin-top: 24%;
  }
  .clr-empty__msg {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.15rem);
    line-height: 1.3;
    font-weight: 360;
    color: var(--foreground);
    max-width: 24ch;
    text-wrap: pretty;
  }

  /* Items: swatch cards, each with a kraft price tag strung from its corner. */
  .clr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 3.5rem 2rem;
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
  }
  .clr-item {
    position: relative;
  }
  .clr-item :global(.clr-item__body) {
    padding: 1.25rem 1.5rem 1.6rem;
  }
  .clr-item__media {
    position: relative;
  }
  .clr-item__media :global(.clr-item__img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .clr-item__nophoto {
    position: relative;
    aspect-ratio: 4 / 3;
  }
  .clr-item__nophoto :global(.clr-item__nophoto-orn) {
    position: absolute;
    inset: 12% 30%;
  }
  .clr-item :global(.clr-item__price) {
    position: absolute;
    top: -2.25rem;
    right: -1.6rem;
    z-index: 2;
    width: 7.25rem;
  }
  @media (max-width: 639px) {
    .clr-item :global(.clr-item__price) {
      right: 0.5rem;
    }
  }
  .clr-item :global(.clr-item__price .hangtag__value) {
    font-size: 1.6rem;
  }
  .clr-item__was {
    text-align: center;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  /* SOLD: a claret stamp pressed over the photo; the card goes quiet. */
  .clr-item__stamp {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center start;
    padding-left: 1.5rem;
    background: rgba(244, 238, 227, 0.55);
  }
  .clr-item__stamp span {
    padding: 0.4rem 1.2rem;
    border: 3px double var(--color-rust-cta, #8c3a2e);
    border-radius: 4px;
    background: rgba(251, 248, 241, 0.92);
    color: var(--color-rust-cta, #8c3a2e);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.6rem;
    letter-spacing: 0.04em;
    transform: rotate(-10deg);
  }
  .clr-item--sold :global(.swatch) {
    filter: saturate(0.6) drop-shadow(0 10px 10px rgba(15, 27, 45, 0.12));
  }
</style>
