---
// /thread-color-chart (Direction D, 2026-10-04): the spool rack IS the page.
// A Midnight intro, then every threadColor as a wooden spool on a shelf in hue
// order, beside one live AtelierStage that restitches the sample monogram in
// the chosen thread on the chosen cloth. Strings: threadChartPage +
// atelierSettings (Sanity). Rendering logic (hue sort, fabric -> weave) lives
// in src/components/thread/threadData.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PortableText from '@/components/PortableText';
import CtaBanner from '@/components/CtaBanner.astro';
import Spool from '@/components/motifs/Spool.astro';
import SpoolRack from '@/components/thread/SpoolRack.astro';
import StitchPanel from '@/components/thread/StitchPanel.astro';
import ThreadChartScript from '@/components/thread/ThreadChartScript.astro';
import {
  normHex,
  sortThreads,
  textureForFabric,
  rgbDistance,
  cleanInitials,
} from '@/components/thread/threadData';
import { getSiteSettings } from '@/lib/queries';
import { takeRun } from '@/lib/stega-text';
import { loadThreadChart, type PageProps, type ThreadChartData } from '@/lib/page-data';

// THE STUDIO'S CANVAS RENDERS THIS FILE TOO (2026-10-05, "Edit on the page").
// src/pages/preview/[...slug].astro imports this page and passes `preview`:
// draft data (stega on), the page document for photo and list click targets,
// and PreviewLayout to draw it in. On the live site `preview` is absent, so the
// page loads its published data and wears BaseLayout exactly as before
// (`npm run parity compare` is the gate). One file, one markup: the canvas
// cannot drift from the site.
const { preview } = Astro.props as PageProps<ThreadChartData>;
const [siteSettings, data] = preview
  ? [preview.siteSettings, preview.data]
  : await Promise.all([getSiteSettings(), loadThreadChart()]);
const { page, colors, atelier } = data;
// (No `edit` here: the colours are thread documents, edited by clicking their names.)
const Layout = (preview?.layout ?? BaseLayout) as typeof BaseLayout;

const title = page?.seoTitle ?? 'Thread Color Chart | MAS Monograms';
const description =
  page?.seoDescription ??
  'Browse the thread colors MAS Monograms stitches with, and see each one stitched live on fabric.';

// Spools need a real colour; a thread without a hex has nothing to show here.
const rack = sortThreads(
  (colors ?? [])
    .map((c: any) => ({ ...c, hex: normHex(c.hexColor) ?? '' }))
    .filter((c: any) => c.hex && c.slug && c.name),
) as Array<any>;

// Default thread: the one closest to the brand Claret, so the first stitch
// already looks like MAS.
const first = rack.length
  ? rack.reduce((best, c) =>
      rgbDistance(c.hex, '#8c3a2e') < rgbDistance(best.hex, '#8c3a2e') ? c : best,
    )
  : null;

const fabrics = (atelier?.fabrics ?? [])
  .map((f) => ({
    key: f.key,
    label: f.label,
    color: normHex(f.color) ?? '',
    texture: textureForFabric(f.key),
    note: f.note ?? null,
  }))
  .filter((f) => f.key && f.label && f.color);

const initials = cleanInitials(atelier?.sampleMonograms?.[0] ?? '') || 'MAS';

// Headline swash: the last word in the gold italic.
const headline: string = page?.heroHeadline ?? 'Thread Color Chart';
// Stega-safe: in the Studio's canvas the click-to-edit marker is taken off
// before the split and put back on the swash word (src/lib/stega-text.ts).
const { text: hText, run: hRun } = takeRun(headline);
const hWords = hText.trim().split(/\s+/);
const hLast = (hWords.pop() ?? '') + hRun;
const hLead = hWords.join(' ');

// A few spools for the intro, spread across the rack's hue order.
const heroSpools = rack.length
  ? [0.05, 0.3, 0.55, 0.8, 0.97].map(
      (p) => rack[Math.min(rack.length - 1, Math.floor(p * rack.length))],
    )
  : [];
---

<Layout
  {title}
  {description}
  seoImage={page?.seoImage}
  {siteSettings}
  header="overlay"
  {...preview?.layoutProps}
>
  {/* Midnight intro */}
  <section
    class="surface-midnight pt-header overflow-hidden pb-section-lg"
    aria-labelledby="chart-title"
  >
    <div
      class="mx-auto grid max-w-content grid-cols-[minmax(0,1fr)] items-end gap-l px-m lg:grid-cols-[1.25fr_1fr]"
    >
      <div data-reveal>
        {page?.heroEyebrow && <p class="eyebrow mb-m">{page.heroEyebrow}</p>}
        <h1 id="chart-title" class="display-sm mb-l">
          {hLead && <>{hLead} </>}<em class="swash">{hLast}</em>
        </h1>
        {page?.heroSubhead && <p class="lede">{page.heroSubhead}</p>}
      </div>
      {
        heroSpools.length > 0 && (
          <div class="chart-hero__spools" aria-hidden="true" data-reveal="fade">
            {heroSpools.map((c, i) => (
              <Spool
                color={c.hex}
                size={i === 2 ? 128 : i % 2 ? 92 : 104}
                tilt={[-8, 5, -2, 7, -5][i]}
              />
            ))}
            <span class="chart-hero__shelf" />
          </div>
        )
      }
    </div>
  </section>

  {/* The rack and the live stitch */}
  <section class="surface-linen py-section-lg">
    <div class="mx-auto max-w-content px-m">
      {
        page?.intro && (
          <div class="chart-intro mb-section-md" data-reveal>
            <h2 id="rack-title" class="sr-only">
              {atelier?.threadLabel ?? page?.heroEyebrow ?? headline}
            </h2>
            <PortableText value={page.intro} />
          </div>
        )
      }
      {
        !page?.intro && (
          <h2 id="rack-title" class="sr-only">
            {atelier?.threadLabel ?? page?.heroEyebrow ?? headline}
          </h2>
        )
      }

      {
        rack.length > 0 && first ? (
          <div class="chart-grid">
            <StitchPanel
              initials={initials}
              thread={{ slug: first.slug, name: first.name, hex: first.hex }}
              fabrics={fabrics}
              threadLabel={atelier?.threadLabel ?? 'Thread'}
              fabricLabel={atelier?.fabricLabel}
              initialsLabel={atelier?.initialsLabel}
              initialsHint={atelier?.initialsHint}
              replayLabel={atelier?.replayLabel}
              ctaLabel={atelier?.ctaLabel ?? page?.ctaLabel}
              disclaimer={atelier?.disclaimer}
              quoteHref="/request-a-quote"
            />
            <div class="chart-grid__rack">
              <SpoolRack
                colors={rack}
                selected={first.slug}
                legend={atelier?.threadLabel ?? 'Thread'}
                filterLabel={page?.filterLabel ?? 'Search colors'}
                emptyNote={page?.customColorNote ?? page?.matchingNote}
              />
              {page?.matchingNote && (
                <p class="chart-note">
                  <span class="chart-note__mark" aria-hidden="true">
                    +
                  </span>
                  {page.matchingNote}
                </p>
              )}
            </div>
          </div>
        ) : (
          page?.matchingNote && <p class="chart-note">{page.matchingNote}</p>
        )
      }
    </div>
  </section>

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
</Layout>
<ThreadChartScript />

<style>
  .chart-hero__spools {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.25rem;
    padding: 0 1rem 1.1rem;
  }
  .chart-hero__spools :global(.spool) {
    width: auto;
    min-width: 0;
  }
  @media (max-width: 40rem) {
    .chart-hero__spools :global(.spool__art) {
      width: 17vw;
      height: auto;
    }
  }
  .chart-hero__shelf {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 0.85rem;
    border-radius: 2px;
    background:
      linear-gradient(180deg, var(--color-wood-edge) 0 2px, transparent 2px), var(--wood-shelf);
    box-shadow: 0 16px 22px -10px rgb(0 0 0 / 0.6);
    z-index: -1;
  }
  .chart-intro {
    /* a reading measure, not a box width: 46rem ran ~97 characters a line and 65ch
       still ~88 (Mulish's 0, which ch measures, is wide); 52ch is about 70 characters */
    max-width: 52ch;
    font-size: var(--text-reading);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .chart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .chart-grid {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 25rem);
      gap: 3rem;
    }
    /* panel is first in the DOM (it is what the choices change); it sits on
       the right so the rack leads the eye */
    .chart-grid > :global([data-stitch-panel]) {
      grid-column: 2;
      grid-row: 1;
    }
    .chart-grid__rack {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .chart-note {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    max-width: 46rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .chart-note__mark {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: #8c3a2e;
  }
</style>
