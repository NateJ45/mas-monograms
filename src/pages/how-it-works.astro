---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScriptKicker from '@/components/ScriptKicker.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import FaqAccordion from '@/components/FaqAccordion';
import CtaBanner from '@/components/CtaBanner.astro';
import { faqPageSchema } from '@/lib/schemas';
import { getSiteSettings, getHowItWorksPage, getFaqItemsForHowItWorks } from '@/lib/queries';

const [siteSettings, page, faqs] = await Promise.all([
  getSiteSettings(),
  getHowItWorksPage(),
  getFaqItemsForHowItWorks(),
]);

const title = page?.seoTitle ?? 'How It Works — MAS Monograms';
const description =
  page?.seoDescription ??
  'See exactly how the MAS Monograms process works, from placing your request to receiving your finished embroidered items.';

// FAQPage rich-result schema — only emit when there are FAQs to describe.
const pageSchemas = faqs.length > 0 ? [faqPageSchema(faqs)] : [];
---

<BaseLayout {title} {description} seoImage={page?.seoImage} {siteSettings} schemas={pageSchemas}>
  {/* Hero */}
  <section class="bg-tertiary py-section-lg">
    <div class="mx-auto max-w-content px-m text-center">
      {page?.heroEyebrow && <ScriptKicker text={page.heroEyebrow} class="mb-xs" />}
      <h1 class="mb-m font-display text-h1 leading-headline-tight text-foreground">
        {page?.heroHeadline ?? 'How It Works'}
      </h1>
      {
        page?.heroSubhead && (
          <p class="mx-auto max-w-2xl text-[var(--color-text-secondary)]">{page.heroSubhead}</p>
        )
      }
    </div>
  </section>

  {/* Process Steps */}
  <section class="py-section-lg">
    <div class="mx-auto max-w-content px-m">
      {
        page?.stepsHeadline && (
          <h2 class="mb-l text-center font-display text-h2 text-foreground">
            {page.stepsHeadline}
          </h2>
        )
      }
      {
        (page?.steps ?? []).length > 0 && (
          <ol class="space-y-section-md">
            {(page.steps as any[]).map((step: any, i: number) => (
              <li class="grid grid-cols-1 items-start gap-l md:grid-cols-[auto_1fr]">
                <div class="flex items-center gap-m md:flex-col md:items-center md:gap-s">
                  <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary font-display text-h4 text-white">
                    {step.number ?? i + 1}
                  </span>
                  {i < (page.steps as any[]).length - 1 && (
                    <div
                      class="step-connector hidden min-h-[3rem] w-px flex-1 md:block"
                      aria-hidden="true"
                    />
                  )}
                </div>
                <div class="pb-l">
                  <h3 class="mb-s font-display text-h3 text-foreground">{step.label}</h3>
                  {step.body && (
                    <div class="prose prose-sm max-w-none text-[var(--color-text-secondary)]">
                      <PortableText client:visible value={step.body} />
                    </div>
                  )}
                  {step.image?.asset && (
                    <div class="mt-m overflow-hidden rounded-xl">
                      <SanityImage
                        source={step.image}
                        width={800}
                        sizes="(max-width: 768px) 100vw, 800px"
                        class="h-auto w-full object-cover"
                      />
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  {/* FAQ */}
  {
    faqs.length > 0 && (
      <section class="bg-tertiary py-section-lg">
        <div class="mx-auto max-w-content px-m">
          {page?.faqHeadline && (
            <h2 class="mb-s text-center font-display text-h2 text-foreground">
              {page.faqHeadline}
            </h2>
          )}
          {page?.faqSubhead && (
            <p class="mb-l text-center text-[var(--color-text-secondary)]">{page.faqSubhead}</p>
          )}
          <div>
            <FaqAccordion client:visible faqs={faqs} idPrefix="hiw-faq" />
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
</BaseLayout>
