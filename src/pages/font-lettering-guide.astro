---
// /font-lettering-guide (Direction D, "The Atelier", 2026-10-04).
// Midnight intro; Mary Ann's note on Paper; then the specimen drawers on
// Linen: one row per style (Sanity font.styleTag), each specimen a pinked
// swatch card carrying the real stitched sample (font.previewImage). The
// custom-font note hangs on a kraft tag; the CTA closes. Copy is Sanity
// (fontGuidePage + font). A font with an atelierStyle (the closest live-preview
// style, picked in the Studio) gets a "try it" link to /?style=<key>#atelier,
// which AtelierStudioScript reads to preselect that style. The link text is
// fontGuidePage.tryItLabel; no label, no links.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaBanner from '@/components/CtaBanner.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SwatchCard from '@/components/motifs/SwatchCard.astro';
import HangTag from '@/components/motifs/HangTag.astro';
import { getSiteSettings, getFontGuidePage, getAllFonts } from '@/lib/queries';

const [siteSettings, page, allFonts] = await Promise.all([
  getSiteSettings(),
  getFontGuidePage(),
  getAllFonts(),
]);

// Only show fonts that have a real specimen photo — no "coming soon" placeholders.
const fonts = (allFonts ?? []).filter((f: any) => f.previewImage?.asset);

const title = page?.seoTitle ?? 'Font & Lettering Guide — MAS Monograms';
const description =
  page?.seoDescription ??
  'Browse all embroidery fonts and lettering styles available at MAS Monograms. See preview photos of each font on actual embroidered fabric.';

// Group fonts by styleTag
const styleGroups = fonts.reduce(
  (acc: Record<string, any[]>, font: any) => {
    const key = font.styleTag ?? 'Other';
    if (!acc[key]) acc[key] = [];
    acc[key].push(font);
    return acc;
  },
  {} as Record<string, any[]>,
);

// Rendering logic only: the swash falls on a phrase already in the headline.
const pickSwash = (text: string | undefined, candidates: string[]) =>
  candidates.find((c) => text?.includes(c));
const heroHeadline = page?.heroHeadline ?? 'Font & Lettering Guide';
const heroSwash = pickSwash(heroHeadline, ['lettering style', 'lettering', 'style']);
const hi = heroSwash ? heroHeadline.indexOf(heroSwash) : -1;
const TILTS = [-1.5, 1.2, -0.8, 1.6, -1.2, 0.8];
const TONES = ['paper', 'linen', 'paper', 'blush', 'paper', 'sage'] as const;
let n = 0;
const ATELIER_STYLES = new Set(['classic', 'script', 'block', 'circle', 'single']);
const tryItLabel: string | undefined = page?.tryItLabel || undefined;
const popularLabel: string | undefined = page?.popularLabel || undefined;
const slugId = (font: any) => `font-${font.slug?.current ?? font._id}`;
---

<BaseLayout {title} {description} seoImage={page?.seoImage} {siteSettings}>
  {/* Intro */}
  <section class="surface-midnight py-section-lg" aria-labelledby="fonts-heading">
    <div class="mx-auto max-w-content px-m text-center">
      {
        page?.heroEyebrow && (
          <p class="eyebrow eyebrow--center mb-m justify-center" data-reveal="fade">
            {page.heroEyebrow}
          </p>
        )
      }
      <h1 id="fonts-heading" class="display mx-auto max-w-5xl" data-reveal>
        {hi >= 0 ? heroHeadline.slice(0, hi) : heroHeadline}
        {heroSwash && <em class="swash">{heroSwash}</em>}
        {hi >= 0 ? heroHeadline.slice(hi + (heroSwash?.length ?? 0)) : ''}
      </h1>
      {
        page?.heroSubhead && (
          <p
            class="lede mx-auto mt-l max-w-[48ch] text-center"
            data-reveal
            style="--reveal-delay: 120ms"
          >
            {page.heroSubhead}
          </p>
        )
      }
    </div>
  </section>

  {/* Mary Ann's note */}
  {
    page?.intro && (
      <section class="surface-paper py-section-md">
        <div class="fonts-intro mx-auto max-w-[44rem] px-m" data-reveal>
          <PortableText value={page.intro} />
        </div>
      </section>
    )
  }

  {/* The specimen drawers */}
  <section class="surface-linen py-section-lg" aria-labelledby="font-grid-heading">
    <div class="mx-auto max-w-content px-m">
      <SectionHeading
        headingId="font-grid-heading"
        eyebrow={page?.fontGridEyebrow ?? undefined}
        headline={page?.fontGridHeadline ?? undefined}
        swash={pickSwash(page?.fontGridHeadline, ['fonts'])}
        size="lg"
        align="center"
      />

      {
        fonts.length > 0 ? (
          <div class="drawers mt-section-md">
            {Object.entries(styleGroups).map(([style, styleFonts]) => (
              <div class="drawer">
                <h3 class="drawer__label">
                  <span>{style}</span>
                  <span class="drawer__count" aria-hidden="true">
                    {String((styleFonts as any[]).length).padStart(2, '0')}
                  </span>
                </h3>
                <ul class="drawer__cards" role="list" data-reveal-stagger="80">
                  {(styleFonts as any[]).map((font: any) => {
                    const i = n++;
                    return (
                      <li data-style-tag={font.styleTag ?? undefined}>
                        <SwatchCard
                          tone={TONES[i % TONES.length]}
                          tilt={TILTS[i % TILTS.length]}
                          interactive
                          class="specimen"
                          bodyClass="specimen__body"
                        >
                          <SanityImage
                            slot="media"
                            source={font.previewImage}
                            width={480}
                            sizes="(max-width: 640px) 80vw, 15rem"
                            class="specimen__img"
                          />
                          <p class="specimen__name" id={slugId(font)}>
                            {font.name}
                          </p>
                          {font.popular && popularLabel && (
                            <p class="specimen__flag">{popularLabel}</p>
                          )}
                          {font.bestFor && <p class="specimen__best">{font.bestFor}</p>}
                          {tryItLabel && ATELIER_STYLES.has(font.atelierStyle) && (
                            <a
                              href={`/?style=${font.atelierStyle}#atelier`}
                              class="specimen__try link-stitch hit-44 relative"
                              aria-describedby={slugId(font)}
                            >
                              {tryItLabel} <span aria-hidden="true">&rarr;</span>
                            </a>
                          )}
                        </SwatchCard>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p class="py-l text-center text-[var(--color-text-secondary)]">Font guide coming soon.</p>
        )
      }

      {
        page?.customFontNote && (
          <div class="mt-section-md flex justify-center" data-reveal>
            <HangTag tone="kraft" tilt={-2} class="custom-note">
              <p>{page.customFontNote}</p>
            </HangTag>
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    swash={pickSwash(page?.ctaHeadline, ['something', 'put it'])}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
</BaseLayout>

<style>
  .fonts-intro :global(p) {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: 360;
    line-height: 1.55;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .fonts-intro :global(p + p) {
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Style drawers flow side by side and wrap: a drawer is as wide as its
     specimens, so one-card styles sit beside the bigger ones instead of
     stranding a card in an empty row. */
  .drawers {
    --card: 14rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
    max-width: 76rem;
    margin-inline: auto;
  }
  .drawer {
    flex: 0 1 auto;
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }
  .drawer__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px dashed var(--stitch-color);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 360;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem);
    line-height: 1;
    color: var(--foreground);
    text-transform: capitalize;
  }
  .drawer__count {
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-brass-text);
  }
  .drawer__cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--card);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    list-style: none;
    padding: 0;
  }
  @media (max-width: 40rem) {
    .drawer {
      flex-basis: 100%;
    }
    .drawer__cards {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
    }
    .drawer__cards :global(.specimen__name) {
      font-size: var(--text-lead-sm);
    }
  }
  .drawer__cards :global(.specimen__img) {
    aspect-ratio: 1;
    object-fit: contain;
    background-color: var(--color-white-pure);
  }
  .drawer__cards :global(.specimen__body) {
    padding-block: 1rem 1.15rem;
    text-align: center;
  }
  .drawer__cards :global(.specimen__name) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 440;
    line-height: 1.2;
    color: var(--foreground);
  }
  .drawer__cards :global(.specimen__flag) {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.15rem 0.6rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rust-cta);
    outline: 1px dashed currentColor;
    outline-offset: 1px;
  }
  .drawer__cards :global(.specimen__try) {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .drawer__cards :global(.specimen__best) {
    margin-top: 0.4rem;
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-text-secondary);
  }
  :global(.custom-note) {
    --tag-w: 22rem;
  }
  :global(.custom-note .hangtag__extra) {
    margin-top: 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lead-sm);
    line-height: 1.45;
    color: var(--foreground);
  }
</style>
