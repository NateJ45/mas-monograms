---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScriptKicker from '@/components/ScriptKicker.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import CtaBanner from '@/components/CtaBanner.astro';
import { getSiteSettings, getFontGuidePage, getAllFonts } from '@/lib/queries';

const [siteSettings, page, allFonts] = await Promise.all([
  getSiteSettings(),
  getFontGuidePage(),
  getAllFonts(),
]);

// Only show fonts that have a real specimen photo — no "coming soon" placeholders.
const fonts = (allFonts ?? []).filter((f: any) => f.previewImage?.asset);

const title = page?.seoTitle ?? 'Font & Lettering Guide — MAS Monograms';
const description =
  page?.seoDescription ??
  'Browse all embroidery fonts and lettering styles available at MAS Monograms. See preview photos of each font on actual embroidered fabric.';

// Group fonts by styleTag
const styleGroups = fonts.reduce(
  (acc: Record<string, any[]>, font: any) => {
    const key = font.styleTag ?? 'Other';
    if (!acc[key]) acc[key] = [];
    acc[key].push(font);
    return acc;
  },
  {} as Record<string, any[]>,
);
---

<BaseLayout {title} {description} seoImage={page?.seoImage} {siteSettings}>
  {/* Hero */}
  <section class="bg-tertiary py-section-lg">
    <div class="mx-auto max-w-content px-m text-center">
      {page?.heroEyebrow && <ScriptKicker text={page.heroEyebrow} class="mb-xs" />}
      <h1 class="mb-m font-display text-h1 leading-headline-tight text-foreground">
        {page?.heroHeadline ?? 'Font & Lettering Guide'}
      </h1>
      {
        page?.heroSubhead && (
          <p class="mx-auto max-w-2xl text-[var(--color-text-secondary)]">{page.heroSubhead}</p>
        )
      }
    </div>
  </section>

  {/* Intro */}
  {
    page?.intro && (
      <section class="py-section-md">
        <div class="mx-auto max-w-3xl px-m">
          <PortableText client:idle value={page.intro} />
        </div>
      </section>
    )
  }

  {/* Font Grid */}
  <section class="py-section-lg">
    <div class="mx-auto max-w-content px-m">
      {
        page?.fontGridEyebrow && (
          <p class="mb-s text-center text-xs tracking-eyebrow text-link uppercase">
            {page.fontGridEyebrow}
          </p>
        )
      }
      {
        page?.fontGridHeadline && (
          <h2 class="mb-l text-center font-display text-h2 text-foreground">
            {page.fontGridHeadline}
          </h2>
        )
      }

      {
        fonts.length > 0 ? (
          Object.entries(styleGroups).map(([style, styleFonts]) => (
            <div class="mb-section-lg">
              <h3 class="mb-m border-b border-border-soft pb-s text-xs tracking-eyebrow text-[var(--color-text-secondary)] uppercase">
                {style}
              </h3>
              {/* Centered flex-wrap, not a left-anchored 5-col grid: most style
                groups hold only 1-3 specimens, and partial grid rows read as
                accidental holes. Centering the fixed-width specimen cards makes
                a sparse group look composed instead of unfinished. */}
              <div class="flex flex-wrap justify-center gap-m">
                {(styleFonts as any[]).map((font: any) => (
                  <div class="group w-[230px] max-w-full overflow-hidden rounded-xl border border-border-soft bg-card transition-shadow hover:shadow-sm">
                    <div class="aspect-square overflow-hidden">
                      <SanityImage
                        source={font.previewImage}
                        width={300}
                        height={300}
                        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                    <div class="p-s">
                      <p class="text-sm font-semibold text-foreground">{font.name}</p>
                      {font.popular && (
                        <span class="text-xs font-semibold text-primary">Popular</span>
                      )}
                      {font.bestFor && (
                        <p class="mt-xs text-xs text-[var(--color-text-secondary)]">
                          {font.bestFor}
                        </p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p class="py-l text-center text-[var(--color-text-secondary)]">Font guide coming soon.</p>
        )
      }

      {
        page?.customFontNote && (
          <div class="mt-l rounded-xl bg-tertiary p-l text-center">
            <p class="text-[var(--color-text-secondary)]">{page.customFontNote}</p>
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner
    eyebrow={page?.ctaEyebrow}
    headline={page?.ctaHeadline}
    subhead={page?.ctaSubhead}
    ctaLabel={page?.ctaLabel}
    ctaHref={page?.ctaHref}
  />
</BaseLayout>
