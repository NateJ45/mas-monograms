  .quote-card::before {
    content: '';
    position: absolute;
    inset: var(--card-stitch-inset);
    border: 1.5px dashed rgb(185 138 62 / 0.4);
    border-radius: max(0px, calc(var(--card-radius) - var(--card-stitch-inset)));
    pointer-events: none;
