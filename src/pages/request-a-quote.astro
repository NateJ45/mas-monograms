  /* The form card: paper, a fine stitched inner edge, a soft lift. */
  /* The stitch is concentric with the card edge, the same rule as .btn:
     inner radius = card radius minus the stitch inset, never below 0. */
  .quote-card {
    --card-radius: var(--radius-mount);
    --card-stitch-inset: 0.6rem;
    position: relative;
