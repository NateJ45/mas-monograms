  }
  .quote-privacy {
    margin: 0.85rem 0 0;
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
  }
  @media (prefers-reduced-motion: reduce) {
    .choice,
    .drop-zone {
      transition: none;
    }
  }
