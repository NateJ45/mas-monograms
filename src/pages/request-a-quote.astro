---
// /request-a-quote (Direction D reskin, 2026-10-04). Same fields, names, ids,
// validation, Turnstile, upload and POST /api/quote as before; the behaviour
// lives in components/quote/QuoteFormScript.astro (moved, unchanged). New:
// a Midnight intro, a paper form card with numbered sections and a sticky
// section index, and the Atelier hand-off (QuotePrefillScript + QuotePreview:
// ?initials=&style=&thread=&fabric=&item=&font= pre-fill the form and show a
// live preview of the requested monogram).
import BaseLayout from '@/layouts/BaseLayout.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableText from '@/components/PortableText';
import HangTag from '@/components/motifs/HangTag.astro';
import Spool from '@/components/motifs/Spool.astro';
import Needle from '@/components/motifs/Needle.astro';
import QuotePreview from '@/components/quote/QuotePreview.astro';
import QuoteSteps from '@/components/quote/QuoteSteps.astro';
import QuoteFormScript from '@/components/quote/QuoteFormScript.astro';
import QuotePrefillScript from '@/components/quote/QuotePrefillScript.astro';
import { normHex, textureForFabric } from '@/components/thread/threadData';
import { telHref } from '@/lib/phone';
import {
  getSiteSettings,
  getRequestAQuotePage,
  getAllItemCategories,
  getAllFonts,
  getAtelierSettings,
  getAllThreadColors,
} from '@/lib/queries';

const [siteSettings, page, itemCategories, fonts, atelier, threadColors] = await Promise.all([
  getSiteSettings(),
  getRequestAQuotePage(),
  getAllItemCategories(),
  getAllFonts(),
  getAtelierSettings(),
  getAllThreadColors(),
]);

// ── Item-type dropdown options ──────────────────────────────────────────────
// Real item categories from Sanity, followed by a low-friction "not sure"
// escape so a required field never blocks a hesitant visitor. Each option
// carries its slug (data-slug) so the ?item=<slug> deep-link can match by slug
// — the visible option value is the display name ("Hats & Caps"), which the
// slug ("hats-caps") can't be reconstructed into by humanizing alone.
const itemTypeOptions: Array<{ name: string; slug: string }> = [
  ...(itemCategories ?? [])
    .map((c: { name?: string; slug?: { current?: string } }) => ({
      name: c?.name ?? '',
      slug: c?.slug?.current ?? '',
    }))
    .filter((o: { name: string }) => Boolean(o.name)),
  { name: 'Not sure, recommend for me', slug: '' },
];

// ── Font dropdown options ───────────────────────────────────────────────────
// Real embroidery fonts from Sanity (name only), plus "Other" and a "recommend"
// escape. Kept as bare names so the ?font= deep-link param can match exactly.
const fontNames: string[] = (fonts ?? [])
  .map((f: { name?: string }) => f?.name)
  .filter((n: string | undefined): n is string => Boolean(n));
const FONT_OTHER = 'Other';
const FONT_RECOMMEND = 'Recommend for me';
const fontOptions: string[] = [...fontNames, FONT_OTHER, FONT_RECOMMEND];

// ── Fixed domain option lists ───────────────────────────────────────────────
// These are standard embroidery choices unlikely to change, so they live here
// as clearly-commented const arrays rather than in Sanity. If Mary Ann ever
// needs to edit them, promote each list to an array field on the
// `requestAQuotePage` schema (mirroring `referralOptions`) and read it via
// getRequestAQuotePage() — the render loop below won't need to change.
// (QuotePrefillScript selects 'Three-letter monogram' for 3 initials.)
const ownershipOptions: string[] = ['I have the item', 'Please source it for me', 'Not sure yet'];
const monogramStyleOptions: string[] = [
  'Three-letter monogram',
  'Name or word',
  'Custom text',
  'Appliqué',
  'Custom embroidery',
  'Recommend for me',
];
const placementOptions: string[] = [
  'Center chest',
  'Upper-left chest',
  'Back',
  'Cuff or sleeve',
  'Corner',
  'Hat brim',
  'Full front',
  'Other',
  'Recommend for me',
];
const sizeOptions: string[] = [
  'Small (under 2")',
  'Standard (2–4")',
  'Large (4–6")',
  'Extra large (6"+)',
  'Recommend for me',
];
const threadCountOptions: string[] = ['1', '2', '3 or more', 'Not sure'];
// "How did you hear about us?" — optional, so no "recommend" escape needed.
const howHeardOptions: string[] = [
  'Google',
  'Instagram',
  'Facebook',
  'Referral',
  'Returning customer',
  'Other',
];

const title = page?.seoTitle ?? 'Request a Quote — MAS Monograms';
const description =
  page?.seoDescription ??
  "Request a custom embroidery quote from MAS Monograms. Tell Mary Ann what you need and she'll get back to you within 1–2 business days.";

const L = {
  orderInfoHeading: page?.orderInfoHeading ?? 'About Your Order',
  personalInfoHeading: page?.personalInfoHeading ?? 'Your Information',
  attachmentsHeading: page?.attachmentsHeading ?? 'Photos (Optional)',
  additionalHeading: page?.additionalHeading ?? 'Anything Else?',
  itemTypeLabel: page?.itemTypeLabel ?? 'What type of item?',
  itemTypePlaceholder: page?.itemTypePlaceholder ?? 'e.g. bath towels, a tote bag, onesies…',
  itemTypeHelp: page?.itemTypeHelp ?? null,
  itemTypeError: page?.itemTypeError ?? 'Please choose an item type.',
  ownershipLabel: page?.ownershipLabel ?? 'Do you own the item?',
  ownershipHelp: page?.ownershipHelp ?? null,
  ownershipError: page?.ownershipError ?? 'Please let us know about the item.',
  itemDescriptionLabel: page?.itemDescriptionLabel ?? 'Item description',
  itemDescriptionPlaceholder: page?.itemDescriptionPlaceholder ?? 'Brand, color, fabric, size…',
  itemDescriptionHelp: page?.itemDescriptionHelp ?? null,
  monogramStyleLabel: page?.monogramStyleLabel ?? 'Monogram style',
  monogramStyleHelp: page?.monogramStyleHelp ?? null,
  monogramStyleError: page?.monogramStyleError ?? 'Please choose a monogram style.',
  placementSelectLabel: page?.placementSelectLabel ?? 'Placement on item',
  placementSelectHelp: page?.placementSelectHelp ?? null,
  placementSelectError: page?.placementSelectError ?? 'Please choose a placement.',
  sizeLabel: page?.sizeLabel ?? 'Approximate size',
  sizeHelp: page?.sizeHelp ?? null,
  sizeError: page?.sizeError ?? 'Please choose an approximate size.',
  threadCountLabel: page?.threadCountLabel ?? 'Number of thread colors',
  threadCountHelp: page?.threadCountHelp ?? null,
  threadCountError: page?.threadCountError ?? 'Please choose the number of thread colors.',
  rushLabel: page?.rushLabel ?? 'I need this rushed (a rush fee may apply)',
  rushHelp: page?.rushHelp ?? null,
  quantityLabel: page?.quantityLabel ?? 'Quantity',
  quantityPlaceholder: page?.quantityPlaceholder ?? 'e.g. 2',
  quantityHelp: page?.quantityHelp ?? null,
  personalizationLabel: page?.personalizationLabel ?? 'Personalization Details',
  personalizationPlaceholder:
    page?.personalizationPlaceholder ?? 'Names, initials, dates, monogram style…',
  personalizationHelp: page?.personalizationHelp ?? null,
  personalizationError: page?.personalizationError ?? 'Please describe your personalization.',
  fontLabel: page?.fontPreferenceLabel ?? 'Font Preference (Optional)',
  fontHelp: page?.fontPreferenceHelp ?? 'Not sure? Browse the Font Guide.',
  threadLabel: page?.threadColorLabel ?? 'Thread Color Preference (Optional)',
  threadPlaceholder:
    page?.threadColorPlaceholder ?? 'Color name or code, or "I trust your judgment"',
  threadHelp: page?.threadColorHelp ?? 'Browse the Thread Color Chart for reference.',
  neededByLabel: page?.neededByLabel ?? 'Date Needed By (Optional)',
  neededByHelp: page?.neededByHelp ?? 'Rush orders may incur additional charges.',
  giftLabel: page?.giftLabel ?? 'Is this a gift?',
  giftOptionYes: page?.giftOptionYes ?? 'Yes, please keep it a surprise!',
  giftOptionNo: page?.giftOptionNo ?? 'No',
  nameLabel: page?.nameLabel ?? 'Your Name',
  namePlaceholder: page?.namePlaceholder ?? 'First and last name',
  nameError: page?.nameError ?? 'Please enter your name.',
  emailLabel: page?.emailLabel ?? 'Email Address',
  emailPlaceholder: page?.emailPlaceholder ?? 'you@example.com',
  emailError: page?.emailError ?? 'Please enter a valid email.',
  phoneLabel: page?.phoneLabel ?? 'Phone Number (Optional)',
  phonePlaceholder: page?.phonePlaceholder ?? '(843) 555-0100',
  phoneError: page?.phoneError ?? 'Please enter a phone number.',
  referralLabel: page?.referralLabel ?? 'How did you hear about us?',
  referralOptions: (page?.referralOptions ?? howHeardOptions) as string[],
  attachmentsHelp:
    page?.attachmentsHelp ?? 'Upload up to 5 photos (JPG, PNG, WEBP). Max 5 MB each.',
  attachmentsError: page?.attachmentsError ?? 'Each file must be under 5 MB.',
  notesLabel: page?.notesLabel ?? 'Additional Notes',
  notesPlaceholder: page?.notesPlaceholder ?? 'Anything else Mary Ann should know?',
  submitLabel: page?.submitLabel ?? 'Send My Quote Request',
  submittingLabel: page?.submittingLabel ?? 'Sending…',
  privacyNote: page?.privacyNote ?? null,
  turnaroundCallout: page?.turnaroundCallout ?? null,
  requiredFieldNote: page?.requiredFieldNote ?? 'Fields marked * are required.',
  noScriptMessage: page?.noScriptMessage ?? 'This form needs JavaScript to send.',
};

// No-JS fallback (2026-10-04): the bot check and the send both need JavaScript,
// so a visitor without it gets Mary Ann's email and phone (siteSettings) instead.
const contactEmail: string = siteSettings?.email ?? '';
const contactPhone: string = siteSettings?.phone ?? '';
const contactPhoneHref = telHref(contactPhone);

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

// ── Atelier hand-off whitelist (validated client-side against the URL) ──────
const prefillData = {
  threads: (threadColors ?? [])
    .map((t: any) => ({
      slug: t?.slug ?? '',
      name: t?.name ?? '',
      hex: normHex(t?.hexColor) ?? '',
    }))
    .filter((t: { slug: string; name: string; hex: string }) => t.slug && t.name && t.hex),
  fabrics: (atelier?.fabrics ?? [])
    .map((f) => ({
      key: f.key,
      label: f.label,
      color: normHex(f.color) ?? '',
      texture: textureForFabric(f.key),
    }))
    .filter((f) => f.key && f.label && f.color),
  styles: (atelier?.styles ?? [])
    .filter((s) => s?.key && s?.label)
    .map((s) => ({ key: s.key, label: s.label })),
  labels: {
    initials: atelier?.initialsLabel ?? '',
    style: atelier?.styleLabel ?? '',
    thread: atelier?.threadLabel ?? '',
    fabric: atelier?.fabricLabel ?? '',
  },
};

const steps = [
  { id: 'q-order', label: L.orderInfoHeading },
  { id: 'q-you', label: L.personalInfoHeading },
  { id: 'q-photos', label: L.attachmentsHeading },
  { id: 'q-notes', label: L.additionalHeading },
];

// Headline swash: the last word in the gold italic.
const headline: string = page?.heroHeadline ?? 'Request a Custom Quote';
const hWords = headline.trim().split(/\s+/);
const hLast = hWords.pop() ?? '';
const hLead = hWords.join(' ');
---

<BaseLayout {title} {description} seoImage={page?.seoImage} {siteSettings} header="overlay">
  {/* Intro */}
  <section class="surface-midnight pt-header pb-section-lg" aria-labelledby="quote-title">
    <div
      class="mx-auto grid max-w-content grid-cols-1 items-center gap-section-md px-m lg:grid-cols-[1.35fr_1fr]"
    >
      <div data-reveal>
        {page?.heroEyebrow && <p class="eyebrow mb-m">{page.heroEyebrow}</p>}
        <h1 id="quote-title" class="display-sm mb-l">
          {hLead && <>{hLead} </>}<em class="swash">{hLast}</em>
        </h1>
        {page?.heroSubhead && <p class="lede">{page.heroSubhead}</p>}
        {
          page?.heroBody && (
            <div class="mt-m max-w-[42rem] text-[var(--color-text-secondary)]">
              <PortableText value={page.heroBody} />
            </div>
          )
        }
        {
          (page?.heroTrustItems ?? []).length > 0 && (
            <ul class="mt-l list-none space-y-s">
              {(page.heroTrustItems as string[]).map((item: string) => (
                <li class="flex items-start gap-s text-sm text-[var(--color-text-secondary)]">
                  <span class="quote-trust-mark" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        page?.heroImage?.asset ? (
          <div class="overflow-hidden rounded-2xl shadow-xl">
            <SanityImage
              source={page.heroImage}
              width={700}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="h-auto w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        ) : (
          <div class="quote-hero-art" data-reveal="fade">
            <div class="quote-hero-art__props" aria-hidden="true">
              <Spool color="#8c3a2e" size={96} tilt={-6} />
              <Spool color="#d9b15f" size={78} tilt={5} />
              <Needle length={150} angle={-38} thread="#d9b15f" class="quote-hero-art__needle" />
            </div>
            {L.turnaroundCallout && (
              <HangTag
                title={L.turnaroundCallout}
                tilt={-3}
                size="md"
                class="quote-hero-art__tag"
              />
            )}
          </div>
        )
      }
    </div>
  </section>

  {/* Form */}
  <section class="surface-linen py-section-lg">
    <div class="quote-layout mx-auto max-w-content px-m">
      <div class="quote-aside">
        <QuotePreview
          data={prefillData}
          heading={atelier?.eyebrow ?? atelier?.ctaLabel}
          disclaimer={atelier?.disclaimer}
        />
        <div class="quote-aside__steps">
          <QuoteSteps steps={steps} label={headline} />
        </div>
      </div>

      <div class="quote-card">
        <noscript>
          <div class="quote-noscript" data-testid="quote-noscript">
            <p class="quote-noscript__msg">{L.noScriptMessage}</p>
            {
              (contactEmail || contactPhoneHref) && (
                <ul class="quote-noscript__links" role="list">
                  {contactEmail && (
                    <li>
                      <a href={`mailto:${contactEmail}`} class="link-stitch hit-44 relative">
                        {contactEmail}
                      </a>
                    </li>
                  )}
                  {contactPhoneHref && (
                    <li>
                      <a href={contactPhoneHref} class="link-stitch hit-44 relative">
                        {contactPhone}
                      </a>
                    </li>
                  )}
                </ul>
              )
            }
          </div>
        </noscript>
        <div
          id="form-success"
          class="quote-status quote-status--ok hidden"
          role="alert"
          aria-live="polite"
        >
          <p class="font-semibold">We got it!</p>
          <p class="text-sm">Redirecting you to the confirmation page…</p>
        </div>
        <div
          id="form-error"
          class="quote-status quote-status--error hidden"
          role="alert"
          aria-live="polite"
        >
          <p class="font-semibold">Something went wrong.</p>
          <p id="form-error-msg" class="mt-xs text-sm">
            Please try again or email Mary Ann directly.
          </p>
        </div>

        <form
          id="quote-form"
          method="POST"
          action="/api/quote"
          enctype="multipart/form-data"
          novalidate
          class="quote-form"
        >
          {L.requiredFieldNote && <p class="quote-required">{L.requiredFieldNote}</p>}

          {/* ── Order Information ── */}
          <fieldset id="q-order" class="quote-set">
            <legend class="quote-legend">
              <span class="quote-legend__num" aria-hidden="true">01</span>
              <span>{L.orderInfoHeading}</span>
            </legend>

            {/* Item type — real categories + a "not sure" escape */}
            <div class="form-field">
              <label for="itemType" class="form-label">
                {L.itemTypeLabel}
                {' '}
                <span class="form-req" aria-hidden="true">*</span>
              </label>
              <select
                id="itemType"
                name="itemType"
                required
                aria-required="true"
                aria-describedby="itemType-error"
                class="form-input"
              >
                <option value="">Select one</option>
                {
                  itemTypeOptions.map((opt: { name: string; slug: string }) => (
                    <option value={opt.name} data-slug={opt.slug}>
                      {opt.name}
                    </option>
                  ))
                }
              </select>
              {L.itemTypeHelp && <p class="form-help">{L.itemTypeHelp}</p>}
              <p id="itemType-error" class="form-error hidden" data-error-for="itemType">
                {L.itemTypeError}
              </p>
            </div>

            {/* Do you own the item? */}
            <div class="form-field">
              <p id="ownership-label" class="form-label">
                {L.ownershipLabel}
                {' '}
                <span class="form-req" aria-hidden="true">*</span>
              </p>
              <div
                id="ownership"
                class="choice-row"
                role="radiogroup"
                aria-labelledby="ownership-label"
                aria-required="true"
                aria-describedby="ownership-error"
              >
                {
                  ownershipOptions.map((opt: string) => (
                    <label class="choice">
                      <input
                        type="radio"
                        name="ownership"
                        value={opt}
                        class="choice-input hit-44"
                        data-required-radio
                      />
                      <span>{opt}</span>
                    </label>
                  ))
                }
              </div>
              {L.ownershipHelp && <p class="form-help">{L.ownershipHelp}</p>}
              <p id="ownership-error" class="form-error hidden" data-error-for="ownership">
                {L.ownershipError}
              </p>
            </div>

            <div class="form-grid">
              {/* Item description (optional free text) */}
              <div class="form-field form-field--wide">
                <label for="itemDescription" class="form-label">{L.itemDescriptionLabel}</label>
                <input
                  id="itemDescription"
                  name="itemDescription"
                  type="text"
                  placeholder={L.itemDescriptionPlaceholder}
                  class="form-input"
                />
                {L.itemDescriptionHelp && <p class="form-help">{L.itemDescriptionHelp}</p>}
              </div>

              <div class="form-field">
                <label for="quantity" class="form-label">{L.quantityLabel}</label>
                <input
                  id="quantity"
                  name="quantity"
                  type="number"
                  min="1"
                  inputmode="numeric"
                  placeholder={L.quantityPlaceholder}
                  class="form-input form-input--short"
                />
                {L.quantityHelp && <p class="form-help">{L.quantityHelp}</p>}
              </div>
            </div>

            <div class="form-field">
              <label for="personalization" class="form-label">
                {L.personalizationLabel}
                {' '}
                <span class="form-req" aria-hidden="true">*</span>
              </label>
              <textarea
                id="personalization"
                name="personalization"
                rows="3"
                placeholder={L.personalizationPlaceholder}
                required
                aria-required="true"
                aria-describedby="personalization-error"
                class="form-input"></textarea>
              {L.personalizationHelp && <p class="form-help">{L.personalizationHelp}</p>}
              <p
                id="personalization-error"
                class="form-error hidden"
                data-error-for="personalization"
              >
                {L.personalizationError}
              </p>
            </div>

            <div class="form-grid">
              {/* Monogram style */}
              <div class="form-field">
                <label for="monogramStyle" class="form-label">
                  {L.monogramStyleLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <select
                  id="monogramStyle"
                  name="monogramStyle"
                  required
                  aria-required="true"
                  aria-describedby="monogramStyle-error"
                  class="form-input"
                >
                  <option value="">Select one</option>
                  {monogramStyleOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                </select>
                {L.monogramStyleHelp && <p class="form-help">{L.monogramStyleHelp}</p>}
                <p
                  id="monogramStyle-error"
                  class="form-error hidden"
                  data-error-for="monogramStyle"
                >
                  {L.monogramStyleError}
                </p>
              </div>

              {/* Placement on item */}
              <div class="form-field">
                <label for="placement" class="form-label">
                  {L.placementSelectLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <select
                  id="placement"
                  name="placement"
                  required
                  aria-required="true"
                  aria-describedby="placement-error"
                  class="form-input"
                >
                  <option value="">Select one</option>
                  {placementOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                </select>
                {L.placementSelectHelp && <p class="form-help">{L.placementSelectHelp}</p>}
                <p id="placement-error" class="form-error hidden" data-error-for="placement">
                  {L.placementSelectError}
                </p>
              </div>

              {/* Approximate size */}
              <div class="form-field">
                <label for="size" class="form-label">
                  {L.sizeLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <select
                  id="size"
                  name="size"
                  required
                  aria-required="true"
                  aria-describedby="size-error"
                  class="form-input"
                >
                  <option value="">Select one</option>
                  {sizeOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                </select>
                {L.sizeHelp && <p class="form-help">{L.sizeHelp}</p>}
                <p id="size-error" class="form-error hidden" data-error-for="size">
                  {L.sizeError}
                </p>
              </div>

              {/* Number of thread colors */}
              <div class="form-field">
                <label for="threadCount" class="form-label">
                  {L.threadCountLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <select
                  id="threadCount"
                  name="threadCount"
                  required
                  aria-required="true"
                  aria-describedby="threadCount-error"
                  class="form-input"
                >
                  <option value="">Select one</option>
                  {threadCountOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                </select>
                {L.threadCountHelp && <p class="form-help">{L.threadCountHelp}</p>}
                <p id="threadCount-error" class="form-error hidden" data-error-for="threadCount">
                  {L.threadCountError}
                </p>
              </div>

              {/* Font preference — real fonts + Other + Recommend */}
              <div class="form-field">
                <label for="fontPreference" class="form-label">{L.fontLabel}</label>
                <select id="fontPreference" name="fontPreference" class="form-input">
                  <option value="">Select one</option>
                  {fontOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
                </select>
                {
                  L.fontHelp && (
                    <p class="form-help">
                      {L.fontHelp}
                      <a href="/font-lettering-guide" class="form-help__link">
                        Font Guide →
                      </a>
                    </p>
                  )
                }
              </div>

              <div class="form-field">
                <label for="threadColor" class="form-label">{L.threadLabel}</label>
                <input
                  id="threadColor"
                  name="threadColor"
                  type="text"
                  placeholder={L.threadPlaceholder}
                  class="form-input"
                />
                {
                  L.threadHelp && (
                    <p class="form-help">
                      {L.threadHelp}
                      <a href="/thread-color-chart" class="form-help__link">
                        Color Chart →
                      </a>
                    </p>
                  )
                }
              </div>

              <div class="form-field">
                <label for="neededBy" class="form-label">{L.neededByLabel}</label>
                <input id="neededBy" name="neededBy" type="date" class="form-input" />
                {L.neededByHelp && <p class="form-help">{L.neededByHelp}</p>}
              </div>
            </div>

            {/* Rush turnaround */}
            <div class="form-field">
              <label class="choice">
                <input type="checkbox" name="rush" value="yes" class="choice-input hit-44" />
                <span>{L.rushLabel}</span>
              </label>
              {L.rushHelp && <p class="form-help">{L.rushHelp}</p>}
            </div>

            <div class="form-field">
              <p class="form-label">{L.giftLabel}</p>
              <div class="choice-row choice-row--inline">
                <label class="choice">
                  <input type="radio" name="isGift" value="yes" class="choice-input hit-44" />
                  <span>{L.giftOptionYes}</span>
                </label>
                <label class="choice">
                  <input
                    type="radio"
                    name="isGift"
                    value="no"
                    class="choice-input hit-44"
                    checked
                  />
                  <span>{L.giftOptionNo}</span>
                </label>
              </div>
            </div>
          </fieldset>

          {/* ── Personal Info ── */}
          <fieldset id="q-you" class="quote-set">
            <legend class="quote-legend">
              <span class="quote-legend__num" aria-hidden="true">02</span>
              <span>{L.personalInfoHeading}</span>
            </legend>

            <div class="form-grid">
              <div class="form-field form-field--wide">
                <label for="name" class="form-label">
                  {L.nameLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder={L.namePlaceholder}
                  required
                  aria-required="true"
                  aria-describedby="name-error"
                  class="form-input"
                />
                <p id="name-error" class="form-error hidden" data-error-for="name">
                  {L.nameError}
                </p>
              </div>

              <div class="form-field">
                <label for="email" class="form-label">
                  {L.emailLabel}
                  {' '}
                  <span class="form-req" aria-hidden="true">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={L.emailPlaceholder}
                  required
                  aria-required="true"
                  aria-describedby="email-error"
                  class="form-input"
                />
                <p id="email-error" class="form-error hidden" data-error-for="email">
                  {L.emailError}
                </p>
              </div>

              <div class="form-field">
                <label for="phone" class="form-label">
                  {L.phoneLabel}
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder={L.phonePlaceholder}
                  aria-describedby="phone-error"
                  class="form-input"
                />
                <p id="phone-error" class="form-error hidden" data-error-for="phone">
                  {L.phoneError}
                </p>
              </div>

              {
                L.referralOptions.length > 0 && (
                  <div class="form-field">
                    <label for="referral" class="form-label">
                      {L.referralLabel}
                    </label>
                    <select id="referral" name="referral" class="form-input">
                      <option value="">Select one</option>
                      {L.referralOptions.map((opt: string) => (
                        <option value={opt}>{opt}</option>
                      ))}
                    </select>
                  </div>
                )
              }
            </div>
          </fieldset>

          {/* ── Photos ── */}
          <fieldset id="q-photos" class="quote-set">
            <legend class="quote-legend">
              <span class="quote-legend__num" aria-hidden="true">03</span>
              <span>{L.attachmentsHeading}</span>
            </legend>
            <div class="form-field">
              <div id="drop-zone" class="drop-zone">
                <input
                  id="attachments"
                  name="attachments"
                  type="file"
                  accept=".jpg,.jpeg,.png,.webp"
                  multiple
                  class="drop-zone__input"
                  aria-label={L.attachmentsHeading}
                  aria-describedby="attachments-help"
                />
                <svg
                  class="drop-zone__icon"
                  viewBox="0 0 48 48"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle
                    cx="24"
                    cy="24"
                    r="19"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-dasharray="4 4"
                    stroke-linecap="round"></circle>
                  <path
                    d="M24 31V17m-6 6 6-6 6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <p class="text-sm text-[var(--color-text-secondary)]">
                  Drag & drop photos here, or <span class="text-link underline"
                    >click to browse</span
                  >
                </p>
                <p id="attachments-help" class="mt-xs text-xs text-[var(--color-text-secondary)]">
                  {L.attachmentsHelp}
                </p>
              </div>
              <ul id="file-list" class="mt-s list-none space-y-xs" aria-live="polite"></ul>
              <p id="attachments-error" class="form-error hidden" data-error-for="attachments">
                {L.attachmentsError}
              </p>
            </div>
          </fieldset>

          {/* ── Notes ── */}
          <fieldset id="q-notes" class="quote-set">
            <legend class="quote-legend">
              <span class="quote-legend__num" aria-hidden="true">04</span>
              <span>{L.additionalHeading}</span>
            </legend>
            <div class="form-field">
              <label for="notes" class="form-label">{L.notesLabel}</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                placeholder={L.notesPlaceholder}
                class="form-input"></textarea>
            </div>
          </fieldset>

          <div class="quote-submit">
            {/* Turnstile */}
            {
              turnstileSiteKey && (
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-action="quote"
                  data-callback="onTurnstileSuccess"
                  data-theme="light"
                />
              )
            }

            {/* Turnaround reassurance */}
            {
              L.turnaroundCallout && (
                <p class="quote-turnaround">
                  <span class="quote-turnaround__mark" aria-hidden="true" />
                  <span>{L.turnaroundCallout}</span>
                </p>
              )
            }

            {/* Submit */}
            <div>
              <button
                id="submit-btn"
                type="submit"
                data-label={L.submitLabel}
                data-submitting={L.submittingLabel}
                class="btn btn-primary quote-submit__btn"
              >
                <span id="submit-label">{L.submitLabel}</span>
              </button>
              {L.privacyNote && <p class="quote-privacy">{L.privacyNote}</p>}
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
  )
}
<QuotePrefillScript />
