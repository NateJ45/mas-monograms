  .quote-noscript__msg {
    margin: 0;
    font-size: var(--text-reading);
    line-height: 1.5;
  }
  .quote-noscript__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Each row is 44px tall and the link's hit area (hit-44) fills it, so the
