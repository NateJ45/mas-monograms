---
// 404. The page is drawn by src/components/pages/NotFoundBody.astro, which the
// Studio's "Edit on the page" canvas renders too (from draft data), so this file
// only loads the published data and sets the page's head.
//
// WHY THIS PAGE HAS A BODY COMPONENT AND THE OTHERS DO NOT (2026-10-05): every
// other page renders ITSELF in the canvas (the preview route imports the page
// file and passes `preview`). Astro also builds the 404 page into the server
// bundle, and once the preview route imported it, its own styles moved ahead of
// the site stylesheet in the live <head> (a cascade change; `npm run parity
// compare` caught it). Rendering the 404 body as a component keeps this page's
// head exactly as it was.
import BaseLayout from '@/layouts/BaseLayout.astro';
import NotFoundBody from '@/components/pages/NotFoundBody.astro';
import { getSiteSettings } from '@/lib/queries';
import { loadNotFound } from '@/lib/page-data';

const [siteSettings, data] = await Promise.all([getSiteSettings(), loadNotFound()]);
const { page } = data;

const title = page?.seoTitle ?? 'Page Not Found — MAS Monograms';
const description =
  page?.seoDescription ?? "The page you're looking for doesn't exist. Let's get you back on track.";
---

<BaseLayout {title} {description} {siteSettings} noindex thread={false}>
  <NotFoundBody {...data} />
</BaseLayout>
