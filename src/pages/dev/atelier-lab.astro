---
// TEMPORARY dev lab for the Atelier engine. Not linked, noindex. Delete before merge.
import '@/styles/globals.css';
import AtelierStage from '@/components/atelier/AtelierStage.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Atelier lab</title>
  </head>
  <body style="background:#f4eee3;margin:0;padding:16px;font-family:sans-serif">
    <form id="lab" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:12px">
      <label>Text <input id="t" value="MAS" maxlength="3" size="4" /></label>
      <label
        >Style
        <select id="s">
          <option>classic</option><option>script</option><option>block</option><option
            >circle</option
          ><option>single</option>
        </select>
      </label>
      <label>Thread <input id="th" type="color" value="#8c3a2e" /></label>
      <label>Fabric <input id="fa" type="color" value="#efe6d6" /></label>
      <label
        >Texture
        <select id="tx"
          ><option>linen</option><option>canvas</option><option>cotton</option><option>terry</option
          ></select
        >
      </label>
      <label><input id="an" type="checkbox" checked /> animate</label>
      <button id="go" type="submit">Apply</button>
      <button id="rp" type="button">Replay</button>
      <output id="stats" style="font:12px monospace;white-space:pre"></output>
    </form>
    <div id="wrap" style="width:1400px">
      <AtelierStage
        id="stage"
        text="MAS"
        style="classic"
        thread="#8c3a2e"
        fabric="#efe6d6"
        label="Lab preview"
        autoplay={true}
      />
    </div>
    <script>
      import type { Atelier, Design } from '@/lib/atelier/engine';
      const el = document.getElementById('stage') as HTMLElement & { __atelier?: Atelier };
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const stats = document.getElementById('stats') as HTMLOutputElement;
      const w = window as unknown as Record<string, unknown>;
      const frames: number[] = [];
      let last = 0;
      let firstProgressAt = 0;
      let t0 = 0;
      el.addEventListener('atelier:progress', (e) => {
        const p = (e as CustomEvent).detail.progress as number;
        const t = performance.now();
        if (!firstProgressAt) firstProgressAt = t;
        if (last) frames.push(t - last);
        last = t;
        if (p >= 1) {
          const sorted = [...frames].sort((a, b) => a - b);
          const r = {
            firstStitchMs: Math.round(firstProgressAt - t0),
            totalMs: Math.round(t - t0),
            frames: frames.length,
            frameMedian: sorted[Math.floor(sorted.length / 2)]?.toFixed(1),
            frameP95: sorted[Math.floor(sorted.length * 0.95)]?.toFixed(1),
          };
          w.__labLast = r;
          stats.textContent = JSON.stringify(r);
        }
      });
      const read = (): Partial<Design> => ({
        text: $('t').value,
        style: $('s').value as Design['style'],
        thread: $('th').value,
        fabric: $('fa').value,
        fabricTexture: $('tx').value as Design['fabricTexture'],
      });
      const run = async (d: Partial<Design>, animate: boolean) => {
        frames.length = 0;
        last = 0;
        firstProgressAt = 0;
        t0 = performance.now();
        await el.__atelier?.setDesign(d, { animate });
        return performance.now() - t0;
      };
      const shot = async (name: string, crop?: string, zoom = 1) => {
        const c = el.querySelector('canvas') as HTMLCanvasElement;
        const blob = await el.__atelier?.toBlob();
        const q = `name=${encodeURIComponent(name)}${crop ? `&crop=${crop}&zoom=${zoom}` : ''}`;
        const r = await fetch(`http://localhost:4419/?${q}`, { method: 'POST', body: blob });
        return { size: [c.width, c.height], files: await r.json() };
      };
      w.__lab = { el, run, read, shot };
      document.getElementById('lab')?.addEventListener('submit', (e) => {
        e.preventDefault();
        void run(read(), $('an').checked);
      });
      document.getElementById('rp')?.addEventListener('click', () => {
        frames.length = 0;
        last = 0;
        firstProgressAt = 0;
        t0 = performance.now();
        void el.__atelier?.replay();
      });
    </script>
  </body>
</html>
