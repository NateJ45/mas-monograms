---
// Safe to edit by hand
// The optional site motif on the /studio loading splash
// (src/pages/studio/index.astro, starter PORTS.md card 120). NOT PORTABLE.
//
// MAS Monograms: the splash is set the way her home page hero is.
//   - Her Hoop Seal lettering stitched in the hero's gilded hoop
//     (public/studio-art/hoop.svg, drawn by scripts/gen-studio-art.mjs from
//     public/brand/mark-light.svg and src/components/home/HomeHero.astro). The
//     hoop IS her mark, so it stands in for the small favicon on this page.
//   - Her name as the site sets a headline: "MAS" in Fraunces and
//     "Monograms" in the swash italic (globals.css .swash): claret on light,
//     the thread-gold gradient on dark. The font is the Studio banner's copy
//     (public/studio-banner/fraunces-swash.woff2).
//   - A running stitch that sews itself across under the name, as the How It
//     Works path does on her home page (src/components/home/ProcessPath.astro).
//     Under reduced motion it is simply there.
// The page's own name line stays in the page for screen readers (visually
// hidden below), so the lettering here is decorative. These styles reach only
// into the splash, which React replaces once the editor opens.
---

<div class="mas-splash" aria-hidden="true">
  <img
    class="mas-splash__hoop"
    src="/studio-art/hoop.svg"
    alt=""
    width="196"
    height="214"
    decoding="async"
    fetchpriority="high"
  />
  <p class="mas-splash__name">
    MAS <span class="mas-splash__swash">Monograms</span>
  </p>
  <svg class="mas-splash__stitch" viewBox="0 0 220 12" width="220" height="12">
    <path d="M4 6 C 60 1, 100 11, 150 6 S 200 2, 216 6" pathLength="100"></path>
  </svg>
</div>

<style is:global>
  @font-face {
    font-family: 'MAS Fraunces Swash';
    src: url('/studio-banner/fraunces-swash.woff2') format('woff2-variations');
    font-style: italic;
    font-weight: 100 900;
    font-display: swap;
  }
  [data-studio-splash] .ncs-splash__mark {
    display: none;
  }
  /* The page's name line: kept for screen readers, drawn by the lettering instead. */
  [data-studio-splash] .ncs-splash__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  [data-studio-splash] .ncs-splash__motif {
    order: -1;
    margin: 0 0 4px;
  }
  .mas-splash {
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .mas-splash__hoop {
    display: block;
    width: min(132px, 40vw);
    height: auto;
  }
  .mas-splash__name {
    margin: 4px 0 0;
    font-family: var(--splash-display);
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    line-height: 1.05;
    font-weight: 360;
    letter-spacing: -0.02em;
    color: #26312e;
  }
  .mas-splash__swash {
    font-family: 'MAS Fraunces Swash', var(--splash-display);
    font-style: italic;
    font-weight: 330;
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1;
    letter-spacing: -0.012em;
    color: #8c3a2e;
  }
  .mas-splash__stitch {
    display: block;
    width: min(220px, 60vw);
    height: auto;
    overflow: visible;
  }
  .mas-splash__stitch path {
    fill: none;
    stroke: #8c3a2e;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 3.2 2.4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mas-splash__stitch {
      clip-path: inset(0 100% 0 0);
      animation: mas-sew 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
    }
  }
  @keyframes mas-sew {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  /* Dark: Linen letters, the thread-gold swash and a gold stitch, as on her Midnight bands. */
  html[data-studio-scheme='dark'] .mas-splash__name {
    color: #f4eee3;
  }
  html[data-studio-scheme='dark'] .mas-splash__swash {
    color: #f0d58a;
    background-image: linear-gradient(
      100deg,
      #a9772a 0%,
      #d9b15f 22%,
      #f0d58a 46%,
      #d9b15f 70%,
      #a9772a 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-inline: 0.08em 0.12em;
  }
  html[data-studio-scheme='dark'] .mas-splash__stitch path {
    stroke: #d9b15f;
  }
  @media (prefers-color-scheme: dark) {
    html:not([data-studio-scheme='light']) .mas-splash__name {
      color: #f4eee3;
    }
    html:not([data-studio-scheme='light']) .mas-splash__swash {
      color: #f0d58a;
    }
    html:not([data-studio-scheme='light']) .mas-splash__stitch path {
      stroke: #d9b15f;
    }
  }
</style>
