{
  // Cloudflare Workers configuration for this project.
  // Cloudflare merged Pages into Workers in early 2026; Workers is the path forward.
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "mas-monograms",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Sessions: @astrojs/cloudflare needs a KV binding named SESSION. Left
  // unpinned, wrangler tries to auto-provision "mas-monograms-session" on every
  // deploy and fails with 10014 (namespace already exists), which is why no
  // Workers Builds deploy landed between 2026-08-29 and 2026-09-04. Pinned
  // to the existing namespace, same as wcp-website does.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d12ddb7fc8344064a98113ef738aaa71",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // R2 bucket for backing up quote form submissions as JSON.
  // Create first: wrangler r2 bucket create mas-monograms-quotes
  "r2_buckets": [
    {
      "binding": "QUOTE_BACKUP",
      "bucket_name": "mas-monograms-quotes"
    }
  ]
  // Secrets (set via: wrangler secret put SECRET_NAME) — never in this file:
  //   RESEND_API_KEY        — Resend email API key
  //   QUOTE_OWNER_EMAIL     — Mary Ann's email address
  //   SANITY_API_READ_TOKEN — Sanity viewer token for build-time reads
  //   TURNSTILE_SECRET_KEY  — Cloudflare Turnstile CAPTCHA secret
}
